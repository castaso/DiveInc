<script>
    $(document).ready(function(){
        checkCookieApproval();
    });

    function setCookieNotifGDPR() {
        cvalue = randomVisitorId();
        var d = new Date();
        d.setTime(d.getTime() + (1*24*60*60*1000));
        // d.setTime(d.getTime() + (10000));
        var expires = "expires=" + d.toGMTString();
        document.cookie = "cookieGDPRApproval=" + cvalue + ";" + expires + ";path=/";
        $('#gdpr-notif').removeClass('d-block');
        $('#gdpr-notif').addClass('d-none');
    }

    function getCookie(cname) {
        var name = cname + "=";
        var decodedCookie = decodeURIComponent(document.cookie);
        console.log(document.cookie);
        var ca = decodedCookie.split(';');
        for(var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length, c.length);
            }
        }
        return "";
    }

    function checkCookieApproval() {
        var user=getCookie("cookieGDPRApproval");
        if (user != "") {
            $('#gdpr-notif').addClass('d-none');
        } else {
            $('#gdpr-notif').removeClass('d-none');
            $('#gdpr-notif').addClass('d-block');
        }
    }

    function randomVisitorId(){
        var result           = [];
        var characters       = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';
        var charactersLength = characters.length;
        for ( var i = 0; i < 20; i++ ) {
            result.push(characters.charAt(Math.floor(Math.random() * 
            charactersLength)));
        }
        return result.join('')+new Date().getTime();
    }

</script>