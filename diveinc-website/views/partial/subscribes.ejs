<!-- NEWSLETTER -->
<div class="section bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-7 text-center">
                <h6 class="text-muted">DIVE INC NEWSLETTER</h6>
                <h3 class="mb-3 font-weight-normal">Get news and special offers on your inbox!</h3>
                <div class="input-group mb-2">
                    <input type="text" class="form-control" placeholder="Enter your email address" aria-label="Enter your email address" aria-describedby="buttonSubmitSubcscribe">
                    <div class="input-group-append">
                        <button class="btn btn-secondary" type="button" id="buttonSubmitSubcscribe">Submit</button>
                    </div>
                </div>
                <p class="mb-0 font-size-sm">Join the DiveInc community and get special offers, news of the latest dive destinations and much more.</p>
                <!-- <p class="mb-0"><small>By clicking "Submit" you agree of DiveInc's <a href="">Terms & Condition</a> and <a href="">Privacy Policy</a></small></p> -->
            </div>
        </div>
    </div>
    <img class="icon-sticker icon-top-left" src="/images/selected-icon/selected-mammals.png">
    <img class="icon-sticker icon-bottom-right" src="/images/selected-icon/selected-caves.png">
</div>