<script>
    $(document).ready(function(){
        loadDestination()
    })

    function loadDestination(){
        $.ajax({
            url: `/api/destination`,
            method: `GET`,
            success: function (result) {
                if (result.success) {

                    $('#exploreLoader').addClass('hideImportant');
                    $('#exploreSection').addClass('showing');
                    
                    for(var i = 0; i < result.data.length; i++){
                        if(i == 0){
                            $('#layoutDestination').append(`
                                <li class="glide__slide">
                                    <a href="/destination/${result.data[i].id}" class="explore-card--item mb-0">
                                        <div class="explore-card--content shadow-sm">
                                            <div class="explore-card--image" style="background-image: url('${result.data[i].image_showing[0].url}');">
                                                <div class="explore-card--text-inside">
                                                    <h4 class="mt-0 text-ellipsis">${result.data[i].name}</h4>
                                                    <p>${result.data[i].description}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            `)
                        }else{
                            $('#layoutDestination').append(`
                                <li>
                                    <a href="/destination/${result.data[i].id}" class="explore-card--item mb-0">
                                        <div class="explore-card--content shadow-sm">
                                            <div class="explore-card--image" style="background-image: url('${result.data[i].image_showing[0].url}');">
                                                <div class="explore-card--text-inside">
                                                    <h4 class="mt-0 text-ellipsis">${result.data[i].name}</h4>
                                                    <p>${result.data[i].description}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            `)
                        }
                    }

                    var sliders = document.querySelectorAll('#top-places-container .glide-card');

                    for (var i = 0; i < sliders.length; i++) {
                        var glide = new Glide(sliders[i], {
                            type: 'carousel',
                            startAt: 0,
                            perView: 5,
                            gap: 0,
                            breakpoints: {
                                991: {
                                perView: 3
                                },
                                767: {
                                perView: 2
                                }
                            }
                        });
                        
                        glide.mount();
                    }

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }
</script>