<script>
    $(document).ready(function(){
        loadCreature()
    })

    function loadCreature(){
        $.ajax({
            url: `/api/creature`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    for(var i = 0; i < result.data.length; i++){
                        if(i == 0){
                            $('#layoutCreature').append(`
                                <li class="glide__slide">
                                    <a href="#" onClick="goTo('${result.data[i].article_id}')" class="explore-card--item mb-0">
                                        <div class="explore-card--content shadow-sm">
                                            <div class="explore-card--image" style="background-image: url('${result.data[i].image_background[0].url}');">
                                                <div class="explore-card--text-inside">
                                                    <h4 class="mt-0 text-ellipsis">${result.data[i].name}</h4>
                                                    <p>${result.data[i].introduction}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            `)
                        }else{
                            $('#layoutCreature').append(`
                                <li>
                                    <a href="#" onClick="goTo('${result.data[i].article_id}')" class="explore-card--item mb-0">
                                        <div class="explore-card--content shadow-sm">
                                            <div class="explore-card--image" style="background-image: url('${result.data[i].image_background[0].url}');">
                                                <div class="explore-card--text-inside">
                                                    <h4 class="mt-0 text-ellipsis">${result.data[i].name}</h4>
                                                    <p>${result.data[i].introduction}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </li>
                            `)
                        }
                    }

                    var sliders2 = document.querySelectorAll('#cta-container .glide-card');

                    for (var i = 0; i < sliders2.length; i++) {
                        var glide2 = new Glide(sliders2[i], {
                            type: 'carousel',
                            startAt: 0,
                            perView: 5,
                            gap: 0,
                            breakpoints: {
                                991: {
                                perView: 3
                                },
                                767: {
                                perView: 2
                                }
                            }
                        });
                        
                        glide2.mount();
                    }

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function goTo(id){
        if(id != null && id != "" && id != "null"){
            location.href = `/article-read/${id}`
        }
    }
</script>