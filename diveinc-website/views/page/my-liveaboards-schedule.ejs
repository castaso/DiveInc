<!-- DATATABLES -->
<script type="text/javascript" src="https://cdn.datatables.net/v/bs4-4.1.1/dt-1.10.20/b-1.6.1/sl-1.3.1/datatables.min.js"></script>
<script src="//cdn.datatables.net/plug-ins/1.10.11/sorting/date-eu.js" type="text/javascript"></script>
<script>
    var id = "<%= id %>"
    var parentId = "<%= parentId %>"
    let scheduleTable;

    $(document).ready(function() {

        loadLiveaboardById()
        
        $('#datePicker').datepicker({
            format: "dd-mm-yyyy",
            todayHighlight: true
        });

        $('#buttonAdd').click(function(){
            createSchedule()
        });
        
        $('#dataSchedule').on('click','.close-schedule', function(){
            close($(this).attr('data-id'),$(this).closest('tr').find('p:first').html());
        });
        
        $('#dataSchedule').on('click','.delete-schedule', function(){
            removeScheduleDate($(this).attr('data-id'),$(this).closest('tr').find('p:first').html());
        });

        scheduleTable = $('#dataSchedule').DataTable({
            processing: true,
            serverSide: true,
            searching: true,
            "columnDefs": [{
                "targets"  : 'nosort',
                "orderable": false
            }],
            ajax: "/api/datatable-schedule/"+id
        });
    } );

    
</script>

<script src="/js/bootstrap-datepicker.min.js"></script>
<script>

    function createSchedule(){
        if($('#datePicker').val().length > 0){
            $.ajax({
                url: `/api/schedule`,
                method: `POST`,
                data:{
                    parent_id : id,
                    schedule_date : $('#datePicker').val()
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        scheduleTable.ajax.reload();
                        $('#datePicker').val('');
                        Swal.fire("Success","Date Added");
                    } else {
                        Swal.fire({
                            title:result.message,
                            text:"Please pick another date."
                        });
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
        }else{
            alert("Date Required")
        }
    }

    function close(scheduleId,tgl){
        Swal.fire({
            title: `Close date : ${tgl}?`,
            text: `This will hide the date option to customers.`,
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Close'
        }).then((respond) => {
            if (respond.value) {
                $.ajax({
                    url: `/api/close/${scheduleId}`,
                    method: `PUT`,
                    success: function (result) {
                        console.log(result)
                        if (result.success) {
                            scheduleTable.ajax.reload();
                            Swal.fire({
                                title:"Schedule status changed"
                            });
                        } else {
                            alert(result.message)
                            console.log(result)
                        }
                    },
                    error(xhr, status, error) {
                        if(xhr.responseJSON){
                            console.log(xhr.responseJSON)
                        }
                    }
                });
            }
        });
        

    }

    function removeScheduleDate(scheduleId,tgl){
        Swal.fire({
            title: `Delete date: ${tgl} ?`,
            text: "This will remove the date from the list, you can't undo this action.",
            showCancelButton: true,
            confirmButtonColor: '#bd2130',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Delete'
        }).then((respond) => {
            if (respond.value) {
                $.ajax({
                    url: `/api/delete/${scheduleId}`,
                    method: `PUT`,
                    success: function (result) {
                        console.log(result)
                        if (result.success) {
                            scheduleTable.ajax.reload();
                            Swal.fire({
                                title:"Schedule deleted success"
                            });
                        } else {
                            alert(result.message)
                            console.log(result)
                        }
                    },
                    error(xhr, status, error) {
                        if(xhr.responseJSON){
                            console.log(xhr.responseJSON)
                        }
                    }
                });
            }
        });
        

    }

    function loadLiveaboardById() {
        $.ajax({
            url: `/api/liveaboard/${parentId}`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {

                    var titleName = result.data.profile.name
                    // load Package
                    for(var i = 0; i < result.data.packages.length; i++){
                        if(result.data.packages[i].id == id){
                            titleName += ` -${result.data.packages[i].info.name}`
                        }
                    }

                    $('#title').text(titleName)
                    
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }
</script>