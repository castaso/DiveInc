                            htmlPrice = `
                                <h5 class="m-0 normal-price discounted" class="">IDR&nbsp;${formatRupiah(result.data.packages[i].price.price)}</h5>
                                <h5 class="m-0 discount-price">IDR&nbsp;${formatRupiah(result.data.packages[i].price.discount)}</h5>
                            `
                        }else{
                            htmlPrice = `
                                <h5 class="m-0 normal-price" class="">IDR&nbsp;${formatRupiah(result.data.packages[i].price.price)}</h5>
                            `
                        }

