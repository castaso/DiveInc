</style>
<div class="header-spacer"></div>
<div class="modal" id="modalSetHighlight" tabindex="-1" role="dialog"aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-header">
                <span class="font-weight-bold">Set Highlight</span>
            </div>
            <div class="modal-body">
                <div id="listHighlightModal"></div>
            </div>
            <div class="modal-footer">
                <button onClick="addHighlightItem()" type="button" class="btn btn-outline-primary"><i class="fas fa-plus mr-2"></i>Add new</button>
                <button type="button" onClick="populateHighlight()" class="btn btn-outline-primary float-right">Done</button>
            </div>
        </div>
    </div>
</div>
<div class="modal" id="modalSetArrival" tabindex="-1" role="dialog"aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-header">
                <span class="font-weight-bold">Set Arrival</span>
            </div>
            <div class="modal-body">
                <div id="listArrivalModal"></div>
            </div>
            <div class="modal-footer bt-4">
                <button onClick="addArrivalItem()" type="button" class="btn btn-outline-primary"><i class="fas fa-plus mr-2"></i>Add new</button>
                <button type="button" onClick="populateArrival()" class="btn btn-outline-primary float-right">Done</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="modalSetDeparture" tabindex="-1" role="dialog"aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-header">
                <span class="font-weight-bold">Set Departure</span>
            </div>
            <div class="modal-body">
                <div id="listDepartureModal"></div>
            </div>
            <div class="modal-footer">
                <button onClick="addDepartureItem()" type="button" class="btn btn-outline-primary"><i class="fas fa-plus mr-2"></i>Add new</button>
                <button type="button" onClick="populateDeparture()" class="btn btn-outline-primary float-right">Done</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="modalSetUnavailableDates" tabindex="-1" role="dialog"aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-header">
                <span class="font-weight-bold">Set Unavailable Dates</span>
            </div>
            <div class="modal-body">
                <div id="listUnavailableDatesModal"></div>
            </div>
            <div class="modal-footer">
                <button onClick="addUnavailableDates()" type="button" class="btn btn-outline-primary"><i class="fas fa-plus mr-2"></i>Add new</button>
                <button type="button" onClick="populateUnavailableDates()" class="btn btn-outline-primary float-right">Done</button>
            </div>
        </div>
    </div>
</div>

