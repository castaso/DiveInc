                        var dataPhotos = result.data.packages[i].photos
                        for(var j = 0; j < dataPhotos.length; j++){
                            htmlPhotos += `
                                <div class="glide__slide--photos" style="background-image: url('${dataPhotos[j].url}');"></div>
                            `
                        }
                        

                        var htmlPrice = ""
