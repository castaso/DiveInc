        (dataFacility.length == 0 ? listIncomplete.push({inputId:"listFacility",message:"Please choose 1 or more facilities"}) : '' );
        (dataSport.length == 0 ? listIncomplete.push({inputId:"listSport",message:"Please choose 1 or more sports"}) : '' );
        (dataArrival.length == 0 ? listIncomplete.push({inputId:"inputArrival",message:"Arrival cannot be blank"}) : '' );
