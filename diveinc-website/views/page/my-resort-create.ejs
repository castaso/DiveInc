    var dataUnavailableDates = [];

    var dataArrival = []
    var dataDeparture = []
    var dataIdeal = []
    var dataLanguage = []
    var dataActivity = []
    var dataFacility = []
    var dataSport = []

    var listRoomDetails = [];
    var listRoomOption = {};
    var listRoomAmenities = {};

    var listPackageDetails = [];

    var listDataRoom = [];
    var listDataPackage = [];

    var totalAktif= 0;
    var totalNonAktif = [];
    

    $(document).ready(function(){

        $('#inputCountry').change(function(){
            getDestination()
        })

        $('#inputDestination').change(function(){
            getSubDestination()
        })

        $(`#saveHighlight`).click(function(){
          if($('#inputHighlight').val().length > 0){
            addHighlight();
          }else{
            // alert("Form not valid")
            Swal.fire(
                'Oops!',
                'Write the highlight resort then press "add item" button.'
            )
            $('.saveDrafthBtn').show();
            $('.saveDraftLoading').hide();
            $('.savePublishBtn').show();
            $('.savePublishLoading').hide();
          }
        })

        $(`#addArrival`).click(function(){
          if($('#inputArrival').val().length > 0){
            addArrival();
          }else{
            // alert("Form not valid")
            Swal.fire(
                'Oops!',
                'First write the arrival direction then press "add item" button.'
            )
            $('.saveDrafthBtn').show();
            $('.saveDraftLoading').hide();
            $('.savePublishBtn').show();
            $('.savePublishLoading').hide();
          }
        })

        $(`#addDeparture`).click(function(){
          if($('#inputDeparture').val().length > 0){
            addDeparture();
          }else{
            // alert("Form not valid")
            Swal.fire(
                'Oops!',
                'First write the departure direction then press "add item" button.'
            )
            $('.saveDrafthBtn').show();
            $('.saveDraftLoading').hide();
            $('.savePublishBtn').show();
            $('.savePublishLoading').hide();
          }
        })

        $(`#customFile`).on(`change`, function(){

          makeFileRequestUpload('/api/upload/image', [], this.files).then((result) => {
              console.log(result)
          }, (error) => {
              console.error(error)
          })
        })

        $(document).on("focus", ".unavailableDatePicker", function(){
            $(this).datepicker({
                // format: "yyyy-mm-dd",
                format: "dd MM yyyy",
                todayHighlight: true,
                autoclose: true
            });
        });
    })

    function initData() {
        if(id){
            $(".formTitle").html('Edit')
            $('#cardSave').hide()
            $('#layoutResortRoom').show()
            $('#layoutResortPackage').show()
            $('#resortButton').show()
            $('#resortButtonBottom').show()
            getRoomOption();
            getAminity();
            loadResortById();
        }else{
            $('#cardSave').show()
            $('#layoutResortRoom').hide()
            $('#layoutResortPackage').hide()
            $('#resortButton').hide()
            $('#resortButtonBottom').hide()
            //console.log("naha asup dieu")
            getIdeal()
            getLanguage()
            getCountry()
            getActivity()
            getFacility()
            getSport()
        }
    }

    function loadResortById() {
        $('#listRoomEmpty, #listPackageEmpty').show();
        
        $.ajax({
            url: `/api/resort/${id}`,
            method: `GET`,
            success: function (result) {
                // console.log(result)
                if (result.success) {
                    statusPublishResort = result.data.publish;
                    $('#inputName').val(result.data.profile.name)
                    $('#inputAddress').val(result.data.profile.address)
                    $('#inputIntroduction').val(result.data.profile.introduction)
                    $('#inputAbout').val(result.data.profile.about)

                    dataCountry = result.data.profile.country
                    dataDestination = result.data.profile.destination
                    dataSubDestination = result.data.profile.sub_destination
                    getCountry()

                    dataImage = result.data.photos
                    loadImage()

                    dataHighlight = result.data.highlight
                    // loadHighlight()
                    loadHighlightItem()

                    dataArrival = (typeof result.data.how_to.arrival !== "undefined" ? result.data.how_to.arrival : [])
                    // loadArrival()
                    loadArrivalItem()

                    dataDeparture = (typeof result.data.how_to.departure !== "undefined" ? result.data.how_to.departure : [])
                    // loadDeparture()
                    loadDepartureItem()

                    dataIdeal = result.data.profile.ideal
                    getIdeal()
                    dataLanguage = result.data.profile.language
                    getLanguage()
                    dataActivity = result.data.amenities.activity
                    getActivity()
                    dataFacility = result.data.amenities.facility
                    getFacility()
                    dataSport = result.data.amenities.sport
                    getSport()

                    listDataRoom = result.data.rooms
                    listDataPackage = result.data.packages

                    dataUnavailableDates = (typeof result.data.unavailable_dates !== 'undefined' ? result.data.unavailable_dates : [])
                    loadUnavailableDatesItem()

                    for(var i =0; i < result.data.packages.length; i++){

                        //$('#listRoomEmpty').hide();

                        $('#listPackageEmpty').hide();

                        var publish = result.data.packages[i].publish
                        if(publish){
                            canPublish = true
                            totalAktif++;
                        }else{
                            totalNonAktif.push({
                                nama:`${result.data.packages[i].info.name}`,
                                tipe:'package',
                                id: result.data.packages[i].id
                            });
                        }

