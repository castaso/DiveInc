                        let list_highlight = '';
                            for (let idx = 0; idx < listPackage[i].highlight.length ; idx++) {
                                list_highlight += `<li>${listPackage[i].highlight[idx].text}</li>`;
                            }

                            let list_iten = '';
                            for (let idx = 0; idx < listPackage[i].itenary.length ; idx++) {
                                list_iten += `<div class="itenary-listing--item">
                                            <div class="itenary-wrapper">
                                                <div class="itenary-title font-weight-bold">Day ${idx + 1}<i class="fas fa-angle-down ml-2 active"></i></div>
                                                <div class="itenary-content active">
                                                    <ul class="list-base">
                                                        ${listPackage[i].itenary[idx].text}
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>`;
                            }

                        $('#listPackage').append(`
                            <div class="card rounded-0 mb-3 bg-white">
                                <div class="row no-gutters align-items-start">
                                    <div class="col-md-4">
                                        <div class="card-body pr-md-0">
                                            <span class="badge-photos badge badge-dark badge-pill rounded" style="left:inherit;top:inherit;">${result.data.packages[i].photos.length}  Photos</span>
                                            <div class="slick rounded">
                                                ${htmlPhotos}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body">
                                            <div class="d-flex align-items-start justify-content-between mb-2 d-flex-mobile">
                                                <div class="mb-3 mb-md-0">
                                                    <h5 class="m-0 mb-1">${result.data.packages[i].info.name}</h5>
                                                    <span class="text-sm text-muted">Created ${dateFormatMonth(result.data.packages[i].created_at)}</span>
                                                </div>
                                                <div class="text-right text-left-mobile mb-2 mb-md-0">
                                                    <div class="d-flex flex-column">
                                                        ${htmlPrice}
                                                    </div>
                                                    <span class="text-sm text-muted">per guest</span>
                                                </div>
                                            </div>
                                            <div class="d-block py-1">
                                                <div class="d-block mb-2 text-sm">
                                                    <i class="fas fa-clock fa-sm mr-2"></i>${result.data.packages[i].info.duration.day} day activity
                                                </div>
                                                <div class="d-block mb-2 text-sm">
                                                    <i class="fas fa-archive fa-sm mr-2"></i>${result.data.packages[i].service.length} additional item
                                                </div>
                                            </div>
                                            <div class="d-block my-2">
                                                <p class="text-sm mb-0">${typeof result.data.packages[i].info.description !== 'undefined' ? result.data.packages[i].info.description : '' }</p>
                                                <small>at ${result.data.profile.name}, ${result.data.profile.destination.name} - ${result.data.profile.country.name}</small>
                                            </div>
