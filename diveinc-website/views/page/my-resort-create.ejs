                                                <button onClick="activePackage('${result.data.packages[i].id}', ${publish});" type="button" class="list-group-item activePublishPackage ${publish ? "text-success" : "text-danger"}" style="height:45px;"><i class="fas ${publish ? "fa-toggle-on" : "fa-toggle-off"} fa-sm mr-2"></i>${publish ? "Published" : "Unpublished"}</button>
                                                <a type="button" class="d-none list-group-item publishPackageLoading" style="height:45px;display:none;">
                                                    <div class="spinner-border text-primary spinner-border-sm" role="status">
                                                        <span class="sr-only">Loading...</span>
                                                    </div>
                                                </a>
                                                <a href="/my-resort-create/${id}/my-resort-create-package/${result.data.packages[i].id}" class="list-group-item flex-grow-1 text-center">Edit Package</a>
                                            </div>
                                            <div class="text-center d-block mt-2">
                                                <button type="button" onclick="deletePackageConfirm('${result.data.packages[i].id}','${result.data.packages[i].info.name}', ${publish})" class="btn btn-sm btn-link">Delete Package</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `)
                        $(function () {
                            $('[data-toggle="tooltip"]').tooltip()
                        })
                    
                        listPackageDetails[i] = `<div class="d-flex align-items-start justify-content-between flex-column mb-3">
                                    <h4 class="flex-shrink-0">${listPackage[i].info.name}</h4>
                                    <h6 class="text-muted">Package Details</h6>
                                </div>
                                <div class="d-block mt-2 border-bottom mb-4 pb-3">
                                    <h5>Package Highlight</h5>
                                    <ul class="list-base">
                                        ${list_highlight}
                                    </ul>
                                </div>
                                <div class="d-block mt-2 border-bottom mb-4 pb-3">
