    //=========================unpublish resort==================
    function unpublishResort(resortId, rId, type){
        $.ajax({
            url: `/api/resort/${resortId}/publish`,
            method: `PUT`,
            data : {
                publish : false
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    if (type==1) {
                        publishRoom(rId,false);
                    }else if(type==2){
                        publishPackage(rId, false)
                    }else if(type==3){
                        let r = rId.split('??');
                        let roomId = r[0];
                        let roomName = r[1];
                        deleteRoom(roomId, roomName);
                    }else if(type==4){
                        let r = rId.split('??');
                        let roomId = r[0];
                        let roomName = r[1];
                        deletePackage(roomId, roomName);    
                    }
                } else {
                    $("#overlay-loader").addClass('d-none');
                    let alrt = 'Unpublish Room & Resort Failed';
                    if (type==2) {
                        alrt = 'Unpublish Package & Resort Failed';
                    }else if(type==3){
                        alrt = 'Delete Room & Unpublished Resort Failed';
                    }else if(type==4){
                        alrt = 'Delete Package & Unpublished Resort Failed';
                    }
                    Swal.fire({
                        title: "Warning",
                        text: alrt                        
                    })
                    //alert(result.message)
                    //console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

