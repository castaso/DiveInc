<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav %>

<!-- DESTINATION BANNER -->
<div class="enquiry-banner have-curtain" style="background-image: url('/images/komodo-resort.jpg');">
    <div class="enquiry-banner--inner">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-8 col-md-12">
                    <div class="card border-0 rounded-0 text-black" style="overflow: hidden;">
                        <div class="row no-gutters">
                            <div class="col-md-4">
                                <div class="card-images h-100" style="background-image:url('/images/komodo-resort.jpg');">
                                </div>
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <div class="d-block mb-3">
                                        <h3 class="mb-1">Komodo Dive Resort</h3>
                                        <div class="text-sm">East Nusa Tenggara, Indonesia</div>
                                    </div>
                                    <ul class="list-base">
                                        <li>Enjoy a drift dive around at Jemuluk Bay</li>
                                        <li>Hire a jekung and dive Gili Selang</li>
                                        <li>Watch the sun go down behind Bali’s volcanoes</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer rounded-0 bg-primary text-white border-0 py-4">
                            <h4 class="mb-0">Dive packages from <span class="font-weight-bold">$235</span></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="d-block bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-12">
                <div class="promise row bg-light text-black">
                    <div class="col-md-4">
                        <div class="d-flex align-items-center flex-column text-center">
                            <img class="promise-image m-0" src="/images/selected-icon/selected-wrecks.png" alt="">
                            <div>
                                <h5 class="mb-1">Good Experiences</h5>
                                <h6 class="mb-0 font-weight-normal">See real user reviews</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center flex-column text-center">
                            <img class="promise-image m-0" src="/images/selected-icon/selected-rays.png" alt="">
                            <div>
                                <h5 class="mb-1">Stunning Destinations</h5>
                                <h6 class="mb-0 font-weight-normal">Only the finest resort</h6>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="d-flex align-items-center flex-column text-center">
                            <img class="promise-image m-0" src="/images/selected-icon/selected-reefs-walls.png" alt="">
                            <div>
                                <h5 class="mb-1">Your Safety is Real</h5>
                                <h6 class="mb-0 font-weight-normal">Selected with safety in mind</h6>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</div>
<div class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-12">
                <div class="d-block mb-5">
                    <h4 class="panel-title d-block mb-4">What happens next?</h4>
                    <ul class="list-base">
                        <li>We need your preferred dates and number of travellers to check the availability.</li>
                        <li>You will hear back from us within 2 hours with all details related to your trip.</li>
                        <li>If you receive another comparable quote at a lower price, we will match that.</li>
                    </ul>
                </div>
                <div class="d-block mb-4">
                    <h4 class="panel-title d-block mb-4">Who's comming?</h4>
                    <form>
                        <div class="form-row">
                            <div class="col-md-6 mb-4">
                                <label for="first_name">First Name</label>
                                <input type="text" class="form-control form-control-lg rounded-0 text-capitalize" name="first_name" placeholder="First name" required>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label for="last_name">Last Name</label>
                                <input type="text" class="form-control form-control-lg rounded-0 text-capitalize" name="last_name" placeholder="Last name" >
                            </div>
                            <div class="col-md-12 mb-4">
                                <label for="email_address">Email Address</label>
                                <input type="email" class="form-control form-control-lg rounded-0" name="email_address" placeholder="your.email@mail.com"  required>
                            </div>
                            <div class="col-md-12 mb-4">
                                <label for="phone_number">Phone Number</label>
                                <input type="number" class="form-control form-control-lg rounded-0" name="phone_number" placeholder="Best number to contact you on..." required>
                            </div>
                            <div class="col-md-12 mb-0">
                                <label for="who_is_coming">Number of Travellers</label>
                                <div class="explore-card">
                                    <div class="explore-card--list explore-card--33">
                                        <div class="explore-card--item">
                                            <div class="explore-card--content p-12 border text-black no-hover-animate">
                                                <h6>Diver</h6>
                                                <p class="text-sm">Diving holiday for certified divers (Open Water Diver or Higher)</p>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-outline-primary" type="button" id="button-addon1">-</button>
                                                    </div>
                                                    <input type="text" class="form-control text-center" placeholder="" aria-label="Example text with button addon" aria-describedby="button-addon1" value="0">
                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-primary" type="button" id="button-addon1">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="explore-card--item">
                                            <div class="explore-card--content p-12 border text-black no-hover-animate">
                                                <h6>Students</h6>
                                                <p class="text-sm">Learn to dive during your holiday by taking an open water course</p>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-outline-primary" type="button" id="button-addon1">-</button>
                                                    </div>
                                                    <input type="text" class="form-control text-center" placeholder="" aria-label="Example text with button addon" aria-describedby="button-addon1" value="1">
                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-primary" type="button" id="button-addon1">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="explore-card--item">
                                            <div class="explore-card--content p-12 border text-black no-hover-animate">
                                                <h6>Non-divers</h6>
                                                <p class="text-sm">Guests that do not wish to dive during the holiday</p>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <button class="btn btn-outline-primary" type="button" id="button-addon1">-</button>
                                                    </div>
                                                    <input type="text" class="form-control text-center" placeholder="" aria-label="Example text with button addon" aria-describedby="button-addon1" value="1">
                                                    <div class="input-group-append">
                                                        <button class="btn btn-outline-primary" type="button" id="button-addon1">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 mb-4">
                                <label for="phone_number">Preffered Date</label>
                                <input type="number" class="form-control form-control-lg rounded-0" name="phone_number" placeholder="Pick your date..." required>
                            </div>
                            <div class="col-md-12 mb-4">
                                <label for="additional_info">Additional Information</label>
                                <textarea class="form-control form-control-lg rounded-0" name="additional_info" placeholder="Any additional information you'd like to tell us..." ></textarea>
                            </div>
                            <div class="col-md-12 mb-3">
                                <div class="d-block">Would you like to receive further updates about Dive?</div>
                                <div class="select-card-wrapper">
                                    <div class="select-card select-card-inherit select-card-naked select-card-inline">
                                        <label class="select-card-inner select-card-inner-h">
                                            <input type="checkbox" name="dive-email-update"/>
                                            <div class="select-card-content">
                                                <h6 class="mb-0 font-weight-normal">Yes please!</h6>
                                            </div>
                                            <div class="select-card-checkbox"></div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-12 mb-4 text-sm">
                                For more information how we handle your data, please read our <a href="" class="text-underline">Diveinc's Privacy Policy</a>.
                            </div>
                            </div>
                        <button class="btn btn-primary btn-lg-2" type="submit">Book Your Trip</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- FOOTER -->
<%-include ../partial/footer-nav %>
<%-include ../partial/footer %>