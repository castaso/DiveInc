<script>
    var id = "<%= id %>"
    var destination_id = '';

    var creatures = []
    var dataCreatures = []

    const today = new Date();

    const monthNames = ["January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December"];
    $(document).ready(function(){
        loadDestinationById(id);
    })

    function loadDestinationById(id){
        $.ajax({
            url: `/api/sub-destination/${id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    destination_id = result.data.destination.id;
                    $('#introLoader, #aboutLoader, #highlightLoader, #bannerLoader, #tabLoader').addClass('hideImportant');
                    console.log(result)
                    $('#name').text(result.data.name)
                    $('.nameDestination').text(result.data.name)
                    $('#nameHighlight').text(result.data.name)
                    $('#nameArticle').text(result.data.name)
                    $('#nameAbout').text(result.data.name)
                    $('#tagLine').text(result.data.tag_line)
                    $('#description').text(result.data.description)
                    $('#introduction').text(result.data.introduction)
                    // $('#background').css({"background-image": result.data.image_background[0].url}
                    $('#background').css("background-image", `url('${result.data.image_background[0].url}')`)
                    $('#about').append(result.data.about)

                    creatures = result.data.creatures
                    dataCreatures = result.data.dataCreature

                    for(var i = 0; i < result.data.highlight.length; i++){
                        $('#listHighlight').append(`
                            <li>${result.data.highlight[i].value || result.data.highlight[i].text}</li>
                        `)
                    }

                    for(var i = 0; i < result.data.image_galery.length; i++){
                        $('#listGalery').append(`
                            <div data-src="${result.data.image_galery[i].url}"  class="gallery-item" style="background-image: url('${result.data.image_galery[i].url}');"><div>View Picture<img src="${result.data.image_galery[i].url}"/></div></div>
                        `)
                    }
                     $('#listGalery').lightGallery({
                        selector: '.gallery-item',
                        thumbnail: true
                    });

                    for(var i = 0; i < result.data.more_about.length; i++){
                        if(result.data.more_about[i].type == "link"){
                            $('#listMoreAbout').append(`
                                <div class="list-panel">
                                    <a href="${result.data.more_about[i].value}" target="_blank"><i class="mr-1 fas fa-external-link-alt fa-sm"></i>${result.data.more_about[i].key}</a>
                                </div>
                            `)
                        }else {
                            $('#listMoreAbout').append(`
                                <div class="list-panel">
                                    <div class="list-panel-title">${result.data.more_about[i].key}</div>
                                    <div class="list-panel-content">${result.data.more_about[i].value}</div>
                                </div>
                            `)
                        }
                    }

                    for(var i = 0; i < result.data.more_info.length; i++){
                        if(i == 0){
                            $('#myTab').append(`
                                <li class="nav-item">
                                    <a class="nav-link active" id="${result.data.more_info[i].id}-tab" data-toggle="tab" href="#${result.data.more_info[i].id}" role="tab" aria-controls="${result.data.more_info[i].id}" aria-selected="false">${result.data.more_info[i].title}</a>
                                </li>
                            `)
                            $('#myTabContent').append(`
