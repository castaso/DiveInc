    function loadLiveAboardById(){
        $.ajax({
            url: `/api/liveaboard/publish?destination=${destination_id}&sub_destination=${id}`,
            // url: `/api/liveaboard/sub-destination/${id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    if (result.data.length == 0) {
                        $("#liveaboardSection").hide();
                    }
                    for(var i = 0; i < result.data.length; i++){

                        var htmlPhotos = ``
                        var dataPhotos = result.data[i].photos
                        for(var j = 0; j < dataPhotos.length; j++){
                            htmlPhotos += `
                                <div class="glide__slide--photos"  style="background-image: url('${dataPhotos[j].url}');">
                                   
                                </div>
                            `
                        }

                        var pricePackage = "0";
                        var dataPackage = result.data[i].packages;
                        let tgl_awal = '';
                        let tgl_akhir = '';
                        for(var j = 0; j < dataPackage.length; j++){
                            if(parseFloat(pricePackage) == 0){
                                if(dataPackage[j].price.discount != "" && dataPackage[j].price.discount != "0" && dataPackage[j].price.discount != 0  && dataPackage[j].price.discount != "NaN"){
                                    pricePackage = dataPackage[j].price.discount
                                }else{
                                    pricePackage = dataPackage[j].price.price
                                }
                            }else{
                                if(dataPackage[j].price.discozkunt != "" && dataPackage[j].price.discount != "0" && dataPackage[j].price.discount != 0 && dataPackage[j].price.discount != "NaN"){
                                    if(parseFloat(pricePackage) > parseFloat(dataPackage[j].price.discount)){
                                        pricePackage = dataPackage[j].price.discount
                                    }
                                }else {
                                    if(parseFloat(pricePackage) > parseFloat(dataPackage[j].price.price)){
                                        pricePackage = dataPackage[j].price.price
                                    }
                                }
                            }

                            let schedules = dataPackage[j].schedules;
                            let schedules_list = [];
                            for (let s_idx = 0; s_idx < schedules.length; s_idx++) {
                                let tgl = reverseDate(schedules[s_idx].schedule_date);
                                let schDate = new Date(tgl)
                                if (schDate.getTime() > today.getTime() ) {
                                    tgl = new Date(tgl);
                                    schedules_list.push(tgl);   
                                }
                            }

                            if (schedules_list.length > 1) {
                                let maxD=new Date(Math.max.apply(null,schedules_list));
                                let minD=new Date(Math.min.apply(null,schedules_list));
    
                                tgl_awal = minD.getDate()+' '+monthNames[minD.getMonth()]+' '+minD.getFullYear();
                                tgl_akhir = maxD.getDate()+' '+monthNames[maxD.getMonth()]+' '+maxD.getFullYear();
                            }

                        }

                        // console.log(${dataPackage[0].schedules.schedule_date})

                        $('#listLiveAboard').append(`
                            <div class="explore-card--item">
                                <div class="explore-card--content shadow-sm">
                                    <div class="d-block">
                                        <span class="badge-photos badge badge-dark badge-pill rounded">${dataPhotos.length} Photos</span>
                                        <div class="slick2">
                                            ${htmlPhotos}
                                        </div>
                                    </div>
                                    
                                    <div class="explore-card--details">
                                        <h4>${result.data[i].profile.name}</h4>
                                    </div>
                                    <div class="explore-card--footer">
                                        <div class="footer--details w-100">
                                            <div class="row mb-2">
                                                <div class="col-md-12">
                                                    <div class="details-price">
                                                        <small>Packages from </small><br>
                                                        <h5 class="mb-0"><span class="font-size-sm">IDR</span> ${formatRupiah(pricePackage)} <span class="font-size-sm font-weight-normal">/person</span></h5>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="d-block">
                                                <small class="text-ellipsis"><i class="fas fa-map-marker-alt mr-1"></i>${result.data[i].profile.sub_destination.name}, ${result.data[i].profile.destination.name} - ${result.data[i].profile.country.name}</small>
                                                <!--<small class="d-block"><i class="fas fa-swimmer fas-fix mr-1 text-secondary"></i>Including 12 dives</small>-->
                                                <small class="d-block"><i class="fas fa-calendar fas-fix mr-1 text-secondary"></i>${tgl_awal} - ${tgl_akhir}</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="explore-card--action">
                                        <a href="/liveaboards/${result.data[i].id}" class="btn btn-primary mb-2 btn-block">View LiveAbord</a>
                                    </div>
                                </div>
                            </div>
                        `)
                    }

                    $('.slick2').slick({
                        infinite: false
                    });
                    // $('.slick').on('lazyLoaded', function (e, slick, image, imageSource) { 
                    //     image.parent().css('background-image', 'url("' + imageSource + '")'); 
                    //     image.hide(); 
                    // });

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

