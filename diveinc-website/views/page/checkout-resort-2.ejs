<script>

    var id="<%= id %>"

    var packageData
    var rooms
    var packages

    $(document).ready(function(){

        $('#link-co-1').attr('href',`/checkout-resort/${id}/schedule`);
        loadTransactionById()
    })

    function loadTransactionById(){
        $.ajax({
            url: `/api/transaction-resort/${id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    console.log(result)
                    $('#checkoutCover, #checkout2Loader').addClass('hideImportant');

                    packageData = result.data.package_data
                    rooms = result.data.resort.rooms
                    packages = result.data.resort.packages
                    if (result.data.transaction_resort_status_id == 'b648ff73-468f-45cb-bbbc-fd3659e4b8ac') {
                        window.location.replace(`/checkout-resort/${result.data.id}/reserve`);
                    }

                    // console.log(packageData.room_date.from, packageData.room_date.to);
                    
                    if (typeof packageData.room !== 'undefined' &&  packageData.room.length > 0) {
                        $('#travelDate').append('<i class="fas fa-calendar fa-sm mr-2"></i> '+dateFormatSM(packageData.room_date.from)+' to '+dateFormatSM(packageData.room_date.to)+'<br/>');
                    }
                    $('.backgroundImage').css("background-image", `url('${result.data.resort.photos[0].url}')`)
                    $('.resortName').text(result.data.resort.profile.name)
                    $('.resortLocation').text(`${result.data.resort.profile.sub_destination.name} - ${result.data.resort.profile.destination.name}, ${result.data.resort.profile.country.name}`)

                    if(packageData.package){
                        for(var i = 0; i < packageData.package.length; i++){
                            
                            var packageItem = packageData.package[i].packageItem;

                            for(var x = 0; x < packageData.package[i].packageItem.length; x++){
                                $('#travelDate').append('<i class="fas fa-calendar fa-sm mr-2"></i> '+dateFormatSM(packageData.package[i].packageItem[x].package_date)+'<br/>');
                                $('#listDataPackage').append(`
                                    <li class="list-group-item">
                                        <div class="list-person">
                                            <div class="list-person--title">
                                                <div>${packageData.package[i].packageName} [Package plan - ${x + 1}]</div>
                                                <div style="min-width:120px; font-weight:500; position:relative" class='text-right'>
                                                    <div style='position:absolute;right:0px; bottom:0px' >IDR <span id="summaryTotal${packageData.package[i].packageItem[x].id}">${parseFloat(packageData.package[i].packagePrice)*parseFloat(packageData.package[i].packageItem[x].guest)}</span></div>
                                                </div>
                                            </div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="far fa-user fa-sm fas-fix mr-1"></i>IDR&nbsp; ${formatRupiah(packageData.package[i].packagePrice)} x${packageData.package[i].packageItem[x].guest}</div>
                                                <div>IDR&nbsp; <span id="total${packageData.package[i].packageItem[x].id}">${formatRupiah(parseFloat(packageData.package[i].packagePrice)*parseFloat(packageData.package[i].packageItem[x].guest))}</span></div>
                                            </div>
                                            <div class="all-extra" id="extra${packageData.package[i].packageItem[x].id}"></div>
                                        </div>
                                    </li>
                                `)
                            }

                            for(var x = 0; x < packageItem.length; x++){

                                var htmlExtraPackage = ""
                                var htmlExtraPackageMobile = ""
                                var namePackage = ""
                                var pService = [];
                                if (typeof packageItem[x].service !== 'undefined' ) {
                                    for (let p_idx = 0; p_idx < packageItem[x].service.length; p_idx++) {
                                        pService[`${packageItem[x].service[p_idx].id}`] = packageItem[x].service[p_idx].qty; 
                                    }
                                    
                                }
                                
                                for(var j = 0; j < packages.length; j++){
                                    if(packageData.package[i].id == packages[j].id){

                                        if(namePackage == ""){
                                            namePackage = packages[j].info.name + ` - Package plan ${x+1}`
                                        }

                                        var dataService = []
                                        packageItem[x].service = []

                                        for(var k = 0; k < packages[j].service.length; k++){
                                            htmlExtraPackage += `
                                                <tr>
                                                    <td><span class="font-weight-bold">${packages[j].service[k].name}</span></td>
                                                    <td>
                                                        <div class="input-group" style="width: 140px;">
                                                            <div class="input-group-prepend">
                                                                <button onClick="minButtonPackage('${packageData.package[i].id}','${packages[j].service[k].id}', '${packageItem[x].id}','${packages[j].service[k].price}')" class="btn btn-outline-primary btn-number" type="button" data-type="minus" data-field="quant[1]">-</button>
                                                            </div>
                                                            <input id="inputExtraPackage-${packages[j].service[k].id}-${packageData.package[i].id}-${packageItem[x].id}" type="text" class="form-control input-number text-center" value="${(typeof pService[packages[j].service[k].id] !== 'undefined' ? pService[packages[j].service[k].id] : 0)}">
                                                            <div class="input-group-append">
                                                                <button onClick="plusButtonPackage('${packageData.package[i].id}','${packages[j].service[k].id}','${packageItem[x].id}','${packages[j].service[k].price}', '${packages[j].service[k].qty}')" class="btn btn-outline-primary btn-number" type="button" data-type="plus" data-field="quant[1]">+</button>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4"><span class="font-weight-bold">${formatRupiah(packages[j].service[k].price)}</span></td>
                                                </tr>
                                            `

                                            let opt = ''
                                            let mx = packages[j].service[k].qty;
                                            let extraQty = (typeof pService[packages[j].service[k].id] !== 'undefined' ? pService[packages[j].service[k].id] : 0);
                                            if (mx == '' || mx == 0) {
                                                mx = 10
                                            }
                                            for (let x = 0; x <= mx; x++) {
                                                opt += `<option ${(extraQty == x ? 'selected': '')} value='${x}'>${x}</option>`
                                            }

                                            let srvShow = `<select class='form-control' style='max-width:90px' onchange="changePackageQty('${packageData.package[i].id}','${packages[j].service[k].id}', '${packageItem[x].id}','${packages[j].service[k].price}')" id="packageQty-${packages[j].service[k].id}">
                                                                ${opt}
                                                            </select>`

                                            htmlExtraPackageMobile += `
                                                <tr>
                                                    <td><span class="font-weight-bold">${packages[j].service[k].name}</span></td>
                                                    <td style='min-width:140px; text-align:left;'>
                                                        <div class='mb-2'>
                                                            ${srvShow}
                                                        </div>
                                                        x IDR ${formatRupiah(packages[j].service[k].price)}
                                                    </td>
                                                </tr>
                                            `
                                            
                                            dataService.push({
                                                id : packages[j].service[k].id,
                                                name : packages[j].service[k].name,
                                                price : packages[j].service[k].price,
                                                qty : parseInt(typeof pService[packages[j].service[k].id] !== 'undefined' ? pService[packages[j].service[k].id] : 0)
                                            })
                                        }

                                        packageItem[x].service = dataService
                                    }
                                }

                                $('#listPackage').append(`
                                    <div class="d-block">
                                        <h5>${namePackage}</h5>
                                        <table class="table mb-5 w-100">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th class="w-100 text-sm">Item</th>
                                                    <th class="text-sm">Quantity</th>
                                                    <th class="px-4 text-sm">Price&nbsp(IDR)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${htmlExtraPackage}
                                            </tbody>
                                        </table>
                                    </div>
                                `)


                                $('#listPackageMobile').append(`
                                    <div class="d-block table-scroll-x">
                                        <h5>${packageData.package[i].packageName}</h5>
                                        <table class="table mb-5 w-100 tableExtraMobile">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th class="w-100 text-sm">Item</th>
                                                    <th class="text-sm">Quantity<br/>x Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${htmlExtraPackageMobile}
                                            </tbody>
                                        </table>
                                    </div>
                                `)
                                
                            }
                        }
                    }

                    if(packageData.room){
                        for(var i = 0; i < packageData.room.length; i++){

                            var roomItem = packageData.room[i].roomItem

                            for(var j = 0; j < packageData.room[i].roomItem.length; j++){

                                if(packageData.room[i].sharingRoom == "yes"){
                                    $('#listDataRoom').append(`
                                        <li id="${packageData.room[i].id}" class="list-group-item">
                                            <div class="list-person">
                                                <div class="list-person--title">
                                                    <div class="mr-2">${packageData.room[i].roomName} [Dorm ${j+1}]</div>
                                                    <div style="min-width:120px; font-weight:500; position:relative" class='text-right'>
                                                        <div style='position:absolute;right:0px; bottom:0px'>IDR&nbsp; <span id="summaryTotal${packageData.room[i].roomItem[j].id}">${(packageData.room[i].roomPrice) * (roomItem[j].guest)}</span></div>
                                                    </div>
                                                </div>
                                                <div class="list-person--item text-muted">
                                                    <div><i class="far fa-moon fa-sm fas-fix mr-1"></i>IDR&nbsp; ${formatRupiah(packageData.room[i].roomPrice * roomItem[j].guest)}&nbsp;x<span id="night${packageData.room[i].roomItem[j].id}">0</span></div>
                                                    <div>IDR&nbsp; <span id="total${packageData.room[i].roomItem[j].id}">0</span></div>
                                                </div>
                                                <div class="all-extra" id="extra${packageData.room[i].roomItem[j].id}"></div>
                                                <div class="list-person--item text-muted">
                                                    <div><i class="far fa-user fa-sm fas-fix mr-1"></i>x${packageData.room[i].roomItem[j].guest}</div>
                                                </div>
                                            </div>
                                        </li>
                                    `)
                                }else{
                                    $('#listDataRoom').append(`
                                        <li id="${packageData.room[i].id}" class="list-group-item">
                                            <div class="list-person">
                                                <div class="list-person--title">
                                                    <div class="mr-2">${packageData.room[i].roomName} [Dorm ${j+1}]</div>
                                                    <div style="min-width:120px; font-weight:500; position:relative" class='text-right'>
                                                        <div style='position:absolute;right:0px; bottom:0px'>IDR&nbsp; <span id="summaryTotal${packageData.room[i].roomItem[j].id}">${packageData.room[i].roomPrice}</span></div>
                                                    </div>
                                                </div>
                                                
                                                <div class="list-person--item text-muted">
                                                    <div><i class="far fa-moon fa-sm fas-fix mr-1"></i>IDR&nbsp; ${formatRupiah(packageData.room[i].roomPrice)}&nbsp;x<span id="night${packageData.room[i].roomItem[j].id}">0</span></div>
                                                    <div>IDR&nbsp; <span id="total${packageData.room[i].roomItem[j].id}">0</span></div>
                                                </div>
                                                <div class="all-extra" id="extra${packageData.room[i].roomItem[j].id}"></div>
                                                <div class="list-person--item text-muted">
                                                    <div><i class="far fa-user fa-sm fas-fix mr-1"></i>x${packageData.room[i].roomItem[j].guest}</div>
                                                </div>
                                            </div>
                                        </li>
                                    `)
                                }
                            }

                            for(var x = 0; x < roomItem.length; x++){

                                var htmlExtraRoom = ""
                                var htmlExtraRoomMobile = ""
                                var nameRoom = ""
                                var rService = [];
                                if (typeof roomItem[x].service !== 'undefined' ) {
                                    for (let p_idx = 0; p_idx < roomItem[x].service.length; p_idx++) {
                                        rService[`${roomItem[x].service[p_idx].id}`] = roomItem[x].service[p_idx].qty; 
                                    }
                                    
                                }

                                var roomQty
                                var roomPrice

                                for(var j = 0; j < rooms.length; j++){
                                    if(packageData.room[i].id == rooms[j].id){

                                        if(nameRoom == ""){
                                            nameRoom = rooms[j].info.name + ` - Room ${x+1}`
                                        }

                                        var dataService = []
                                        // roomItem[x].service = []
                                        for(var k = 0; k < rooms[j].service.length; k++){
                                            htmlExtraRoom = htmlExtraRoom + `
                                                <tr>
                                                    <td><span class="font-weight-bold">${rooms[j].service[k].name}</span></td>
                                                    <td>
                                                        <div class="input-group" style="width: 140px;">
                                                            <div class="input-group-prepend">
                                                                <button onClick="minButtonRoom('${packageData.room[i].id}','${rooms[j].service[k].id}', '${roomItem[x].id}', '${rooms[j].service[k].price}')" class="btn btn-outline-primary btn-number" type="button" data-type="minus" data-field="quant[1]">-</button>
                                                            </div>
                                                            <input id="inputExtraRoom-${rooms[j].service[k].id}-${roomItem[x].id}" type="text" class="form-control input-number text-center" value="${(typeof roomItem[x].service !== 'undefined' ? roomItem[x].service[k].qty : '0')}">
                                                            <div class="input-group-append">
                                                                <button onClick="plusButtonRoom('${packageData.room[i].id}','${rooms[j].service[k].id}','${roomItem[x].id}', '${rooms[j].service[k].price}', '${rooms[j].service[k].qty}')" class="btn btn-outline-primary btn-number" type="button" data-type="plus" data-field="quant[1]">+</button>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-4"><span class="font-weight-bold">${formatRupiah(rooms[j].service[k].price)}</span></td>
                                                </tr>
                                            `

                                            let opt = ''
                                            let mx = rooms[j].service[k].qty;
                                            let extraQty = (typeof rService[rooms[j].service[k].id] !== 'undefined' ? rService[rooms[j].service[k].id] : 0);
                                            
                                            for (let x = 0; x <= mx; x++) {
                                                opt += `<option ${(extraQty == x ? 'selected': '')} value='${x}'>${x}</option>`
                                            }

                                            let srvShow = `<select class='form-control' style='max-width:90px' onchange="changeRoomQty('${packageData.room[i].id}','${rooms[j].service[k].id}','${roomItem[x].id}', '${rooms[j].service[k].price}')" id="roomQty-${rooms[j].service[k].id}">
                                                                ${opt}
                                                            </select>`

                                            htmlExtraRoomMobile += `
                                                <tr>
                                                    <td><span class="font-weight-bold">${rooms[j].service[k].name}</span></td>
                                                    <td style='min-width:140px; text-align:left;'>
                                                        <div class='mb-2'>
                                                            ${srvShow}
                                                        </div>
                                                        x IDR ${formatRupiah(rooms[j].service[k].price)}
                                                    </td>
                                                </tr>
                                            `

                                            
                                            dataService.push({
                                                id : rooms[j].service[k].id,
                                                name : rooms[j].service[k].name,
                                                price : rooms[j].service[k].price,
                                                qty : parseInt(typeof roomItem[x].service !== 'undefined' ? roomItem[x].service[k].qty : '0')
                                            })
                                        }

                                        roomItem[x].service = []
                                        roomItem[x].service = dataService
                                    }
                                }
                                

                                $('#listRoom').append(`
                                    <div class="d-block table-scroll-x">
                                        <h5>${nameRoom}</h5>
                                        <table class="table mb-5 w-100">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th class="w-100 text-sm">Item</th>
                                                    <th class="text-sm">Quantity</th>
                                                    <th class="px-4 text-sm">Price&nbsp;(IDR)</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${htmlExtraRoom}
                                            </tbody>
                                        </table>
                                    </div>
                                `)

                                $('#listRoomMobile').append(`
                                    <div class="d-block table-scroll-x">
                                        <h5>${nameRoom}</h5>
                                        <table class="table mb-5 w-100 tableExtraMobile">
                                            <thead class="thead-light">
                                                <tr>
                                                    <th class="w-100 text-sm">Item</th>
                                                    <th class="text-sm">Quantity<br/>x Price</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                ${htmlExtraRoomMobile}
                                            </tbody>
                                        </table>
                                    </div>
                                `)

                                console.log($('#listRoom').html())
                            }
                        }
                    }
                    
                    loadItem()

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function plusButtonRoom(roomId, serviceId, roomItemId, roomPrice, roomQty){
        var dataCount = $(`#inputExtraRoom-${serviceId}-${roomItemId}`).val()
        if(dataCount < parseInt(roomQty)){
            dataCount++
            $(`#inputExtraRoom-${serviceId}-${roomItemId}`).val(dataCount)
            for(var i = 0; i < packageData.room.length; i++){
                if(packageData.room[i].id == roomId){
                    for(var j = 0; j < packageData.room[i].roomItem.length; j++){
                        if(packageData.room[i].roomItem[j].id == roomItemId){
                            for(var x = 0; x < packageData.room[i].roomItem[j].service.length; x++){
                                if(packageData.room[i].roomItem[j].service[x].id == serviceId){
                                    packageData.room[i].roomItem[j].service[x].qty = dataCount
                                }
                            }
                        } 
                    }
                }
            }
        }else{
            alert("Max quantity")
        }
        loadItem()
    }

    function plusButtonPackage(packageId, serviceId, packageItemId, packagePrice, packageQty){
        var dataCount = $(`#inputExtraPackage-${serviceId}-${packageId}-${packageItemId}`).val()
        if(dataCount < parseInt(packageQty)){
            dataCount++
            $(`#inputExtraPackage-${serviceId}-${packageId}-${packageItemId}`).val(dataCount)
            for(var i = 0; i < packageData.package.length; i++){
                if(packageData.package[i].id == packageId){
                    for(var x = 0; x < packageData.package[i].packageItem.length; x++){
                        if(packageData.package[i].packageItem[x].id == packageItemId){
                            for(var j = 0; j < packageData.package[i].packageItem[x].service.length; j++){
                                if(packageData.package[i].packageItem[x].service[j].id == serviceId){
                                    packageData.package[i].packageItem[x].service[j].qty = dataCount
                                }
                            }
                        }
                    }
                }
            }
        }else{
            alert("Max quantity")
        }
        loadItem()
    }

    function minButtonRoom(roomId, serviceId, roomItemId, roomPrice){
        var dataCount = $(`#inputExtraRoom-${serviceId}-${roomItemId}`).val()
        if(dataCount > 0){
            dataCount--
            $(`#inputExtraRoom-${serviceId}-${roomItemId}`).val(dataCount)
            for(var i = 0; i < packageData.room.length; i++){
                if(packageData.room[i].id == roomId){
                    for(var j = 0; j < packageData.room[i].roomItem.length; j++){
                        if(packageData.room[i].roomItem[j].id == roomItemId){
                            for(var x = 0; x < packageData.room[i].roomItem[j].service.length; x++){
                                if(packageData.room[i].roomItem[j].service[x].id == serviceId){
                                    packageData.room[i].roomItem[j].service[x].qty = dataCount
                                }
                            }
                        } 
                    }
                }
            }
        }
        loadItem()
    }

    function minButtonPackage(packageId, serviceId, packageItemId, packagePrice){
        var dataCount = $(`#inputExtraPackage-${serviceId}-${packageId}-${packageItemId}`).val()
        if(dataCount > 0){
            dataCount--
            $(`#inputExtraPackage-${serviceId}-${packageId}-${packageItemId}`).val(dataCount)
            for(var i = 0; i < packageData.package.length; i++){
                if(packageData.package[i].id == packageId){
                    for(var x = 0; x < packageData.package[i].packageItem.length; x++){
                        if(packageData.package[i].packageItem[x].id == packageItemId){
                            for(var j = 0; j < packageData.package[i].packageItem[x].service.length; j++){
                                if(packageData.package[i].packageItem[x].service[j].id == serviceId){
                                    packageData.package[i].packageItem[x].service[j].qty = dataCount
                                }
                            }
                        }
                    }
                }
            }
        }
        loadItem()
    }

    function loadItem(){

        console.log(packageData.package)
        $('.all-extra').empty()

        var totalPrice = 0

        if(packageData.package){
            for(var i = 0; i< packageData.package.length; i++){

                for(var j = 0; j < packageData.package[i].packageItem.length; j++){
                    var totalSummary = 0
                    var summaryPrice = parseFloat(packageData.package[i].packagePrice) * parseFloat(packageData.package[i].packageItem[j].guest)
                    $(`#total${packageData.package[i].packageItem[j].id}`).text(formatRupiah(summaryPrice))
                    totalSummary += summaryPrice

                    for(var k = 0; k < packageData.package[i].packageItem[j].service.length; k++){
                        if(packageData.package[i].packageItem[j].service[k].qty > 0){
                            $(`#extra${packageData.package[i].packageItem[j].id}`).append(`
                                <div class="list-person--item text-muted">
                                    <div><i class="fas fa-plus fa-sm fas-fix mr-1"></i>${packageData.package[i].packageItem[j].service[k].name} (IDR&nbsp;${formatRupiah(packageData.package[i].packageItem[j].service[k].price)} x${packageData.package[i].packageItem[j].service[k].qty})</div>
                                    <div class="list-price">IDR&nbsp; ${formatRupiah(parseFloat(packageData.package[i].packageItem[j].service[k].price) * parseFloat(packageData.package[i].packageItem[j].service[k].qty))}</div>
                                </div>
                            `)

                            totalSummary += (parseFloat(packageData.package[i].packageItem[j].service[k].price) * parseFloat(packageData.package[i].packageItem[j].service[k].qty))
                        }
                    }

                    $(`#summaryTotal${packageData.package[i].packageItem[j].id}`).text(formatRupiah(totalSummary)) 
                    totalPrice += totalSummary
                }
            }
        }

        if(packageData.room){

            var night = (new Date(packageData.room_date.to) - new Date(packageData.room_date.from)) / (1000 * 3600 * 24)

            for(var i = 0; i < packageData.room.length; i++){
                
                for(var j = 0; j < packageData.room[i].roomItem.length; j++){
                    var totalSummary = 0
                    $(`#night${packageData.room[i].roomItem[j].id}`).text(night)
                    //var summaryPrice = parseFloat(night) * parseFloat(packageData.room[i].roomPrice)
                    var summaryPrice = 0
                    if(packageData.room[i].sharingRoom == "yes"){
                        summaryPrice = parseFloat(night) * parseFloat(packageData.room[i].roomPrice) * parseFloat(packageData.room[i].roomItem[j].guest)
                    }else{
                        summaryPrice = parseFloat(night) * parseFloat(packageData.room[i].roomPrice)
                    }
                    $(`#total${packageData.room[i].roomItem[j].id}`).text(formatRupiah(summaryPrice))
                    totalSummary += summaryPrice

                    for(var x = 0; x < packageData.room[i].roomItem[j].service.length; x++){
                        if(packageData.room[i].roomItem[j].service[x].qty > 0){
                            $(`#extra${packageData.room[i].roomItem[j].id}`).append(`
                                <div class="list-person--item text-muted">
                                    <div class="mr-2"><i class="fas fa-plus fa-sm fas-fix mr-1"></i>${packageData.room[i].roomItem[j].service[x].name} (IDR&nbsp;${formatRupiah(packageData.room[i].roomItem[j].service[x].price)} x${packageData.room[i].roomItem[j].service[x].qty})</div>
                                    <div class="list-price">IDR&nbsp;${formatRupiah(parseFloat(packageData.room[i].roomItem[j].service[x].price) * parseFloat(packageData.room[i].roomItem[j].service[x].qty))}</div>
                                </div>
                            `)

                            totalSummary += (parseFloat(packageData.room[i].roomItem[j].service[x].price) * parseFloat(packageData.room[i].roomItem[j].service[x].qty))
                            
                        }
                    }
                    $(`#summaryTotal${packageData.room[i].roomItem[j].id}`).text(formatRupiah(totalSummary)) 
                    totalPrice += totalSummary
                }
            }
        }
        
        $('#totalResorPrice').text(`IDR ${formatRupiah(totalPrice)}`)
    }

    function checkout(){
        $("#overlay-checkout").removeClass('d-none');
        $.ajax({
            url: `/api/transaction-resort/${id}/extra`,
            method: `PUT`,
            data : {
                package_data : packageData
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    location.href = `/checkout-resort/${result.data.id}/guest`
                } else {
                    alert(result.message)
                    console.log(result)
                    $("#overlay-checkout").addClass('d-none');
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }

                if (xhr.responseJSON.message == 'Token is required') {
                    $("#overlay-checkout").addClass('d-none');
                    loginRequired();
                }
            }
        })
    }

    function changePackageQty(packageId, serviceId, packageItemId, packagePrice){
        var dataCount = $(`#packageQty-${serviceId}`).val()
        $(`#inputExtraPackageMobile-${serviceId}-${packageId}`).val(dataCount)
        $(`#inputExtraPackage-${serviceId}-${packageId}-${packageItemId}`).val(dataCount)
        
        for(var i = 0; i < packageData.package.length; i++){
            if(packageData.package[i].id == packageId){
                for(var x = 0; x < packageData.package[i].packageItem.length; x++){
                    if(packageData.package[i].packageItem[x].id == packageItemId){
                        for(var j = 0; j < packageData.package[i].packageItem[x].service.length; j++){
                            if(packageData.package[i].packageItem[x].service[j].id == serviceId){
                                packageData.package[i].packageItem[x].service[j].qty = dataCount
                            }
                        }
                    }
                }
            }
        }
        loadItem()
    }

    function changeRoomQty(roomId, serviceId, roomItemId, roomPrice){
        var dataCount = $(`#roomQty-${serviceId}`).val()

        // console.log(`#inputExtraRoom-${serviceId}-${roomItemId}`)
        $(`#inputExtraRoom-${serviceId}-${roomItemId}`).val(dataCount)
        
        for(var i = 0; i < packageData.room.length; i++){
                if(packageData.room[i].id == roomId){
                    for(var j = 0; j < packageData.room[i].roomItem.length; j++){
                        if(packageData.room[i].roomItem[j].id == roomItemId){
                            for(var x = 0; x < packageData.room[i].roomItem[j].service.length; x++){
                                if(packageData.room[i].roomItem[j].service[x].id == serviceId){
                                    packageData.room[i].roomItem[j].service[x].qty = dataCount
                                }
                            }
                        } 
                    }
                }
            }
        loadItem()
    }

</script>

