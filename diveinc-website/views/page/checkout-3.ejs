        for (var i = 0; i < packageData.package.length; i++){
            if(packageData.package[i].id == packageId){
                for(var k = 0; k < packageData.package[i].detail_guest.length; k++){
                    if(packageData.package[i].detail_guest[k].id == personId){
                        packageData.package[i].detail_guest[k].nationality = $(`#nat-${packageId}-${personId}`).val()
                    }
                }
            }
        }

        console.log(packageData)
    }

    function changeIdentityNumber(roomId, roomItemId, personId){
        for (var i = 0; i < packageData.room.length; i++){
            if(packageData.room[i].id == roomId){
                var roomItem = packageData.room[i].roomItem
                for(var j = 0; j < roomItem.length; j++){
                    if(roomItem[j].id == roomItemId){
                        for(var k = 0; k < roomItem[j].detail_guest.length; k++){
                            if(roomItem[j].detail_guest[k].id == personId){
                                packageData.room[i].roomItem[j].detail_guest[k].identity_number = $(`#identity-${roomId}-${roomItemId}-${personId}`).val()
                            }
                        }
                    }
                }
            }
        }
    }
</script>