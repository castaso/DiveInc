    function checkout(tipe){

        let isDisabled = false;
        if (tipe == 1) {
            if($('#verifyTermsButton').hasClass('disabled')){
                isDisabled = true;
            };
        }else{
            if($('#verifyTermsButton2').hasClass('disabled')){
                isDisabled = true;
            }
        }

        for (var i = 0; i < packageData.room.length; i++){
            var roomItem = packageData.room[i].roomItem
            for(var j = 0; j < roomItem.length; j++){
                for(var k = 0; k < roomItem[j].detail_guest.length; k++){
                    if(packageData.room[i].roomItem[j].detail_guest[k].first_name == ""){
                        Swal.fire(
                            "First Name Required",
                        );
                        return;
                        break;
                    }        
                }
            }
        }

        if($('#inputEmail').val() == "" || $('#inputPhone').val() == ""){
            Swal.fire(
                "Email & phone number required",
            );
            return;
        }

        if (!validateEmail($('#inputEmail').val())) {
            return Swal.fire(
                    "Invalid Email Address",
                ).then(function(){
                    $('#inputEmail').focus()
                });
        }

        packageData.contact = {
            email : $('#inputEmail').val(),
            phone_number : $('#inputPhone').val(),
            request : $('#inputRequest').val()
        }

        if (!isDisabled) {
            $("#overlay-checkout").removeClass('d-none');
            $.ajax({
                url: `/api/transaction-liveaboard/${id}/guest`,
                method: `PUT`,
                data : {
                    package_data : packageData
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        location.href = `/checkout-liveaboards/${result.data.id}/reserve`
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
    
                    if (xhr.responseJSON.message == 'Token is required') {
                        $("#overlay-checkout").addClass('d-none');
                        loginRequired();
                    }
                }
            });  
        }else{
            Swal.fire(
                "Please check terms and condition",
            );
        }

    }

    function changeTitle(roomId, roomItemId, personId){
        for (var i = 0; i < packageData.room.length; i++){
            if(packageData.room[i].id == roomId){
                var roomItem = packageData.room[i].roomItem
                for(var j = 0; j < roomItem.length; j++){
                    if(roomItem[j].id == roomItemId){
                        for(var k = 0; k < roomItem[j].detail_guest.length; k++){
                            if(roomItem[j].detail_guest[k].id == personId){
                                packageData.room[i].roomItem[j].detail_guest[k].title = $(`#sel-${roomId}-${roomItemId}-${personId}`).val()
                            }
                        }
                    }
                }
            }
        }
    }

