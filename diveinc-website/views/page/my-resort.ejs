<script>

    var fileUrl = ""
    var filePath = ""
    var fileBaseUrl = ""

    var listDataResort = []

    $(document).ready(function() {
        loadPermission()

        $(`#customFile`).on(`change`, function(){
          
          $('#sendFile').hide()
          $('#chooseFile').text("Please Wait ...")
          makeFileRequestUpload('/api/upload/file', [], this.files).then((result) => {
              console.log(result)
          }, (error) => {
              console.error(error)
          })
        })

        $(`#customFileReject`).on(`change`, function(){
          
          $('#sendFile').hide()
          $('#chooseFileReject').text("Please Wait ...")
          makeFileRequestUpload('/api/upload/file', [], this.files).then((result) => {
              console.log(result)
          }, (error) => {
              console.error(error)
          })
        })

        $('#sendFile').click(function(){
            vendorRegister()
        })
    })

    function loadPermission() {
        $.ajax({
            url: `/api/my-permission`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    var permission = result.data.profile.permission
                    for(var i = 0; i < permission.length; i++){
                        console.log('permisi',permission[i].status_name);
                        if(permission[i].type == "resort" && permission[i].status_name == "Accessed"){
                            $('#layoutMyResort').show()
                            $('#layoutLoading').hide()
                            getMyResort()
                        }
                        if(permission[i].type == "resort" && permission[i].status_name == "No Access"){
                            $('#layoutRegisterResort').show()
                            $('#layoutLoading').hide()
                        }
                        if(permission[i].type == "resort" && permission[i].status_name == "Request"){
                            $('#layoutWaitResort').show()
                            $('#layoutLoading').hide()
                        }
                        if(permission[i].type == "resort" && permission[i].status_name == "Rejected"){
                            $('#layoutRejectResort').show()
                            $('#layoutLoading').hide()
                        }
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function vendorRegister() {
        $.ajax({
            url: `/api/transaction-creator`,
            method: `POST`,
            data : {
                type : "resort",
                file : {
                    url : fileUrl,
                    baseUrl : fileBaseUrl,
                    path : filePath
                }
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    // alert("Success")
                    // location.reload() 
                    Swal.fire({
                        title: "Your data has been sent",
                        text: "Thank you for registering your resort, we will immediately inform you of the status of your resort."
                    }).then(function() {
                        window.location.reload()
                    });
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function activeResort(resortId, statusPublish){

        if(statusPublish){
            Swal.fire({
                title: "Are you sure?",
                text: "You will unpublish your resort",
                icon: "warning",
                showCancelButton : true,
            }).then(function(isConfirm) {
                console.log(isConfirm)
                if (isConfirm.value) {
                    unpublishResort(resortId)
                } else {
                    swal("Cancelled", "Your data safe :)", "error");
                }
            })
        }else{
            Swal.fire({
                title: "Are you sure?",
                text: "You will publish your resort",
                icon: "warning",
                showCancelButton : true,
            }).then(function(isConfirm) {
                console.log(isConfirm)
                if (isConfirm.value) {
                    publishResort(resortId)
                } else {
                    swal("Cancelled", "Your data safe :)", "error");
                }
            })
        }
    }

    function unpublishResort(resortId){
        $.ajax({
            url: `/api/resort/${resortId}/publish`,
            method: `PUT`,
            data : {
                publish : false
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    Swal.fire({
                        title: "Your resort has been unpublished",
                        text: "Thank you."
                    }).then(function() {
                        window.location.reload()
                    });
                } else {
                    Swal.fire(
                        'Publish Failed',
                        result.message
                    )
                    //alert(result.message)
                    //console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function publishResort(resortId){
        //alert(resortId)
        var canPublish = false
        for(var i = 0; i < listDataResort.length; i++){
            if(listDataResort[i].id == resortId){
                for(var x = 0; x < listDataResort[i].packages.length; x++){
                    if(listDataResort[i].packages[x].publish){
                        canPublish = true
                    }
                }

                for(var x = 0; x < listDataResort[i].rooms.length; x++){
                    if(listDataResort[i].rooms[x].publish){
                        canPublish = true
                    }
                }
            }
        }

        if(canPublish){
            $.ajax({
                url: `/api/resort/${resortId}/publish`,
                method: `PUT`,
                data : {
                    publish : true
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        Swal.fire({
                            title: "Your resort has been active",
                            text: "Thank you for acivating your resort."
                        }).then(function() {
                            window.location.reload()
                        });
                    } else {
                        Swal.fire(
                            'Publish Failed',
                            result.message
                        )
                        //alert(result.message)
                        //console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
        }else{
            Swal.fire(
                'Publish Failed',
                `You can't published resort with empty room or package`
            )
        }
    }

    function getMyResort(){
        // $('#listMyResortEmpty').show();
        $.ajax({
            url: `/api/my-resort`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    listDataResort = result.data
                    $('#totalResort').text(result.data.length)
                    if (result.data.length == 0) {
                        $('#listMyResortEmpty').removeClass('d-none');
                    }
                    for(var i = 0; i < result.data.length; i++){

                        var publish = result.data[i].publish
                        console.log(publish)

                        $('#listMyResortEmpty').hide();
                        $('#listMyResort').append(`
                            <div class="card rounded-0 mb-3 bg-white">
                                <div class="row no-gutters">
                                    <div class="col-md-4">
                                        <div class="card-body">
                                            <span class="badge-photos badge-photos-2 badge badge-dark badge-pill rounded">${result.data[i].photos.length} Photos</span>
                                            <div class="slick rounded">
                                                <div class="glide__slide--photos" style="background-image:url('${result.data[i].photos[0].url}');"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body card-body-flex-y pl-0">
                                            <div class="card-content">
                                                <a href="resort/${result.data[i].id}" class="btn btn-sm btn-secondary text-white mb-2" target="_blank">View Resort</a>
                                                <a href="resort/${result.data[i].id}" target="_blank" class="text-decoration-none">
                                                    <h5 class="m-0 mb-1">${result.data[i].profile.name}</h5>
                                                </a>
                                                <ul class="list-inline list-inline-sm mb-2">
                                                    <li class="list-inline-item">${result.data[i].profile.destination.name}, ${result.data[i].profile.country.name}</li>
                                                    <li class="list-inline-item">Created ${dateFormatMonth(result.data[i].created_at)}</li>
                                                </ul>
                                                <div class="meta-user text-black">
                                                    <div class="meta-user-img" style="background-image: url('../images/user-diveinc.png');"></div>
                                                    <div class="meta-user-detail">
                                                        <h6 class="text-sm mb-0">${result.data[i].profile.name}</h6>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="hide-mobile list-group-custom list-group list-group-horizontal list-group-sm w-100">
                                                
                                                <a href="/my-resort-create/${result.data[i].id}" class="list-group-item pr-3" data-toggle="tooltip" data-placement="top" title="Edit your resort"><i class="fas fa-edit fa-sm mr-2"></i>Edit</a>
                                                <a onClick="activeResort('${result.data[i].id}', ${publish});" type="button" class="list-group-item ${publish ? "text-success" : "text-danger"}" data-toggle="tooltip" data-placement="top" title="Select to publish or unpublish"><i class="fas ${publish ? "fa-toggle-on" : "fa-toggle-off"} fa-sm mr-2"></i>${publish ? "Published" : "Unpublished"}</a>
                                                <a href="my-resort-booking-management?id=${result.data[i].id}" class="list-group-item flex-grow-1 text-center" data-toggle="tooltip" data-placement="top" title="View my booking list"><i class="fas fa-book fa-sm mr-2"></i>Booking</a>
                                            </div>

                                            <div class="view-mobile-only">
                                                
                                                <a href="/my-resort-create/${result.data[i].id}" class="btn btn-block btn-outline-primary pr-3" data-toggle="tooltip" data-placement="top" title="Edit your resort"><i class="fas fa-edit fa-sm mr-2"></i>Edit</a>
                                                <a onClick="activeResort('${result.data[i].id}', ${publish});" type="button" class="btn btn-block btn-outline-primary ${publish ? "text-success" : "text-danger"}" data-toggle="tooltip" data-placement="top" title="Select to publish or unpublish"><i class="fas ${publish ? "fa-toggle-on" : "fa-toggle-off"} fa-sm mr-2"></i>${publish ? "Published" : "Unpublished"}</a>
                                                <a href="my-resort-booking-management?id=${result.data[i].id}" class="btn btn-block btn-outline-primary flex-grow-1 text-center" data-toggle="tooltip" data-placement="top" title="View my booking list"><i class="fas fa-book fa-sm mr-2"></i>Booking</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `)
                        $(function () {
                            $('[data-toggle="tooltip"]').tooltip()
                        })
                    }
                    
                } else {
                    alert(result.message)
                    console.log(result)
                    $('#listMyResortEmpty').show();
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function makeFileRequestUpload(url, params, files){
        return new Promise((resolve, reject) => {

          var formData = new FormData()
          var xhr = new XMLHttpRequest()

          if(files[0].size > 20400000){
            // alert("Size must be less than 20MB")
            Swal.fire(
                'File too large',
                'Please make sure the data to be uploaded is under 20MB.'
            )
          }else{
            formData.append("upload", files[0], files[0].name)

            xhr.onreadystatechange = function() {
                if(xhr.readyState == 4){
                    if(xhr.status == 200){
                      $('#sendFile').show()
                      $('#chooseFile').text(files[0].name)
                      $('#chooseFileReject').text(files[0].name)
                      var response = JSON.parse(xhr.response)
                      fileUrl = response.data.location
                      filePath = response.data.key
                      fileBaseUrl = response.data.baseUrl
                    }else {
                      console.log(xhr.response)
                      $('#chooseFile').text("Choose File")
                    //   alert("Upload file gagal")
                        Swal.fire(
                            'Upload failed',
                            'We apologize in advance for the inconvenience. please try again to upload your data.'
                        )
                    }
                }
            }

            xhr.upload.addEventListener("progress", progressHandlerBackground, false);
            xhr.addEventListener("load", completeHandlerBackground, false);
            xhr.addEventListener("error", errorHandlerBackground, false);
            xhr.addEventListener("abort", abortHandlerBackground, false);

            xhr.open("POST", url, true)

            xhr.send(formData)
          }
        })
      }

