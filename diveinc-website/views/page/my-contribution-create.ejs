    function makeFileRequestUpload6(url, params, files){
        return new Promise((resolve, reject) => {

            var formData = new FormData()
            var xhr = new XMLHttpRequest()

            if(files[0].size > 20400000){
                // alert("Size must be less than 20MB")
                Swal.fire(
                    'File too large',
                    'Please make sure the data to be uploaded is under 20MB.'
                )
            }else{
                formData.append("upload", files[0], files[0].name)

                xhr.onreadystatechange = function() {
                    if(xhr.readyState == 4){
                        if(xhr.status == 200){
                            $('#chooseFile6').text(files[0].name)
                            var response = JSON.parse(xhr.response)
                            fileUrl6 = response.data.location
                            filePath6 = response.data.key
                            fileBaseUrl6 = response.data.baseUrl
                        }else {
                            console.log(xhr.response)
                            $('#chooseFile6').text("Choose File")
                        //   alert("Upload file gagal")
                            Swal.fire(
                                'Upload failed',
                                'We apologize in advance for the inconvenience. please try again to upload your data.'
                            )
                        }
                    }
                }

                xhr.upload.addEventListener("progress", progressHandlerBackground, false);
                xhr.addEventListener("load", completeHandlerBackground, false);
                xhr.addEventListener("error", errorHandlerBackground, false);
                xhr.addEventListener("abort", abortHandlerBackground, false);

                xhr.open("POST", url, true)

                xhr.send(formData)
            }
        })
    }

