                            <div class="col-sm-12">
                                <a onclick="loadDocument()" class="btn btn-outline-primary btn-sm" type="button">See Document</a>
                            </div>
                            <br>
                            <div class="col-sm-12">
                                <div class="custom-file mb-2">
