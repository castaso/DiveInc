<%-include ../partial/footer %>

<script>
    var dataImage = []
    var dataHighlight = []
    var dataNews = [];
    var dataCountry = {}
    var dataDestination = {}

    var fileUrl6 = ""
    var filePath6 = ""
    var fileBaseUrl6 = ""

    var id = "<%= id %>"


    $(document).ready(function(){

        if(id){
            loadContributionById()
        }else{
            getCountry();
        }

        $('#inputCountry').change(function(){
            getDestination()
        })

        $(`#customFile`).on(`change`, function(){
            makeFileRequestUpload('/api/upload/image', [], this.files).then((result) => {
                console.log(result)
            }, (error) => {
                console.error(error)
            })
        });

        $('#customFile6').change(function(){
            $('#chooseFile6').text("Please Wait ...")
            makeFileRequestUpload6('/api/upload/file', [], this.files).then((result) => {
                console.log(result)
            }, (error) => {
                console.error(error)
            })
        })
    });

    function loadContributionById() {
        $.ajax({
            url: `/api/contribution/${id}`,
            method: `GET`,
            success: function (result) {
                // console.log("kaskajsdlaskjdas")
                console.log(result)
                if (result.success) {
                    $('#inputName').val(result.data.profile.name)
                    $('#inputFunds').val(result.data.profile.funds)
                    $('#inputAbout').val(result.data.profile.about)
                    $('#inputAddress').val(result.data.profile.address)

                    statusPublishDivecenter = result.data.publish;
                    dataCountry = result.data.profile.country
                    dataDestination = result.data.profile.destination
                    getCountry()

                    dataImage = result.data.photos
                    loadImage()

                    dataHighlight = result.data.highlight
                    // loadHighlight()
                    loadHighlightItem()

                    dataNews = result.data.news
                    loadNewsItem()

                    fileUrl6 = result.data.documents.url
                    filePath6 = result.data.documents.path
                    fileBaseUrl6 = result.data.documents.baseUrl

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function makeFileRequestUpload(url, params, files){
        $("#listPhotosSpinner").removeClass('d-none');
        return new Promise((resolve, reject) => {

            var formData = new FormData()
            var xhr = new XMLHttpRequest()

            if(files[0].size > 20400000){
            // alert("Size must be less than 20MB")
            Swal.fire(
                'Oops!',
                'The image size must be less than 20 MB.'
            )
            }else{
            formData.append("upload", files[0], files[0].name)

            xhr.onreadystatechange = function() {
                if(xhr.readyState == 4){
                    if(xhr.status == 200){
                        $('#sendFile').show()
                        $('#chooseFile').text(files[0].name)
                        var response = JSON.parse(xhr.response)
                        var objUrl = {}
                        console.log(response)
                        objUrl.id = "image-"+ new Date().getTime()
                        objUrl.url = response.data.location
                        objUrl.path = response.data.key
                        objUrl.baseUrl = response.data.baseUrl
                        dataImage.push(objUrl)
                        loadImage()
                    }else {
                        console.log(xhr.response)
                        $('#chooseFile').text("Choose File")
                        alert("Upload file gagal")
                    }
                }
            }

            xhr.upload.addEventListener("progress", progressHandlerBackground, false);
            xhr.addEventListener("load", completeHandlerBackground, false);
            xhr.addEventListener("error", errorHandlerBackground, false);
            xhr.addEventListener("abort", abortHandlerBackground, false);

            xhr.open("POST", url, true)

            xhr.send(formData)
            }
        })
    }

    function progressHandlerBackground(event) {
        // var percent = (event.loaded / event.total) * 100
        // $("#progressBackground").val(Math.round(percent))
        // if(percent == 100){
        //     $("#statusBackground").text("Upload Success")
        // }else{
        //     $("#statusBackground").text(Math.round(percent) + "% uploaded... please wait")
        // }
    }

    function completeHandlerBackground(event) {
        //$("#progressBackground").val(0) //wil clear progress bar after successful upload
    }

    function errorHandlerBackground(event) {
        //$("#statusBackground").text("Upload Failed")
    }

    function abortHandlerBackground(event) {
        //$("#statusBackground").text("Upload Aborted")
    }


    function loadImage(){
        console.log(dataImage)
        $(`.data-photos`).remove()
        for(var i = 0; i < dataImage.length; i++){
            $(`#listPhotosSpinner`).before(`
                <div class="photo-gallery--item data-photos" style="background-image:url('${dataImage[i].url}');"><div onClick="deleteImage('${dataImage[i].id}')" class="btn btn-white btn-sm"> <i class="fas fa-times"></i></div></div>
            `).fadeIn('slow')
        }
        $("#listPhotosSpinner").addClass('d-none');

    }

    function deleteImage(id){
        dataImage = dataImage.filter(function( obj ) {
            return obj.id !== id
        })
        loadImage()
    }

    //========================================highlight======================================

        function addHighlightItem(){
            var objHighlight = {}
            objHighlight.id = "Highlight-"+new Date().getTime().toString()
            objHighlight.highlight = ''
            dataHighlight.push(objHighlight);
            console.log()
            $(`#listHighlightModal`).append(`
                    <div class="d-block p-2 border mb-2 bg-lighter data-highlight" id="div-${objHighlight.id}">
                        <div class="d-flex">
                            <div class="mr-2 flex-grow-1">
                                <div class="form-row">
                                    <div class="col-md-12">
                                        <textarea id="${objHighlight.id}" rows='2' maxlength='140' class="form-control"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="btn-group" role="group" aria-label="Basic example">
                                    <button onClick="deleteHighlight('${objHighlight.id}')" type="button" class="btn btn-outline-dark"><i class="far fa-trash-alt fa-sm"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).fadeIn('slow');
                $(`#${objHighlight.id}`).focus();
            
                console.log(dataHighlight);
            // loadHighlight()
        }

        function loadHighlightItem(){
            $(`#listHighlight`).html('');
            for(var i = 0; i < dataHighlight.length; i++){
                $("#listHighlight").append(`<li class="mb-3">
                    ${dataHighlight[i].highlight}
                    </li>`);
            }
        
        }

        function loadHighlight(){
            //console.log(dataHighlight)
            $(`.data-highlight`).remove()
            for(var i = 0; i < dataHighlight.length; i++){
                $('#listHighlightModal').append(`
                    <div class="d-block p-2 border mb-2 bg-lighter data-highlight" id="div-${dataHighlight[i].id}">
                        <div class="d-flex">
                            <div class="mr-2 flex-grow-1">
                                <div class="form-row">
                                    <div class="col-md-12">
                                        <textarea id="${dataHighlight[i].id}" rows='2' maxlength='140' class="form-control">${dataHighlight[i].highlight}</textarea>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="btn-group" role="group" aria-label="Basic example">
                                    <button onClick="deleteHighlight('${dataHighlight[i].id}')" type="button" class="btn btn-outline-dark"><i class="far fa-trash-alt fa-sm"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                `)
            }
        }

        function deleteHighlight(id){
            dataHighlight = dataHighlight.filter(function( obj ) {
                return obj.id !== id
            })
            $(`#div-${id}`).remove();
            // loadHighlight()
        }

        function populateHighlight(){
            let result = true;
            for (let i = 0; i < dataHighlight.length; i++) {
                console.log(dataHighlight[i].id);
                dataHighlight[i].highlight = $(`#${dataHighlight[i].id}`).val();
                if(dataHighlight[i].highlight.length == 0){
                    result = false;
                }
            }

            if (!result) {
                return Swal.fire("Highlight Note", "Highlight can't be blank");
            }else{
                loadHighlightItem();
                $("#modalSetHighlight").modal('toggle');
            }
        }
    
    //========================================news======================================

        function addNewsItem(){
            var tgl = new Date();
            var objNews = {}
            var bulan = parseInt(tgl.getMonth())+1;
            objNews.id = "News-"+new Date().getTime().toString()
            objNews.date = tgl.getFullYear()+'-'+bulan.toString().padStart(2,'0')+'-'+tgl.getDate();
            objNews.news = ''
            dataNews.push(objNews);
            console.log()
            $(`#listNewsModal`).append(`
                    <div class="d-block p-2 border mb-2 bg-lighter data-news" id="div-${objNews.id}">
                        <div class="d-flex">
                            <div class="mr-2 flex-grow-1">
                                <div class="form-row">
                                    <div class="col-md-12 pl-3 pb-2">
                                        ${dateFormatMonth(dataNews[i].date)}
                                    </div>
                                    <div class="col-md-12">
                                        <textarea id="${objNews.id}" rows='4' maxlength='2000' class="form-control"></textarea>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="btn-group" role="group" aria-label="Basic example">
                                    <button onClick="deleteNews('${objNews.id}')" type="button" class="btn btn-outline-dark"><i class="far fa-trash-alt fa-sm"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).fadeIn('slow');
                $(`#${objNews.id}`).focus();
            
                console.log(dataNews);
            // loadNews()
        }

        function loadNewsItem(){
            $(`#listNews`).html('');
            for(var i = 0; i < dataNews.length; i++){
                $("#listNews").append(`<div class="itenary-listing--item data-itenary">
                        <div class="itenary-wrapper">
                            <div class="itenary-title font-weight-bold">${dateFormatMonth(dataNews[i].date)}<i class="fas fa-angle-down ml-2 active"></i></div>
                            <div class="itenary-content active">
                                ${dataNews[i].news}
                            </div>
                        </div>
                    </div>`);
            }
        
        }

        function loadNews(){
            //console.log(dataNews)
            $(`.data-news`).remove()
            for(var i = 0; i < dataNews.length; i++){
                $('#listNewsModal').append(`
                    <div class="d-block p-2 border mb-2 bg-lighter data-news" id="div-${dataNews[i].id}">
                        <div class="d-flex">
                            <div class="mr-2 flex-grow-1">
                                <div class="form-row">
                                    <div class="col-md-12 pl-3 pb-2">
                                        ${dateFormatMonth(dataNews[i].date)}
                                    </div>
                                    <div class="col-md-12">
                                        <textarea id="${dataNews[i].id}" rows='4' maxlength='2000' class="form-control">${dataNews[i].news}</textarea>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="btn-group" role="group" aria-label="Basic example">
                                    <button onClick="deleteNews('${dataNews[i].id}')" type="button" class="btn btn-outline-dark"><i class="far fa-trash-alt fa-sm"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                `)
            }
        }

        function deleteNews(id){
            dataNews = dataNews.filter(function( obj ) {
                return obj.id !== id
            })
            $(`#div-${id}`).remove();
            // loadNews()
        }

        function populateNews(){
            let result = true;
            for (let i = 0; i < dataNews.length; i++) {
                console.log(dataNews[i].id);
                dataNews[i].news = $(`#${dataNews[i].id}`).val();
                if(dataNews[i].news.length == 0){
                    result = false;
                }
            }

            if (!result) {
                return Swal.fire("News Note", "News can't be blank");
            }else{
                loadNewsItem();
                $("#modalSetNews").modal('toggle');
            }
        }

    //=================================================================================

    function saveDraft() {
        //alert("hai")
        $('.saveDraftBtn').hide();
        $('.saveDraftLoading').show();
        let listIncomplete = formValidate();
        if(listIncomplete.length > 0){
            // return alert("form is not valid")
            $('.saveDraftBtn').show();
            $('.saveDraftLoading').hide();
            $('.savePublishBtn').show();
            $('.savePublishLoading').hide();
            return Swal.fire(
                'Oops!',
                `Please complete all forms to get to the next step.
                <ul style='padding-left:20px'>
                </ul>
                `
            )
        }else{
            
            if(id){
                $.ajax({
                    url: `/api/contribution/${id}`,
                    method: `PUT`,
                    data: {
                        publish : false,
                        profile : {
                            name : $('#inputName').val(),
                            address : $('#inputAddress').val(),
                            country : {
                                id : $('#inputCountry').val(),
                                name : $('#inputCountry option:selected').text()
                            },
                            destination : {
                                id : $('#inputDestination').val(),
                                name : $('#inputDestination option:selected').text()
