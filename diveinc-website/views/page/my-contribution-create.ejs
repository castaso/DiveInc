    function getCountry() {
        $("#overlay-loader").removeClass('d-none');
        $.ajax({
            url: `/api/country`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    for(var i = 0; i < result.data.length; i++){
                        var selected = ""
                        if(dataCountry){
                            if(dataCountry.id == result.data[i].id){
                                selected = "selected"
                            }
                        }
                        $('#inputCountry').append(`
                            <option ${selected} value="${result.data[i].id}">${result.data[i].name}</option>
                        `)
                        if(dataCountry){
                            getDestination()
                        }
                    } 
                    $("#overlay-loader").addClass('d-none');
                } else {
                    alert(result.message)
                    console.log(result)
                    $("#overlay-loader").addClass('d-none');
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }


