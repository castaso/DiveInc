<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<style>
    .passwordInputIcon{
        position: absolute;
        top: 50px;
        right: 30px;
        cursor: pointer;
        color: #666;
        font-size: 16px;
    }

    #passwordNotification{
        font-size: 12px;
        font-style: italic;
        color: red;
    }
</style>
<div class="header-spacer"></div>
<section class="section section-sm bg-lighter min-100-y">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="d-block w-100 text-center mb-4">
                    <h4 class="m-0">Sign Up</h4>
                </div>
                <!-- <div class="card shadow-sm border-0 rounded-0 mb-3">
                    <div class="card-body">
                        <button type="button" class="btn btn-neutral btn-block btn-lg btn-flex justify-content-center mb-2"><img src="images/google.svg" width="20" class="mr-2">Signup with Google</button>
                        <button type="button" class="btn btn-facebook btn-block btn-lg btn-flex justify-content-center"><img src="images/facebook.svg" width="20" class="mr-2">Signup with Facebook</button>
                    </div>
                </div>
                <div class="separator-with-text on-bg-lighter"><span>or</span></div> -->
                <div class="card shadow-sm border-0 rounded-0">
                    <div class="card-header">
                        Sign up with email
                    </div>
                    <div class="card-body">
                        <!-- <form> -->
                            <div class="form-row">
                                <div class="col-md-12 mb-4">
                                    <label for="email_address">Email Address</label>
                                    <input id="inputEmail" type="email" class="form-control form-control-lg rounded-0" name="email_address" placeholder="your.email@mail.com"  required>
                                </div>
                                <div class="col-md-12 mb-4">
                                    <label for="password">Password</label>
                                    <input id="inputPassword" type="password" class="form-control form-control-lg rounded-0" name="passwrod" placeholder="Enter your password"  required>
                                    <span class="passwordInputIcon" id="inputPasswordIcon" onmousedown="typeText('inputPassword')" onmouseup="typePassword('inputPassword')"><i class="fas fa-eye-slash"></i></span>
                                    <small id='passwordNotification'></small>
                                </div>
                                <div class="col-md-12 mb-4">
                                    <label for="re_password">Re-Password</label>
                                    <input id="inputRePassword" type="password" class="form-control form-control-lg rounded-0" name="re_passwrod" placeholder="Re-enter your password"  required>
                                    <span class="passwordInputIcon" id="inputRePasswordIcon" onmousedown="typeText('inputRePassword')" onmouseup="typePassword('inputRePassword')"><i class="fas fa-eye-slash"></i></span>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <div class="d-block">Would you like to receive further updates about Dive?</div>
                                    <div class="select-card-wrapper">
                                        <div class="select-card select-card-inherit select-card-naked select-card-inline">
                                            <label class="select-card-inner select-card-inner-h">
                                                <input id="inputSubscribe" type="checkbox" name="dive-email-update"/>
                                                <div class="select-card-content">
                                                    <h6 class="mb-0 font-weight-normal">Yes please!</h6>
                                                </div>
                                                <div class="select-card-checkbox"></div>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <button id="buttonRegister" class="btn btn-outline-primary btn-lg-2 btn-block" type="submit">Sign Up</button>
                        <!-- </form> -->
                    </div>
                </div>
                <div class="d-block w-100 text-sm text-center text-muted mt-3 mb-2">
                    By clicking "Sign Up" you agree with Dive Inc's <a href="terms-conditions" target="_blank">Terms & Conditions</a> and Dive Inc's <a href="privacy-policy" target="_blank">Privacy Policy.</a>
                </div>
                <div class="d-block w-100 text-center text-muted mb-3">
                    Already have an account? <a href="signin">Sign in</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FOOTER -->
<%-include ../partial/footer %>
<script>

    $(document).ready(function(){
        $('#buttonRegister').click(function(){
            register()
        })

        $("#inputEmail").change(function(){
            if (!validateEmail($('#inputEmail').val())) {
                return Swal.fire(
                        "Invalid Email Address",
                    ).then(function(){
                        $('#inputEmail').focus()
                    });
            }
        })
    })

    function checkRegister(){
        if($('#inputEmail').val().length > 0 && $('#inputPassword').val().length > 0 && $('#inputRePassword').val().length > 0) return true
        
        return false
    }

    function checkPassword(){
        if($('#inputPassword').val() != $('#inputRePassword').val()) return false
        return true
    }

    function checkPasswordChar(){
        let pass = $('#inputPassword').val();
        // console.log(pass.length)
        // console.log(pass.toLowerCase === pass, pass.toLowerCase() +'==='+ pass)
        // console.log(pass.toUpperCase === pass, pass.toUpperCase() +'==='+ pass)
        // console.log(/\d/.test(pass))
        // console.log(/^\d+$/.test(pass))
        // console.log(pass.replace(/[0-9]/g, ''))
        // $("#passwordNotification").html("");
        let cekLetter = pass.replace(/[0-9]/g, '');
        if(pass.length < 8){
            $("#passwordNotification").html("*Minimum password is 8 characters long");
            return false
        }else if(cekLetter.length == 1){
            $("#passwordNotification").html("*Password must contain both numbers and letters");
            return false
        }else if(/^\d+$/.test(pass)){
            $("#passwordNotification").text("*Password must contain letters");
            return false
        }else if(/\d/.test(pass) == false){
            $("#passwordNotification").text("*Password must contain a number");
            return false
        }else if (pass.toLowerCase() === pass) {
            $("#passwordNotification").html("*Password must contain a uppercase letter");
            return false
        }else if(pass.toUpperCase() === pass){
            $("#passwordNotification").text("*Password must contain an lowercase letter");
            return false
        }else{
            return true;
        }
        
    }

    function register(){
        if (!validateEmail($('#inputEmail').val())) {
            return Swal.fire(
                    "Invalid Email Address",
                ).then(function(){
                    $('#inputEmail').focus()
                });
        }
        if(checkRegister()){
            if (checkPasswordChar()) {
                if(checkPassword()){
                    $.ajax({
                        url: `/api/register/email`,
                        method: `POST`,
                        data : {
                            email : $('#inputEmail').val(),
                            password : $('#inputPassword').val(),
                            subscribe : $('#inputSubscribe')[0].checked
                        },
                        success: function (result) {
                            if (result.success) {
                                // alert(result.message)
                                // location.href = '/signin'
                                Swal.fire({
                                    title: "Welcome to Dive Inc!",
                                    text: "Your account has been successfully registered."
                                }).then(function() {
                                    window.location.href = '/signin'
                                });
                            } else {
                                // alert(result.message)
                                // console.log(result)
                                Swal.fire({
                                    title: "Oops something went wrong",
                                    text: "We're sorry for this inconvenience. Please try again by reload this page."
                                })
                            }
                        },
                        error(xhr, status, error) {
                            if(xhr.responseJSON){
                                console.log(xhr.responseJSON)
                            }
                        }
                    })
                }else{
                    // alert("Password validation error")
                    Swal.fire({
                        title: "Oops!",
                        text: "Your passwords do not match. Please make sure your password is written correctly."
                    });
                } 
            }
        }else{
            // alert("Form validation error")
            Swal.fire({
                title: "Please fill the form",
                text: "To finish creating your account, please fill all the requirement forms."
            });
        }
    }

    function typeText(idName){
        $(`#${idName}`).attr('type','text');
        $(`#${idName}Icon`).html(`<i class="fas fa-eye"></i>`);
    }
    function typePassword(idName){
        $(`#${idName}`).attr('type','password');
        $(`#${idName}Icon`).html(`<i class="fas fa-eye-slash"></i>`);
    }

</script>