    function checkOutDivecenter(){
        if(listPackageChooseSummary.length > 0){
            $("#overlay-checkout").removeClass('d-none');
            $.ajax({
                url: `/api/transaction-divecenter`,
                method: `POST`,
                data : {
                    divecenter_id : id,
                    package_data : {
                        package : listPackageChooseSummary
                    }
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        location.href = `/checkout-divecenter/${result.data.id}/schedule`
                    } else {
                        alert(result.message)
                        console.log(result)
                        $("#overlay-checkout").addClass('d-none');
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }

                    if (xhr.responseJSON.message == 'Token is required') {
                        $("#overlay-checkout").addClass('d-none');
                        loginRequired();
                    }
                }
            })
        }else{
            // alert('You must choose room or package')
            Swal.fire(
                "First choose your room or package",
                "Don't forget to also add guests to your trip!"
            )
        }
    }

    function loadPackageDetails(i, packageId){
        let packData = listPackage[i];
        $('#packageName').html(packData.info.name);
        $('#packageDescription').html(packData.info.description);
        $('#packageHighlight').html('');
        $('#packageBegining').html('');
        $('#packageDuring').html('');
        $('#packageEnd').html('');
        $('#packageOtherInfo').html('');
        $('#packageGTK').html('');
        $('#packageIncluded').html('');
        $('#packageExcluded').html('');
        
        for (let j = 0; j < packData.highlight.length; j++) {
            $('#packageHighlight').append(`<li>${packData.highlight[j].text}</li>`);
        }

        $('#packageItenary').html('');
        for (let j = 0; j < packData.itenary.length; j++) {
            $('#packageItenary').append(`<div class="itenary-listing--item">
                            <div class="itenary-wrapper">
                                <div class="itenary-title font-weight-bold">Day ${j+1}<i class="fas fa-angle-down ml-2 active"></i></div>
                                <div class="itenary-content active">
                                    ${packData.itenary[j].text}
                                </div>
                            </div>
                        </div>`);
            
        }

        let howTo = packData.info.how_to;
        $('#packageBegining').append(`${howTo.begining}`);
        $('#packageDuring').append(`${howTo.during}`);
        $('#packageEnd').append(`${howTo.trip}`);
        $('#packageOtherInfo').append(`${(typeof howTo.otherInfo !== 'undefined' ? howTo.otherInfo : '')}`);
        $('#packageGTK').append(`${howTo.gtk}`);
        let feature = packData.info.feature;
        if (typeof feature !== 'undefined') {
            for (let j = 0; j < feature.included.length; j++) {
                $('#packageIncluded').append(`<li>${feature.included[j].text}</li>`);
            }

            for (let j = 0; j < feature.excluded.length; j++) {
                $('#packageExcluded').append(`<li>${feature.excluded[j].text}</li>`);
            }
        }

        let point = document.getElementById("modalPackageSelect");
        point.addEventListener("click", function(){
            addPackage(`${packageId}`);
        });
    };

</script>