    function getIdeal(){
        $.ajax({
            url: `/api/ideal`,
            method: `GET`,
            success: function (result) {
                //console.log(result)
                if (result.success) {
                    $('#idealLoader').addClass('hideImportant');
                    //location.href = `/checkout-resort/${result.data.id}/schedule`
                    for(var i = 0; i < result.data.length; i++){
                        if(ideal.includes(result.data[i].id)){
                            if(result.data[i].name == "Single"){
                                $('#listIdeal').append(`
                                    <div class="ideal-for-item">
                                        <div class="ideal-for-item--inner">
                                            <img src="/images/dive-illustration/icon-ideal-single.svg">
                                            Single
                                        </div>
                                    </div>
                                `)
                            }

                            if(result.data[i].name == "Couple"){
                                $('#listIdeal').append(`
                                    <div class="ideal-for-item">
                                        <div class="ideal-for-item--inner">
                                            <img src="/images/dive-illustration/icon-ideal-couple.svg">
                                            Couple
                                        </div>
                                    </div>
                                `)
                            }

                            if(result.data[i].name == "Family"){
                                $('#listIdeal').append(`
                                    <div class="ideal-for-item">
                                        <div class="ideal-for-item--inner">
                                            <img src="/images/dive-illustration/icon-ideal-family.svg">
                                            Family
                                        </div>
                                    </div>
                                `)
                            }

                            if(result.data[i].name == "Group"){
                                $('#listIdeal').append(`
                                    <div class="ideal-for-item">
                                        <div class="ideal-for-item--inner">
                                            <img src="/images/dive-illustration/icon-ideal-group.svg">
                                            Group
                                        </div>
                                    </div>
                                `)
                            }
                        }
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function addPackage(packageId){
        var newData = true
        var packageName = ""
        var packagePrice = ""

        for(var i = 0; i < listPackage.length; i++){
            if(listPackage[i].id == packageId){
                packageName = listPackage[i].info.name
                if(listPackage[i].price.discount != "" && listPackage[i].price.discount != "0" && listPackage[i].price.discount != 0 && listPackage[i].price.discount != "NaN"){
                    packagePrice = listPackage[i].price.discount
                }else{
                    packagePrice = listPackage[i].price.price
                }
            }
        }

        for(var i = 0; i < listPackageChoose.length; i++){
            if(listPackageChoose[i].id == packageId){
                newData = false
            }
        }

        if(newData){
            listPackageChoose.push({
                id : packageId,
                packageName : packageName,
                packageItem : [
                    {
                        id : "packageitem-" + new Date().getTime(),
                        guest : 1
                    }
                ],
                packagePrice : packagePrice
            })
        }

        loadModalPackage(packageId)
    }

    function addAnotherPackage(packageId){

        var maxPackage = "";
        
        for(var i = 0; i < listPackage.length; i++){
            if(listPackage[i].id == packageId){
                maxPackage = listPackage[i].info.max_purchase
            }
        }
        
        let rItem = [];
        for(var i = 0; i < listPackageChoose.length; i++){
            if(listPackageChoose[i].id == packageId){
                for(var j = 0; j < listPackageChoose[i].packageItem.length; j++){
                    rItem.push({...listPackageChoose[i].packageItem[j]});
                }

                // console.log('rip',rItem);
                for(var j = 0; j < rItem.length; j++){
                    if(rItem.length - 1 == j){
                        if(maxPackage > rItem.length){
                            rItem.push(
                                {
                                    id : "packageitem-" + new Date().getTime(),
                                    guest : 1
                                }
                            )
                        }else{
                            console.log(maxPackage)
                            console.log(listPackageChoose[i].packageItem.length)
                            Swal.fire("We're sorry","Max package purchase is reached");
                        }
                        
                        break
                    }
                }
                
                listPackageChoose[i].packageItem = [];
                for (let m = 0; m < rItem.length; m++) {
                    listPackageChoose[i].packageItem.push({...rItem[m]});
                }
            } 
        }

        if(listPackageChoose.length == 0){
            addPackage(packageId);
        }        
        loadModalPackage(packageId)
    }

