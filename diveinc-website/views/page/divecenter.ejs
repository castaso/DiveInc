    function loadDiveCenterById(){
        $.ajax({
            url: `/api/divecenter/${id}`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if(result.success){
                    var detailLocation = `${result.data.profile.sub_destination.name}, ${result.data.profile.destination.name} - ${result.data.profile.country.name}`

                    $('#highlightLoader').addClass('hideImportant');
                    $('#textLocation').text(`${result.data.profile.destination.name} - ${result.data.profile.sub_destination.name}`)
                    $('.divecenterName').text(`${result.data.profile.name}`)
                    $('#textAbout').text(`${result.data.profile.introduction}`)
                    $('#about').append(`<p class="font-serif text-justify">${result.data.profile.introduction}</p>`)

                    highlight = result.data.highlight
                    ideal = result.data.profile.ideal

                    $('#imageBackground').css("background-image", `url('${result.data.photos[0].url}')`)

                    for(var i = 0; i < highlight.length; i++){
                        $('#listHighlight').append(`
                            <li>${highlight[i].highlight}</li>
                        `)
                    }

                    for(var i = 0; i < result.data.photos.length; i++){
                        $('#lightgallery').append(`
                            <div data-src="${result.data.photos[i].url}" class="gallery-item" style="background-image: url('${result.data.photos[i].url}');"><div>View Picture<img src="${result.data.photos[i].url}"/></div></div>
                        `)
                    }

                    $('#lightgallery').lightGallery({
                        selector: '.gallery-item',
                        download: false,
                        thumbnail: true
                    });

                    listPackage = result.data.packages
                        for(var i = 0; i < listPackage.length; i++){
                            if (listPackage[i].active == true && listPackage[i].publish == true) {

                                var htmlPhotos = ``
                                var dataPhotos = listPackage[i].photos
                                for(var j = 0; j < dataPhotos.length; j++){
                                    htmlPhotos += `
                                        <div class="glide__slide--photos" style="background-image: url('${dataPhotos[j].url}');">
                                        </div>
                                    `
                                }

                                var htmlPrice = ''
                                if(listPackage[i].price.discount != "" && listPackage[i].price.discount != "0" && listPackage[i].price.discount != 0 && listPackage[i].price.discount != "NaN" ) {
                                    htmlPrice = `
                                        <h5 class="m-0 normal-price discounted" class="">IDR ${formatRupiah(listPackage[i].price.price)}</h5>
                                        <h4 class="m-0">IDR ${formatRupiah(listPackage[i].price.discount)}</h4>
                                    `
                                }else{
                                    htmlPrice = `<h4 class="m-0">IDR ${formatRupiah(listPackage[i].price.price)}</h4>`
                                }
                                
                                $('#listPackage').append(`
                                    <div class="explore-card--item">
                                    <div class="explore-card--content shadow-sm">
                                        <div class="d-block">
                                            <span class="badge-photos badge badge-dark badge-pill rounded">${dataPhotos.length} photos</span>
                                            <div class="slick">
                                                ${htmlPhotos}
                                            </div>
                                        </div>
                                        <div class="explore-card--details">
                                            <h4>${listPackage[i].info.name}</h4>
                                            <p class="text-sm mb-1">${(typeof listPackage[i].info.description !== 'undefined' ? listPackage[i].info.description : '-')}</p>
                                            <div class="d-flex align-items-start border-top pt-3 mt-2 mb-3">
                                                <div class="details-price details-price-lg mr-4">
                                                    <div class="d-block mb-1 text-xs">Price</div><span class="price">${htmlPrice}</span>
                                                    <div class="text-sm text-muted">Per person</div>
                                                </div>
                                                <div class="details-price">
                                                    <div class="d-block mb-2 text-xs">Duration</div>
                                                    <span class="date d-block font-weight-semibold">${listPackage[i].info.duration.day} Days ${listPackage[i].info.duration.night} Night</span>
                                                </div>
                                            </div>
                                            <div class="d-block">
                                                <small class="d-block text-ellipsis"><i class="fas fa-map-marker-alt fas-fix mr-1 text-secondary"></i>${detailLocation}</small>
                                                <small class="d-block"><i class="fas fa-swimmer fas-fix mr-1 text-secondary"></i>${listPackage[i].info.dive_total} dives</small>
                                            </div>
                                        </div>
                                        <div class="explore-card--footer flex-column align-items-center">
                                            <button onClick="addPackage('${listPackage[i].id}')"  type="button" class="btn btn-outline-primary mb-2 btn-block" data-toggle="modal" data-target="#modalPackageGuest"><i class="fas fa-plus mr-2"></i>Add to My Trip</button>
                                            <a data-toggle="modal" data-index="${i}" onclick="loadPackageDetails('${i}','${listPackage[i].id}')" data-target="#modalPackageDetails" class="py-2 link">Package Details</a>
                                        </div>
                                    </div>
