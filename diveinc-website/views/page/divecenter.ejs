        for(var i = 0; i < listPackage.length; i++){
            if(listPackage[i].id == packageId){
                maxPackage = listPackage[i].info.max_purchase
            }
        }
        
        for(var i = 0; i < listPackageChoose.length; i++){
            if(listPackageChoose[i].id == packageId){
                var packageItem = listPackageChoose[i].packageItem
                for(var j = 0; j < packageItem.length; j++){
                    // console.log(packageItem[j].id,buttonId);
                    if(packageItem[j].id == buttonId){
                        if(listPackageChoose[i].packageItem[j].guest < maxPackage){
                            // console.log(listPackageChoose[i].packageItem[j].guest);
                            let guest = parseInt(listPackageChoose[i].packageItem[j].guest)+1
                            $(`#text-${buttonId}`).val(guest)
                            $(`#span-${buttonId}`).text(guest)
                            listPackageChoose[i].packageItem[j].guest = guest;
                        }else{
                            alert("Max person in package")
                        }
                    }
                }
            }
        }
    }

    function addPackageToMyTrip(packageId){
        var isAvailable = false
        for(var i = 0; i < listPackageChooseSummary.length; i++){
            if(listPackageChooseSummary[i].id == packageId){
                isAvailable = true
                listPackageChooseSummary[i] = {...listPackageChoose[i]}
                listPackageChooseSummary[i].packageItem = [];
                for (let j = 0; j < listPackageChoose[i].packageItem.length; j++) {
                    listPackageChooseSummary[i].packageItem[j] = {...listPackageChoose[i].packageItem[j]};
                }
            }
        }
        if(!isAvailable){
            for(var i = 0; i < listPackageChoose.length; i++){
                if(listPackageChoose[i].id == packageId){
                    listPackageChooseSummary.push({...listPackageChoose[i]})
                    listPackageChooseSummary[i].packageItem = [];
                    for (let j = 0; j < listPackageChoose[i].packageItem.length; j++) {
                        listPackageChooseSummary[i].packageItem[j] = {...listPackageChoose[i].packageItem[j]};
                    }
                }
            }
        }

        rekapPackageSummary();
        loadMySummary()
    }

