    function formValidate(){
        $(document).find(".text-field-warning").remove();
        let listIncomplete = [];

        ($('#inputName').val().length < 3 ? listIncomplete.push({inputId:"inputName", message: "Name is too short" }) : '' );
        ($('#inputDescription').val().length < 3 ? listIncomplete.push({inputId:"inputDescription", message: "Description is too short" }) : '' );
        ($('#inputDay').val().length == 0 ? listIncomplete.push({inputId:"inputDay", message: "Day can't be blank" }) : '' );
        ($('#inputNight').val().length == 0 ? listIncomplete.push({inputId:"inputNight", message: "Night can't be blank" }) : '' );
        ($('#inputPrice').val().length == 0 || parseFloat($('#inputPrice').val()) < 0 ? listIncomplete.push({inputId:"inputPrice", message: "Room Price can't be blank / less than 0" }) : '' );
        (parseFloat($('#inputDiscount').val()) < 0 || parseFloat($('#inputDiscount').val()) > parseFloat($('#inputPrice').val()) ? listIncomplete.push({inputId:"inputDiscount", message: "Discount can't less than 0 / greater than actual price" }) : '' );
        ($('#inputDiveTotal').val().length == 0 || parseFloat($('#inputDiveTotal').val()) < 0 ? listIncomplete.push({inputId:"inputDiveTotal", message: "Dive Total can't be blank/less than 0" }) : '' );
        ($('#inputMaxPurchase').val().length == 0 || parseFloat($('#inputMaxPurchase').val()) < 0 ? listIncomplete.push({inputId:"inputMaxPurchase", message: "Max Purchase can't be blank/less than 0" }) : '' );
        // (dataItenary.length == 0 ? listIncomplete.push({inputId:"listItenary2", message: "Please write this package itenary" }) : '' );
        
        showIncompleteFieldMessage(listIncomplete);
        return listIncomplete;
        
        
        // $('#inputName').val().length < 3 ||
        //     $('#inputDay').val() == "" ||
        //     $('#inputNight').val() == "" ||
        //     $('#inputDiveTotal').val() == "" ||
        //     $('#inputDescription').val().length < 3 ||
        //     $('#inputPrice').val() == "" ||
        //     dataImage.length == 0
    }

    function showIncompleteFieldMessage(listIncomplete){
        let earliestInput = "";
        $.each(listIncomplete,function(i,v){
            earliestInput = (i==0 ? v.inputId : earliestInput);
            if(!$(`#${v.inputId}`).parent().hasClass("input-group")){
                $(`#${v.inputId}`).parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
            }else{
                $(`#${v.inputId}`).parent().parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
            }
        });

        let el = document.getElementById(`${earliestInput}`);
        (earliestInput != '' ? el.scrollIntoView() : '');
    }

