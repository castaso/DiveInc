                                hPack.push(totalNonAktif[i].nama);
                            }
                        }
    
                        html += `This liveaboard still have closed cabin/package, are you sure want to publish ? 
                        ${(hRoom.length > 0 ? "<br/><b>Room : </b>"+hRoom.join(', ') : '')}
                        ${(hPack.length > 0 ? "<br/><b>Package : </b>"+hPack.join(', ') : '')}`
                        
                        Swal.fire({
                            title: "Reminder",
                            html: html,
                            icon: "warning",
                            confirmButtonText: 'Yes',
                            showCancelButton : true,
                        }).then(function(isConfirm) {
                            if (isConfirm.value) {
