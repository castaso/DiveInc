                                <div class="col-sm-10">
                                    <input id="inputName" type="text" class="form-control rounded-0 text-capitalize" name="boat_name" placeholder="Boat name" required>
                                </div>
                            </div>
                            <div class="form-row mb-3">
                                <label for="liveaboards_origin" class="col-sm-2 col-form-label">Country & City<span class="required text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <div class="input-group input-group-mobile  ">
                                        <select id="inputCountry" class="form-control rounded-0 mb-2 mb-md-0">
                                            <option value="">Select Country</option>
                                        </select>
                                        <select id="inputDestination" class="form-control rounded-0 mb-2 mb-md-0">
                                            <option value="">Select Destination</option>
                                        </select>
                                        <select id="inputSubDestination" class="form-control rounded-0">
                                            <option value="">Select Sub Destination</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row mb-3">
                                <label for="liveaboard_introduction" class="col-sm-2 col-form-label">Liveaboard Introduction<span class="required text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <textarea id="inputIntroduction" class="summernoteData"></textarea>
                                    <div class="alert alert-info border-0 mt-2 mb-0 text-sm"><div class="d-flex"><div class="mr-2"><i class="fas fa-info-circle"></i></div><div>Writes your liveaboard introduction in 400 characters. Your guest will read this first when opening your page.</div></div></div>
                                </div>
                            </div>
                            <div class="form-row mb-3">
                                <label for="boat_description" class="col-sm-2 col-form-label">About Your Boat<span class="required text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <textarea id="inputAbout" class="summernoteData"></textarea>
                                    <div class="alert alert-info border-0 mt-2 mb-0 text-sm"><div class="d-flex"><div class="mr-2"><i class="fas fa-info-circle"></i></div><div>Writes your boat about in 800 characters. Tell your guest about your liveaboard</div></div></div>
                                </div>
                            </div>
                            <div class="form-row mb-3">
                                <label for="boat_size" class="col-sm-2 col-form-label">Boat Size<span class="required text-danger">*</span></label>
                                <div class="col-sm-10">
                                    <div class="row">
                                        <div class="col-md-6 mb-2 mb-md-0">
                                            <div class="input-group">
                                                <input id="inputWidth" type="number" min="0" class="form-control" placeholder="Boath width">
                                                <div class="input-group-append">
                                                    <span class="input-group-text" id="basic-addon2">meter</span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="input-group">
                                                <input id="inputLength" type="number" min="0" class="form-control" placeholder="Boat length">
                                                <div class="input-group-append">
                                                    <span class="input-group-text" id="basic-addon2">meter</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="form-row mb-3">
