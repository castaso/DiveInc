                    for(var i = 0; i < result.data.length; i++){
                        var selected = ""
                        if(dataCountry){
                            if(dataCountry.id == result.data[i].id){
                                selected = "selected"
                            }
                        }
                        $('#inputCountry').append(`
                            <option ${selected} value="${result.data[i].id}">${result.data[i].name}</option>
                        `)
                        if(dataCountry){
                            getDestination()
                        }
                    } 
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
