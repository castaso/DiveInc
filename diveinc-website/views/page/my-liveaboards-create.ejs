<!-- Modal Room Details -->
<div class="modal" id="modalRoomDetails" tabindex="-1" role="dialog"aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-body">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4>Twin Bungalow</h4>
                    <h6 class="text-muted">Room Details</h6>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        Perfect for 2 people traveling together. The twin bungalows are equipped with 2 twin beds, aircon, fan, a private open-air bathroom, and a balcony with hammock, table and chairs.
                    </div>
                    <div class="col-md-12 mt-3">
                        <h6 class="mb-3">Room Info</h6>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="list-panel border-bottom mb-2">
                                    <div class="list-panel-title">Room size</div>
                                    <div class="list-panel-content">12m2</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="list-panel border-bottom mb-2">
                                    <div class="list-panel-title">Max. occupancy</div>
                                    <div class="list-panel-content">2 guest</div>
                                </div>
                            </div>
