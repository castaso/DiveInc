                                        </div>
                                    </div>
                                </div>
                            </div>
                            <a href="#modalSetHighlight" data-toggle="modal" onclick="loadHighlight()" class="btn btn-outline-primary btn-sm" type="button">Manage</a>
                            <!-- <button class="btn btn-outline-primary btn-sm" type="button">Add Item</button> -->
                        </div>
                        <div class="alert alert-info border-0 mt-3 mb-0 text-sm"><div class="d-flex"><div class="mr-2"><i class="fas fa-info-circle"></i></div><div>Write your liveaboard highlight to inform the guest with quick best value of your liveaboard.</div></div></div>
