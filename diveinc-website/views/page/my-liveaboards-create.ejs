    function activePackage(packageId, statusPublish, roomLiveaboardID, totalSchedule) {
        // console.log('rL',roomLiveaboard);
        let text = ''; let title = '';
        if (totalAktif == 1 && statusPublishLiveaboard == true && statusPublish) {
            text = "Since this is the only active package,<br/> this will <b style='color:red'>automatically unpublish your Liveaboard</b>.";
        }else if(totalAktif == 1){
            text = "You will close this package";  
        }

        // alert(totalSchedule);
        if (totalSchedule == 0 && statusPublish == false) {
            Swal.fire("No schedule", "Please make schedule before you open package");
            return false;
        }

        // console.log(roomLiveaboardID);
        // console.log(totalNonAktif);
        let rLOB = roomLiveaboardID.split(',');
        for (let rL = 0; rL < rLOB.length; rL++) {
            for (let tI = 0; tI < totalNonAktif.length; tI++) {
                if (totalNonAktif[tI].tipe == 'room') {
                    console.log(totalNonAktif[tI].id +'=='+ rLOB[rL])
                    if (totalNonAktif[tI].id == rLOB[rL]) {
                        Swal.fire("Open Package failed", "Closed Room on Package, please remove closed room on your package price");
                        return false;
                    }
                }
                
            }
        }

        if (statusPublish) {
            title = 'Close this package?'
        } else {
            title = 'Open this package ?';
            text = "You will make this package available for customers"
        }

        Swal.fire({
            title: title,
            html: text,
            icon: "warning",
            showCancelButton: true,
        }).then(function(isConfirm) {
            if (isConfirm.value) {
                $("#overlay-loader").removeClass('d-none');
                if (totalAktif == 1 && statusPublishLiveaboard == true && statusPublish) {
                    unpublishLiveaboard(id, packageId, 2);
                }else{
                    changePackageStatus(packageId, statusPublish);
                }
            } 
        });
    }

    function changePackageStatus(packageId, statusPublish){
        let title = '';
        if (statusPublish == 4) {
            title = "Liveaboard unpublished and package's status now closed";
        }else if (statusPublish) {
            title = "Package's status now closed";
        }else{
            title = "Package's status now open";
        }

        $.ajax({
            url: `/api/package/${packageId}/publish`,
            method: `PUT`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    // alert("Success")
                    // location.href = `/my-liveaboard-create/${id}`
                    if (statusPublish == false && statusPublishLiveaboard == false) {
                        Swal.fire({
                            title: "Publish your liveaboard too ?",
                            text: "You liveaboard status is unpublished",
                            showCancelButton : true,
                            cancelButtonText : "No",
                        }).then(function(isConfirm) {
                            console.log(isConfirm)
                            if (isConfirm.value) {
                                $("#overlay-loader").removeClass('d-none');
                                if (totalNonAktif.length > 1) {
                                    for (let i = 0; i < totalNonAktif.length; i++) {
                                        if (totalNonAktif[i].tipe == 'package') {
                                            if (totalNonAktif[i].id == packageId) {
                                                totalNonAktif[i].tipe = '';
                                                totalNonAktif[i].nama = '';
                                                totalNonAktif[i].id = '';
                                            }
                                        }
                                    }   
                                }else{
                                    totalNonAktif = [];
                                }
                                canPublish = true;
                                savePublish();
                            } else {
                                Swal.fire(
                                    'Cancelled', 
                                    'OK', 
                                    'error'
                                );
                                location.reload();
                            }
                        })
                    }else{
                        Swal.fire({
                            title: title,
                            text: "The liveaboards package status has been successfully changed.",
                            confirmButtonText: 'Great'
                        }).then(function() {
                            location.reload()
                            //window.location.href = `/my-divecenter-create/${id}#layoutDivecenterPackage`
                        });
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    
    }

