    //=========================================================================
    function unpublishLiveaboard(liveaboardId, rId, type){
        $.ajax({
            url: `/api/liveaboard/${liveaboardId}/publish`,
            method: `PUT`,
            data : {
                publish : false
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    if (type==1) {
                        changeRoomStatus(rId, 3);
                    }else if(type==2){
                        changePackageStatus(rId,4)
                    }else if (type==3) {
                        let r = rId.split('??');
                        let roomId = r[0];
                        let roomName = r[1];
                        deleteRoom(roomId, roomName, 2)
                    }else if(type==4) {
                        let r = rId.split('??');
                        let roomId = r[0];
                        let roomName = r[1];
                        deletePackage(roomId, roomName, 2)
                    }
                } else {
                    let msg = '';
                    if (type == 1) {
                        msg = 'Liveaboard not unpublished, cabin still open'
                    }
                    Swal.fire(
                        'Action Failed',
                        msg
                    )
                    //alert(result.message)
                    //console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function createSchedule(){
        let package_id = $('#packageSelect').val();
        let tanggal = dateFormatForDB($('#datePicker').val()).split('-').reverse().join('-');
        if (package_id != '' && tanggal.length > 0 ) {
            $('#overlay-loader').removeClass('d-none');
            $.ajax({
                    url: `/api/schedule`,
                    method: `POST`,
                    data:{
                        parent_id : package_id,
                        schedule_date : tanggal
                    },
                    success: function (result) {
                        console.log(result)
                        if (result.success) {
                            $('#overlay-loader').addClass('d-none');
                            scheduleTable.ajax.reload();
                            $('#datePicker').val('');
                            Swal.fire({
                                title: "Success",
                                text: "Date Added",
                                confirmButtonText: 'Great'
                            }).then(function() {
                                window.location.reload()
                            });

                        } else {
                            $('#overlay-loader').addClass('d-none');
                            //alert(result.message)
                            console.log(result)
                            Swal.fire({
                                title: "Data Liveaboard Package update error",
                                text: result.message
                            }).then(function() {
                                window.location.replace(`/my-liveaboards-create/${id}#schedule-section`)
                                // window.location.reload();
                                // location.href = `/my-liveaboards-create/${parentId}`
                            });
                        }
                    },
                    error(xhr, status, error) {
                        $('#overlay-loader').addClass('d-none');
                        if(xhr.responseJSON){
                            console.log(xhr.responseJSON)
                            Swal.fire({
                                title: "Data Liveaboard Package update error",
                                text: xhr.responseJSON.message
                            }).then(function() {
                                //window.location.reload();
