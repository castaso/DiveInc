                for(var j = 0; j < roomItem.length; j++){
                    if(roomItem[j].id == roomItemId){
                        for(var k = 0; k < roomItem[j].detail_guest.length; k++){
                            if(roomItem[j].detail_guest[k].id == personId){
                                packageData.room[i].roomItem[j].detail_guest[k].title = $(`#sel-${roomId}-${roomItemId}-${personId}`).val()
