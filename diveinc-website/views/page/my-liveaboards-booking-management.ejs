<!-- DATATABLES -->
<script type="text/javascript" src="https://cdn.datatables.net/v/bs4-4.1.1/dt-1.10.20/b-1.6.1/sl-1.3.1/datatables.min.js"></script>
<script>

    const liveaboard_id="<%= id %>"
    $(document).ready(function() {
        $('#dataRoomBooking').DataTable({
            processing: true,
            serverSide: true,
            searching: true,
            "columnDefs": [{
                "targets"  : 'nosort',
                "orderable": false,
            }],
            ajax: "/api/datatable-liveaboard?id="+liveaboard_id
        });
    } );

    function getDetail(id){
        location.href="/my-liveaboards-booking-management/"+id
    }

    function confirm(id){
        Swal.fire({
            title: "Accept this order?",
            text: "You can't undo this action.",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Accept it!'
        }).then((respond) => {
            if (respond.value) {
                $.ajax({
                    url: `/api/transaction-liveaboard/${id}/approve`,
                    method: `PUT`,
                    success: function (result) {
                        console.log(result)
                        if (result.success) {
                            Swal.fire("Approved success","You has approved this transaction").then((result) => {
                                window.location.reload()
                            });
                        } else {
                            alert(result.message)
                            console.log(result)
                        }
                    },
                    error(xhr, status, error) {
                        if(xhr.responseJSON){
                            console.log(xhr.responseJSON)
                        }
                    }
                });
            }
        });
    }

    function decline(id){
        Swal.fire({
            title: "Reject this order?",
            text: "Are you sure ? You can't undo this action.",
            showCancelButton: true,
            confirmButtonColor: '#bd2130',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Reject It.'
        }).then((result) => {
            if (result.value) {
                $.ajax({
                    url: `/api/transaction-liveaboard/${id}/reject`,
                    method: `PUT`,
                    success: function (result) {
                        console.log(result)
                        if (result.success) {
                            window.location.reload()
                        } else {
                            alert(result.message)
                            console.log(result)
                        }
                    },
                    error(xhr, status, error) {
                        if(xhr.responseJSON){
                            console.log(xhr.responseJSON)
                        }
                    }
                })
            }
        });
    }

    function loadTransactionDetailById(detail_id){

        $("#overlay-loader").removeClass('d-none');
        $("#namaVendor").text('');
        $("#bookingID").text('');
        $('#packageDetail').text('').addClass('d-none');
        $('#packageDetailTitle').hide();

        $('#packageGuestDetail').text('').addClass('d-none');
        $('#packageGuestDetailTitle').hide();

        $('#section-print').html('');
        $('#summaryPackageValue').html('');
        $('#summaryPackage').hide();

        $(".detailDiv").removeClass('d-none');
        $(".guestDiv").addClass('d-none');

        $('#guestViewBtnText').removeClass('d-none');
        $('#detailViewBtnText').addClass('d-none');

        $('#modalBookingDetail').modal('toggle');
        $.ajax({
            url: `/api/transaction-liveaboard/${detail_id}`,
            method: `GET`,
            success: function (result) {
                console.log(result);
                if (result.success) {
                    // console.log(result.data);
                    let packageData = result.data.package_data
                    let vendor = result.data.liveaboard;
                    var g_total = 0;

                    let packageList = [];
                    for (let i = 0; i < vendor.packages.length; i++) {
                        packageList[vendor.packages[i].id] = vendor.packages[i].info.duration
                    }

                    $("#namaVendor").text(vendor.profile.name);
                    $("#bookingID").text(result.data.transaction_code);

                    let tbl_pre = ``;
                    let tbl = ``;
                    let tblGuest = '';
                    let tblRoom = '';

                    if (typeof packageData.room !== 'undefined') {
                        for (let i = 0; i < packageData.room.length; i++) {
                            let subTotal = packageData.room[i].roomItem[0].guest * packageData.room[i].roomPrice;
                            g_total += parseFloat(subTotal)
                            // if (tblRoom != '') {
                                tblRoom += `<tr><td colspan='5'><hr/></td></tr>`
                                tblGuest += `<tr><td colspan='5'><hr/></td></tr>`
                            // }
                            tblRoom += `
                                <tr>
                                    <td>CABIN</td>
                                    <td>${packageData.room[i].roomName.toUpperCase()}</td>
                                    <td style='padding:0 5px'></td>
                                    <td style='padding:0 5px'></td>
                                    <td style='padding:0 5px;' class='text-right'></td>
                                </tr>
                                <tr>
                                    <td>GUEST</td>
                                    <td>${packageData.room[i].roomItem[0].guest}</td>
                                    <td style='padding:0 5px'></td>
                                    <td style='padding:0 5px'  class='text-right'>${formatRupiah(packageData.room[i].roomPrice)}</td>
                                    <td style='padding:0 5px;' class='text-right'><b>${formatRupiah(subTotal)}</b></td>
                                </tr>
                                <!--<tr>
                                    <td></td>
                                    <td></td>
                                    <td style='padding:0 5px'></td>
                                    <td style='padding:0 5px'><b>TOTAL</b></td>
                                    <td style='padding:0 5px; border-top:1px solid #333' class='text-right'><b> ${formatRupiah(subTotal) }</b></td>
                                </tr>-->`;

                                let detail_guest = packageData.room[i].roomItem[0].detail_guest;
                                if (detail_guest) {
                                    tblGuest += `<tr>
                                            <td>CABIN</td>
                                            <td>${packageData.room[i].roomName.toUpperCase()}</td>
                                            <td style='padding:0 5px'></td>
                                            <td style='padding:0 5px'></td>
                                            <td style='padding:0 5px;' class='text-right'></td>
                                        </tr>`
                                    for (let j = 0; j < detail_guest.length; j++) {
                                        let txt = (j==0 ? 'GUEST' : '');
                                        tblGuest += `
                                        <tr>
                                            <td>${txt}</td>
                                            <td>${detail_guest[j].title} ${detail_guest[j].first_name} ${detail_guest[j].last_name}</td>    
                                        </tr>`;
                                    }
                                    
                                }
                        }
                    }

                    if (typeof packageData.package !== 'undefined') {
                        let srvc = '';
                        for (let r_idx = 0; r_idx < packageData.package.length; r_idx++) {
                            let tgl_start = packageData.package[r_idx].package_date;
                            let tgl_start_add = new Date(tgl_start);
                            let dS = new Date();
                            let dayCount = 1;
                            if (typeof packageData.package[r_idx].day !== 'undefined') {
                                dayCount = packageData.package[r_idx].day;
                            }
                            let tgl_end = new Date(dS.setDate(tgl_start_add.getDate() + parseInt(dayCount) - 1));
                            let tgl_end_show = dateFormatSM(tgl_end.getFullYear()+'-'+(tgl_end.getMonth()+1)+'-'+tgl_end.getDate());
                            tglShow = dateFormatSM(tgl_start)+ ' - ' + tgl_end_show;

                            tbl += `<table width='100%'>
                                <tr>
                                    <td style='width:100px'>PACKAGE</td>
                                    <td><b>${packageData.package[r_idx].packageName.toUpperCase()}</b></td>
                                    <td colspan='3'></td>
                                </tr>`;

                            tbl+= `
                                    <tr>
                                        <td>DATE</td>
                                        <td><b>${tglShow}</b></td>
                                        <td colspan='3'></td>
                                    </tr>`
                            
                            let tblService = '';
                            let subTotal = 0;
                            for (let s = 0; s < packageData.package[r_idx].service.length; s++) {
                                let srvc = packageData.package[r_idx].service[s];
                                if (srvc.qty > 0) {
                                    subTotal += srvc.price * srvc.qty;
                                    if (tblService == '') {
                                        tblService += `
                                            <tr>
                                                <td>ADDITIONAL</td>
                                                <td>${srvc.name}</td>
                                                <td style='padding:0 5px'> x ${srvc.qty}</td>
                                                <td style='padding:0 5px'  class='text-right'> ${formatRupiah(srvc.price)}</td>
                                                <td style='padding:0 5px;' class='text-right'><b>${formatRupiah(srvc.price * srvc.qty) }</b></td>
                                            </tr>`;
                                    }else{
                                        tblService += `<tr>
                                                <td></td>
                                                <td>${srvc.name}</td>
                                                <td style='padding:0 5px'> x ${srvc.qty}</td>
                                                <td style='padding:0 5px'  class='text-right'> ${formatRupiah(srvc.price)}</td>
                                                <td style='padding:0 5px' class='text-right'><b>${formatRupiah(srvc.price * srvc.qty) }</b></td>
                                            </tr>`;
                                    }

                                    /* tblService += `<tr>
                                        <td></td>
                                        <td></td>
                                        <td style='padding:0 5px'></td>
                                        <td style='padding:0 5px'><b>TOTAL</b></td>
                                        <td style='padding:0 5px; border-top:1px solid #333' class='text-right'><b> ${formatRupiah(subTotal) }</b></td>
                                    </tr>`; */
                                    
                                }
                            }

                            g_total += subTotal;

                            let tblShow = tbl+tblRoom+"<tr><td colspan='5'><hr/></td></tr>"+tblService+'</table>'
                            let tblShowGuest = tbl+tblGuest+'</table>';
                        
                            // tbl += '</table>';
                            
                            // alert(tblGuest);

                            $('#packageDetail').append(tblShow);
                            $('#packageDetail').removeClass('d-none');
                            $('#packageDetailTitle').show();

                            $('#packageGuestDetail').append(tblShowGuest);
                            $('#packageGuestDetail').removeClass('d-none');
                            $('#packageGuestDetailTitle').show();
                        }
                        // $('#summaryPackageValue').html(formatRupiah(subTotal) );
                        $('#summaryPackage').show();
                        // g_total += parseFloat(subTotal);
                    }

                    $('#g-total').html(formatRupiah(Math.round(g_total*1.1*100)/100))

                    $('#section-print').html($('#modalBookingDetail .modal-body').html());

                    $('#overlay-loader').addClass('d-none');

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function toggleView(){
        $(".detailDiv").toggleClass('d-none');
        $(".guestDiv").toggleClass('d-none');

        $('#guestViewBtnText').toggleClass('d-none');
        $('#detailViewBtnText').toggleClass('d-none');
    }


</script>