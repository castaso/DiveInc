                        break
                    }
                }
                
                listPackageChoose[i].packageItem = [];
                for (let m = 0; m < rItem.length; m++) {
                    listPackageChoose[i].packageItem.push({...rItem[m]});
                }
            } 
        }
        
        if(listPackageChoose.length == 0){
