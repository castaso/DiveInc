        loadMySummary()
    }

    function rekapRoomChoose(){
        let listTemp = [];
        for(var i = 0; i < listRoomsChoose.length; i++){
            if (listRoomsChoose[i].roomItem.length > 0) {
                listTemp.push({...listRoomsChoose[i]});
            }
        }

        listRoomsChoose = [];

        for(var i = 0; i < listTemp.length; i++){
            if (listTemp[i].roomItem.length > 0) {
                listRoomsChoose.push({...listTemp[i]});
            }
        }
        
    }

    function rekapRoomSummary(){
        listRoomsChooseSummary = [];
        for(var i = 0; i < listRoomsChoose.length; i++){
            listRoomsChooseSummary.push({...listRoomsChoose[i]});
        }
    }

    function plusGuest(roomId, buttonId){
        var maxRoom = "";
        
        for(var i = 0; i < listRooms.length; i++){
            if(listRooms[i].id == roomId){
                maxRoom = listRooms[i].rules.max_person
            }
        }

        for(var i = 0; i < listRoomsChoose.length; i++){
            if(listRoomsChoose[i].id == roomId){
                var roomItem = listRoomsChoose[i].roomItem
                for(var j = 0; j < roomItem.length; j++){
                    if(roomItem[j].id == buttonId){
                        // CHECK MAX ROOM
                        if(roomItem[j].guest < maxRoom){
                            roomItem[j].guest++
                            $(`#text-${buttonId}`).val(roomItem[j].guest)
                            $(`#span-${buttonId}`).text(roomItem[j].guest)
                        }else{
                            Swal.fire("We're sorry","Max person is reached");
                        }
                    }
                }
            }
        }
    }

    function cancelChangeTrip(roomId){
        listRoomsChoose = [];
        // console.log('4',listRoomsChooseSummary);
        for(var i = 0; i < listRoomsChooseSummary.length; i++){
            if(listRoomsChooseSummary[i].id == roomId){
                listRoomsChoose[i] = {...listRoomsChooseSummary[i]};
            }
        }
        
    }

    function addToMyTrip(roomId){
        var isAvailable = false

        rekapRoomChoose();
        
        for(var i = 0; i < listRoomsChooseSummary.length; i++){
            if(listRoomsChooseSummary[i].id == roomId){
                isAvailable = true;
                listRoomsChooseSummary[i] = {};
                listRoomsChooseSummary[i] = {...listRoomsChoose[i]};
            }
        }
        
        if(!isAvailable){
            for(var i = 0; i < listRoomsChoose.length; i++){
                if(listRoomsChoose[i].id == roomId){
                    listRoomsChooseSummary.push({...listRoomsChoose[i]});
                }
            }
        }
        // console.log('1',listRoomsChooseSummary);
        rekapRoomSummary();
        loadMySummary()
    }

    function loadMySummary(){
        // rekapRoomChoose();
        let roomCount = 0; let packageCount=0;
        $('#listSummary').empty()
        
        for(var i = 0; i < listRoomsChooseSummary.length; i++){
            console.log('listRoom',listRoomsChoose[i]);
            var roomItem = listRoomsChooseSummary[i].roomItem
            var roomItemHtml = ""

            var subTotalRoom = 0
            if (typeof roomItem !== 'undefined') {
                roomCount += parseInt(roomItem.length);
                for(var j = 0; j < roomItem.length; j++){
    
                    if(listRoomsChooseSummary[i].sharingRoom == "yes"){
                        subTotalRoom += parseFloat(listRoomsChooseSummary[i].roomPrice) * parseFloat(roomItem[j].guest)
                        roomItemHtml = roomItemHtml + `
                            <div class="list-panel list-panel-sm border-bottom mt-2">
                                <div class="list-panel-title">Room ${j+1} - Dorm</div>
                                <!-- div class="list-panel-content"><i class="far fa-user fa-sm mr-2"></i>x${roomItem[j].guest}</div -->
                                <div class="list-panel-content">IDR ${formatRupiah(parseFloat(listRoomsChooseSummary[i].roomPrice) * parseFloat(roomItem[j].guest))}</div>
                            </div>
                        `
                    }else{
                        subTotalRoom += parseFloat(listRoomsChooseSummary[i].roomPrice)
                        roomItemHtml = roomItemHtml + `
                            <div class="list-panel list-panel-sm border-bottom mt-2">
                                <div class="list-panel-title">Room ${j+1}</div>
                                <!-- div class="list-panel-content"><i class="far fa-user fa-sm mr-2"></i>x${roomItem[j].guest}</div -->
                                <div class="list-panel-content">IDR ${formatRupiah(parseFloat(listRoomsChooseSummary[i].roomPrice))}</div>
                            </div>
                        `
                    }
                }
            }

            $('#listSummary').append(`
                <div class="d-block mb-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="font-weight-bold">${listRoomsChooseSummary[i].roomName}</div>
                        <div>
                            <button type="button" class="btn btn-outline-dark btn-sm" data-toggle="modal" data-target="#modalRoomGuest" onClick="loadModalRoom('${listRoomsChooseSummary[i].id}')"><i class="fas fa-pen fa-sm"></i></button>
                            <button type="button" class="btn btn-outline-dark btn-sm" onClick="removeRoom('${listRoomsChooseSummary[i].id}')"><i class="fas fa-trash fa-sm"></i></button>
                        </div>
                    </div>
                    <div class="d-block">
                        ${roomItemHtml}
                    </div>
                    <div class="list-panel list-panel-sm mt-2">
                        <div class="list-panel-title">Sub Total</div>
                        <div class="list-panel-content">IDR ${formatRupiah(parseFloat(subTotalRoom))}</div>
                    </div>
                </div>
            `)


            $('#emptyListSummary').addClass('hideImportant');
        }

        console.log('packagesummary',listPackageChooseSummary);
        for(var i = 0; i < listPackageChooseSummary.length; i++){
            packageCount++;
            let packageItem = listPackageChooseSummary[i].packageItem
            let subTotalPackage = 0;
            let packageHtml = ``;
            for (let p_idx = 0; p_idx < packageItem.length; p_idx++) {
                packageHtml += `<div class="d-block">
                            <div class="list-panel list-panel-sm border-bottom mt-2">
                                <div class="list-panel-title">Guest <i class="far fa-user fa-sm mr-2"></i>x${packageItem[p_idx].guest}</div>
                                <div class="list-panel-content">IDR ${formatRupiah(listPackageChoose[i].packagePrice*listPackageChooseSummary[i].packageItem[p_idx].guest)}</div>
                            </div>
                        </div>
                    </div>`
                subTotalPackage += parseFloat(listPackageChoose[i].packagePrice*listPackageChooseSummary[i].packageItem[p_idx].guest);
            }

            $('#listSummary').append(`
                <div class="d-block mb-3">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="font-weight-bold">${listPackageChooseSummary[i].packageName}</div>
                        <div>
                            <button type="button" class="btn btn-outline-dark btn-sm" data-toggle="modal" data-target="#modalPackageGuest" onClick="loadModalPackage('${listPackageChooseSummary[i].id}')"><i class="fas fa-pen fa-sm"></i></button>
                            <button type="button" class="btn btn-outline-dark btn-sm" onClick="removePackage('${listPackageChooseSummary[i].id}')"><i class="fas fa-trash fa-sm"></i></button>
                        </div>
                    </div>
                    ${packageHtml}
                    <div class="list-panel list-panel-sm mt-2">
                        <div class="list-panel-title">Sub Total</div>
                        <div class="list-panel-content">IDR ${formatRupiah(parseFloat(subTotalPackage))}</div>
                    </div>
                </div>
            `)
        }

        $("#roomSummaryMobile").html(roomCount);
        $("#packageSummaryMobile").html(packageCount);

    }

    function checkOutResort(){
        console.log(listPackageChooseSummary)
        if(listRoomsChooseSummary.length > 0 || listPackageChooseSummary.length > 0){
            $("#overlay-checkout").removeClass('d-none');
            $.ajax({
                url: `/api/transaction-resort`,
                method: `POST`,
                data : {
                    resort_id : id,
                    package_data : {
                        room : listRoomsChooseSummary,
                        package : listPackageChooseSummary
                    }
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        location.href = `/checkout-resort/${result.data.id}/schedule`
                    } else {
                        alert(result.message)
                        console.log(result)
                        $("#overlay-checkout").addClass('d-none');
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                    // alert(status);

                    if (xhr.responseJSON.message == 'Token is required') {
                        $("#overlay-checkout").addClass('d-none');
                        loginRequired();
                    }
                }
            })
        }else{
            // alert('You must choose room or package')
            Swal.fire(
                "First choose your room or package",
                "Don't forget to also add guests to your trip!"
            )
        }
    }

