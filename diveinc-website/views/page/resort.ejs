                // console.log(result)
                if (result.success) {
                    for (let i = 0; i < result.data.length; i++) {
                        roomAmenitiesList['ra-'+result.data[i].id] = result.data[i].name;
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

