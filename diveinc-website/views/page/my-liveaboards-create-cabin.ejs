<script>
    var id = "<%= id %>"
    var parentId = "<%= parentId %>"

    var dataAmenities = []
    var dataOptions = []
    var dataService = []

    var dataImage = [

    ]

    $(document).ready(function(){
        initData()

        $(`#customFile`).on(`change`, function(){

          makeFileRequestUpload('/api/upload/image', [], this.files).then((result) => {
              console.log(result)
          }, (error) => {
              console.error(error)
          })
        })

        $(`#addService`).click(function(){
          if($('#inputServiceName').val().length > 0 || $('#inputServicePrice').val().length > 0 || $('#inputServiceQty').val().length > 0 ){
            addService();
          }else{
            alert("Form not valid")
          }
        })
    })

    function initData(){
        if(!id){
            getAminity()
            getOption()
        }else{
            $(".formTitle").text('Edit')
            getRoomById()
        }
    }

    function getRoomById() {
        $.ajax({
            url: `/api/room/${id}`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    let info = result.data.info;
                    $('#inputName').val(info.name);
                    $('#inputDescription').val(info.description);
                    $('#inputWidth').val(info.room_size.width);
                    $('#inputLength').val(info.room_size.length);
                    $("#inputMaxPerson").val(result.data.rules.max_person);
                    // $("#inputMaxRoom").val(result.data.rules.max_room);
                    // $("#inputPrice").val(0);
                    // $("#inputDiscount").val(0);
                    $("#sharingRoom").val(result.data.rules.sharing_room);
                    
                    
                    dataOptions = info.room_option;
                    dataAmenities = info.room_aminities;
                    dataService = result.data.service;
                    dataImage = result.data.photos;
                    getOption();
                    getAminity();
                    // loadService();
                    // loadServiceItem();
                    loadImage();
                } else {
                    alert(result.message);
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    //==============================additional service==========================
        /*function addService(){
            populateService();

            var objService = {}
            objService.id = "service-"+new Date().getTime().toString()
            objService.name = $(`#inputServiceName`).val()
            objService.price = parseFloat($(`#inputServicePrice`).val())
            objService.qty = parseInt($(`#inputServiceQty`).val())
            dataService.push(objService)
            $('#inputServiceName').val("")
            $('#inputServicePrice').val("")
            $('#inputServiceQty').val("")
            loadService()
        }*/
        function loadService(){
            $(`.data-service`).remove()
            for(var i = 0; i < dataService.length; i++){
                $(`#listServiceModal`).append(`
                    <div class="d-block p-2 border mb-2 bg-lighter data-service" id="div-${dataService[i].id}">
                        <div class="d-flex">
                            <div class="mr-2 flex-grow-1">
                                <div class="form-row">
                                    <div class="col-md-6">
                                        <input type="text" class="form-control" id='serviceName-${dataService[i].id}' placeholder="Service item" value="${dataService[i].name}">
                                    </div>
                                    <div class="col-md-3">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">IDR</span>
                                            </div>
                                            <input type="number" class="form-control" min="0" id='servicePrice-${dataService[i].id}' placeholder="0" value="${dataService[i].price}">
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="input-group">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text">Max Qty</span>
                                            </div>
                                            <input type="number" class="form-control" min="0" id='serviceQty-${dataService[i].id}' placeholder="0" value="${dataService[i].qty}">
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <div class="btn-group" role="group" aria-label="Basic example">
                                    <button onClick="deleteService('${dataService[i].id}')" type="button" class="btn btn-outline-dark"><i class="far fa-trash-alt fa-sm"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                `).fadeIn('slow')
            }
        }

        function addServiceItem(){
            var objService = {}
            objService.id = "service-"+new Date().getTime().toString()
            objService.name = ''
            objService.price = ''
            objService.qty = ''
            dataService.push(objService)
