    function showIncompleteFieldMessage(listIncomplete){
        let earliestInput = "";
        $.each(listIncomplete,function(i,v){
            earliestInput = (i==0 ? v.inputId : earliestInput);
            if(!$(`#${v.inputId}`).parent().hasClass("input-group")){
                $(`#${v.inputId}`).parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
            }else{
                $(`#${v.inputId}`).parent().parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
            }
        });

        let el = document.getElementById(`${earliestInput}`);
        (earliestInput != '' ? el.scrollIntoView() : '');
    }

    
