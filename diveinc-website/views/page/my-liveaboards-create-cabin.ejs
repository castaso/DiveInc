        function populateService(){
            let dataTemp = [];
            let respond = true;
            $.each(dataService, function(i,v){
                let name = $(`#serviceName-${v.id}`).val();
                let price = $(`#servicePrice-${v.id}`).val();
                price = (price === '' ? 0 : parseFloat(price));
                let qty = $(`#serviceQty-${v.id}`).val();
                qty = (qty === '' ? 0 : parseFloat(qty));

                var objService = {}
                objService.id = v.id
                objService.name = name
                objService.price = price
                objService.qty = qty
                dataTemp.push(objService)

                if(name == '' || price === '' || qty === '' || price == 0 || qty == 0 ){
                    respond = false;
                }
            });

            dataService = dataTemp;
