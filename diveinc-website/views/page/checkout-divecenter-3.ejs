                                            <div class="select-card-checkbox"></div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div class="hide-mobile">
                                <a onClick="checkout('1');" href="#" class="btn btn-lg btn-primary disabled" id="verifyTermsButton">Reserve My Order</a>
                            </div>
                        </div>
                       
                    </div>
                    <div class="col-md-4">
                        <div class="checkout-summary">
                            <div class="checkout-summary--head">
                                <div class="checkout-summary--img backgroundImage"></div>
                                <div class="checkout-summary--title">
                                    <h4 class="divecenterName"></h4>
                                    <div class="d-block">
                                        <p class="mb-0"><i class="fas fa-map fa-sm mr-2"></i><span class="divecenterLocation"></span></p>
                                        <p class="mb-0" id="travelDate"></p>
                                    </div>
                                </div>
                            </div>
                            <div class="checkout-summary--list">
                                <ul class="list-group list-group-flush">
                                    <div id="listDataPackage"></div>
                                    <!-- <li class="list-group-item">
                                        <div class="list-person">
                                            <div class="list-person--title">
                                                <div>Komodo Weekender</div>
                                                <div>$2319</div>
                                            </div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="far fa-user fa-sm fas-fix mr-1"></i>$770 x3</div>
                                                <div>$2310</div>
                                            </div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="fas fa-plus fa-sm fas-fix mr-1"></i>Internet 20GB $9 x1</div>
                                                <div>$9</div>
                                            </div>
                                        </div>
                                    </li> -->
                                    </ul>
                                    <div class="list-total">
                                    <div class="list-total-item">
                                        <div>Total</div>
                                        <div id="totalSummary"></div>
                                    </div>
                                    <div class="d-none list-total-item">
