                                </div> 
                            </div>
                        </div>
                    </div>
                    <div class="col">
                        <div class="view-mobile-only mt-4">
                            <div>
                                Before continue to reserve my order, 
                                <div class="select-card-wrapper mb-2">
                                    <div class="select-card select-card-inherit select-card-naked select-card-inline">
                                        <label class="select-card-inner select-card-inner-h">
                                            <input type="checkbox" name="dive-email-update" id="termsConditions2"/>
                                            <div class="select-card-content">
                                                <h6 class="mb-0">I've read Dive Inc's <a href="" class="link-styled">Terms & Conditions</a></h6>
                                            </div>
                                            <div class="select-card-checkbox"></div>
                                        </label>
                                    </div>
                                </div>
                            </div>
                            <div>
                                <a onClick="checkout('2');" href="#" class="btn btn-lg btn-primary disabled" id="verifyTermsButton2">Reserve My Order</a>
