<section id="overlay-checkout" class="d-none fixed-top vw-100 vh-100" style="background:rgba(0,0,0,0.4)">
    <div class="text-center d-table h-100 w-100">
        <div class="d-table-cell h-100 align-middle">
            <div class="spinner-border text-light" style="width: 2rem; height: 2rem;" role="status">
            </div>
            <span class='text-light'>loading. . .</span>
        </div>
    </div>
</section>



<!-- FOOTER -->
<%-include ../partial/footer-nav %>
<%-include ../partial/footer %>

<script>

    var id="<%= id %>"

    var packageData
    var packages
    let listIten;

    $(document).ready(function(){
        $('#link-cd-1').attr('href',`/checkout-divecenter/${id}/schedule`);
        $('#link-cd-2').attr('href',`/checkout-divecenter/${id}/extra`);
        loadTransactionById()

        $("#inputEmail").change(function(){
            if (!validateEmail($('#inputEmail').val())) {
                return Swal.fire(
                        "Invalid Email Address",
                    ).then(function(){
                        $('#inputEmail').focus()
                    });
            }
        })
    })

    function loadTransactionById(){
        $.ajax({
            url: `/api/transaction-divecenter/${id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    $('#checkoutCover').addClass('hideImportant')
                    packageData = result.data.package_data
                    packages = result.data.divecenter.packages

                    $('.backgroundImage').css("background-image", `url('${result.data.divecenter.photos[0].url}')`)
                    $('.divecenterName').text(result.data.divecenter.profile.name)
                    $('.divecenterLocation').text(`${result.data.divecenter.profile.sub_destination.name} - ${result.data.divecenter.profile.destination.name}, ${result.data.divecenter.profile.country.name}`)
                    if (result.data.transaction_divecenter_status_id == 'b648ff73-468f-45cb-bbbc-fd3659e4b8ac') {
                        window.location.replace(`/checkout-divecenter/${result.data.id}/reserve`);
                    }
                    if(packageData.package){
                        for(var i = 0; i < packageData.package.length; i++){

                            var packageItem = packageData.package[i].packageItem;
                            for(var x = 0; x < packageData.package[i].packageItem.length; x++){
                                $('#travelDate').append('<i class="fas fa-calendar fa-sm mr-2"></i> '+dateFormatMonth(packageData.package[i].packageItem[x].package_date)+'<br/>');
                                $('#listDataPackage').append(`
                                    <li class="list-group-item">
                                        <div class="list-person">
                                            <div class="list-person--title">
                                                <div>${packageData.package[i].packageName} [Package plan - ${x + 1}]</div>
                                                <div style="min-width:120px; font-weight:500; position:relative" class='text-right'>
                                                    <div style='position:absolute;right:0px; bottom:0px'>IDR <span id="summaryTotal${packageData.package[i].packageItem[x].id}">${parseFloat(packageData.package[i].packagePrice)*parseFloat(packageData.package[i].packageItem[x].guest)}</span></div>
                                                </div>
                                            </div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="far fa-user fa-sm fas-fix mr-1"></i>IDR&nbsp; ${formatRupiah(packageData.package[i].packagePrice)} x${packageData.package[i].packageItem[x].guest}</div>
                                                <div>IDR&nbsp; <span id="total${packageData.package[i].packageItem[x].id}">${formatRupiah(parseFloat(packageData.package[i].packagePrice)*parseFloat(packageData.package[i].packageItem[x].guest))}</span></div>
                                            </div>
                                            <div class="all-extra" id="extra${packageData.package[i].packageItem[x].id}"></div>
                                        </div>
                                    </li>
                                `)
                            }

                            for(var x = 0; x < packageItem.length; x++){

                                var htmlGuestPackage = ""
                                var namePackage = ""

                                for(var j = 0; j < packages.length; j++){
                                    if(packageData.package[i].id == packages[j].id){

                                        if(namePackage == ""){
                                            namePackage = packages[j].info.name + ` - Package plan ${x+1}`
                                        }

                                        var dataGuest = []
                                        for(var k = 0; k < parseInt(packageItem[x].guest); k++){
                                            htmlGuestPackage = htmlGuestPackage + `
                                                <div class="d-block border-bottom mb-4 pb-3">
                                                    <div class="d-block mb-2">
                                                        Person ${k+1}
                                                    </div>
                                                    <div class="guest-detail">
                                                        <div class="guest-detail--item guest-detail--title">
                                                            <label for="title">Title</label>
                                                            <select id="sel-${packageData.package[i].id}-${packageItem[x].id}-person${k+1}" onChange="changeTitle('${packageData.package[i].id}', '${packageItem[x].id}', 'person${k+1}');" class="form-control rounded-0">
                                                                <option value="Mr.">Mr.</option>
                                                                <option value="Ms.">Ms.</option>
                                                            </select>
                                                        </div>
                                                        <div class="guest-detail--item guest-detail--first-name">
                                                            <label for="first_name">First Name <span class='required text-danger'>*</span></label>
                                                            <input id="first-${packageData.package[i].id}-${packageItem[x].id}-person${k+1}" oninput="changePackageFirstname('${packageData.package[i].id}', '${packageItem[x].id}', 'person${k+1}');" type="text" class="form-control rounded-0 text-capitalize" required>
                                                        </div>
                                                        <div class="guest-detail--item guest-detail--last-name">
                                                            <label for="last_name">Last Name <span class='required text-danger'>*</span></label>
                                                            <input id="last-${packageData.package[i].id}-${packageItem[x].id}-person${k+1}" oninput="changePackageLastname('${packageData.package[i].id}', '${packageItem[x].id}', 'person${k+1}');" type="text" class="form-control rounded-0 text-capitalize" required>
                                                        </div>
                                                        <div class="guest-detail--item guest-detail--nationality">
                                                            <label for="nationality">Nationality <span class='required text-danger'>*</span></label>
                                                            <select id="nat-${packageData.package[i].id}-${packageItem[x].id}-person${k+1}" onChange="changePackageNationality('${packageData.package[i].id}', '${packageItem[x].id}', 'person${k+1}');" class="form-control rounded-0">
                                                                <option value="Indonesia">Indonesia</option>
                                                                <option value="Tourism">Tourism</option>
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="guest-detail">
                                                        <div class="guest-detail--item guest-detail--last-name">
                                                            <label for="identity_number">Identity Number <span class='required text-danger'>*</span></label>
                                                            <input id="identity-${packageData.package[i].id}-${packageItem[x].id}-person${k+1}" oninput="changePackageIdentityNumber('${packageData.package[i].id}', '${packageItem[x].id}', 'person${k+1}');" type="text" class="form-control rounded-0 text-capitalize" required>
                                                        </div>
                                                    </div>
                                                </div>
                                            `
                                            dataGuest.push({
                                                id : `person${k+1}`,
                                                title : "Mr.",
                                                first_name : "",
                                                last_name : "",
                                                nationality : "Indonesia"
                                            })
                                        }

                                        packageItem[x].detail_guest = dataGuest

                                        for (let i_idx = 0; i_idx < packages[j].itenary.length; i_idx++) {
                                            listIten += `<div class="itenary-listing--item">
                                                <div class="itenary-wrapper">
                                                    <div class="itenary-title font-weight-bold">Day ${i_idx+1}<i class="fas fa-angle-down ml-2 active"></i></div>
                                                    <div class="itenary-content active">
                                                        <ul class="list-base">
                                                            ${packages[j].itenary[i_idx].text}
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>`;
                                        }
                                    }
                                    $('#list-iten').append(listIten);
                                }

                                $('#listPackage').append(`
                                    <div class="card mb-4">
                                        <div class="card-body">
                                            <h5 class="mb-3">${namePackage}</h5>
                                            ${htmlGuestPackage}
                                        </div>
                                        
                                    </div>
                                `)
                            }
                        }
                    }
                    
                    loadItem()

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function loadItem(){

        console.log(packageData)
        $('.all-extra').empty()

        var totalPrice = 0

        if(packageData.package){
            for(var i = 0; i< packageData.package.length; i++){

                for(var j = 0; j < packageData.package[i].packageItem.length; j++){
                    var totalSummary = 0
                    var summaryPrice = parseFloat(packageData.package[i].packagePrice) * parseFloat(packageData.package[i].packageItem[j].guest)
                    $(`#total${packageData.package[i].packageItem[j].id}`).text(formatRupiah(summaryPrice))
                    totalSummary += summaryPrice

                    for(var k = 0; k < packageData.package[i].packageItem[j].service.length; k++){
                        if(packageData.package[i].packageItem[j].service[k].qty > 0){
                            $(`#extra${packageData.package[i].packageItem[j].id}`).append(`
                                <div class="list-person--item text-muted">
                                    <div><i class="fas fa-plus fa-sm fas-fix mr-1"></i>${packageData.package[i].packageItem[j].service[k].name} (IDR&nbsp;${formatRupiah(packageData.package[i].packageItem[j].service[k].price)} x${packageData.package[i].packageItem[j].service[k].qty})</div>
                                    <div class="list-price ml-2">IDR&nbsp; ${formatRupiah(parseFloat(packageData.package[i].packageItem[j].service[k].price) * parseFloat(packageData.package[i].packageItem[j].service[k].qty))}</div>
                                </div>
                            `)

                            totalSummary += (parseFloat(packageData.package[i].packageItem[j].service[k].price) * parseFloat(packageData.package[i].packageItem[j].service[k].qty))
                        }
                    }

                    $(`#summaryTotal${packageData.package[i].packageItem[j].id}`).text(formatRupiah(totalSummary)) 
                    totalPrice += totalSummary
                }
            }
        }
        
        
        $('#totalSummary').text(`IDR ${formatRupiah(totalPrice)}`)
        var task = totalPrice / 10
        $('#taskTotal').text(`IDR ${formatRupiah(task)}`)
        $('#totalPrice').text(`IDR ${formatRupiah(totalPrice + task)}`)
    }

    function checkout(tipe){
        
        let isDisabled = false;
        if (tipe == 1) {
            if($('#verifyTermsButton').hasClass('disabled')){
                isDisabled = true;
            };
        }else{
            if($('#verifyTermsButton2').hasClass('disabled')){
                isDisabled = true;
            }
        }

        for (var i = 0; i < packageData.package.length; i++){
            // console.log(packageData.package[i].packageItem);
            for(var j = 0; j < packageData.package[i].packageItem.length; j++){
                for(var k = 0; k < packageData.package[i].packageItem[j].detail_guest.length; k++){
                    if(packageData.package[i].packageItem[j].detail_guest[k].first_name == ""){
                        return Swal.fire(
                            "First Name Required",
                        );
                        break;
                    }        
                }
            }
        }

        if($('#inputEmail').val() == "" || $('#inputPhone').val() == ""){
            // return alert("Email & Phone Number Reuqired")
            return Swal.fire(
                "Email & phone number required",
            );
        }

        if (!validateEmail($('#inputEmail').val())) {
            return Swal.fire(
                    "Invalid Email Address",
                ).then(function(){
                    $('#inputEmail').focus()
                });
        }

        packageData.contact = {
            email : $('#inputEmail').val(),
            phone_number : $('#inputPhone').val(),
            request : $('#inputRequest').val()
        }

        if (!isDisabled) {
            Swal.fire({
                title: "Confirmation",
                html: "Are you sure your travel information is right ?",
                confirmButtonText: 'Yes',
                showCancelButton : true,
            }).then(function(isConfirm) {
                if (isConfirm.value) {
                    $("#overlay-checkout").removeClass('d-none');
                    $.ajax({
                        url: `/api/transaction-divecenter/${id}/guest`,
                        method: `PUT`,
                        data : {
                            package_data : packageData
                        },
                        success: function (result) {
                            console.log(result)
                            if (result.success) {
                                location.href = `/checkout-divecenter/${result.data.id}/reserve`
                            } else {
                                alert(result.message)
                                console.log(result)
                                $("#overlay-checkout").addClass('d-none');
                            }
                        },
                        error(xhr, status, error) {
                            if(xhr.responseJSON){
                                console.log(xhr.responseJSON)
                            }

                            if (xhr.responseJSON.message == 'Token is required') {
                                $("#overlay-checkout").addClass('d-none');
                                loginRequired();
                            }
                        }
                    })
                
                }
            });

        }else{
            Swal.fire(
                "Please check terms and condition",
            );
        }
        



    }

    function changePackageTitle(packageId, packageItemId, personId){
        for (var i = 0; i < packageData.package.length; i++){
            if(packageData.package[i].id == packageId){
                var packageItem = packageData.package[i].packageItem
                for(var j = 0; j < packageItem.length; j++){
                    if(packageItem[j].id == packageItemId){
                        for(var k = 0; k < packageItem[j].detail_guest.length; k++){
                            if(packageItem[j].detail_guest[k].id == personId){
                                packageData.package[i].packageItem[j].detail_guest[k].title = $(`#sel-${packageId}-${packageItemId}-${personId}`).val()
                            }
                        }
                    }
                }
            }
        }
    }

    function changePackageFirstname(packageId, packageItemId, personId){
        for (var i = 0; i < packageData.package.length; i++){
            if(packageData.package[i].id == packageId){
                var packageItem = packageData.package[i].packageItem
                for(var j = 0; j < packageItem.length; j++){
                    if(packageItem[j].id == packageItemId){
                        for(var k = 0; k < packageItem[j].detail_guest.length; k++){
                            if(packageItem[j].detail_guest[k].id == personId){
                                packageData.package[i].packageItem[j].detail_guest[k].first_name = $(`#first-${packageId}-${packageItemId}-${personId}`).val()
                            }
                        }
                    }
                }
            }
        }
    }

    function changePackageLastname(packageId, packageItemId, personId){
        for (var i = 0; i < packageData.package.length; i++){
            if(packageData.package[i].id == packageId){
                var packageItem = packageData.package[i].packageItem
                for(var j = 0; j < packageItem.length; j++){
                    if(packageItem[j].id == packageItemId){
                        for(var k = 0; k < packageItem[j].detail_guest.length; k++){
                            if(packageItem[j].detail_guest[k].id == personId){
                                packageData.package[i].packageItem[j].detail_guest[k].last_name = $(`#last-${packageId}-${packageItemId}-${personId}`).val()
                            }
                        }
                    }
                }
            }
        }
    }

    function changePackageNationality(packageId, packageItemId, personId){
        for (var i = 0; i < packageData.package.length; i++){
            if(packageData.package[i].id == packageId){
                var packageItem = packageData.package[i].packageItem
                for(var j = 0; j < packageItem.length; j++){
                    if(packageItem[j].id == packageItemId){
                        for(var k = 0; k < packageItem[j].detail_guest.length; k++){
                            if(packageItem[j].detail_guest[k].id == personId){
                                packageData.package[i].packageItem[j].detail_guest[k].nationality = $(`#nat-${packageId}-${packageItemId}-${personId}`).val()
                            }
                        }
                    }
                }
            }
        }
    }

    function changePackageIdentityNumber(packageId, packageItemId, personId){
        for (var i = 0; i < packageData.package.length; i++){
            if(packageData.package[i].id == packageId){

                var packageItem = packageData.package[i].packageItem
                for(var j = 0; j < packageItem.length; j++){
                    if(packageItem[j].id == packageItemId){
                        for(var k = 0; k < packageItem[j].detail_guest.length; k++){
                            if(packageItem[j].detail_guest[k].id == personId){
                                packageData.package[i].packageItem[j].detail_guest[k].identity_number = $(`#identity-${packageId}-${packageItemId}-${personId}`).val()
                            }
                        }
                    }
                }
            }
        }
    }
</script>