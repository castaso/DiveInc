<%-include ../partial/footer %>

<script>
    var id = "<%= id %>"

    $(document).ready(function(){
        loadArticleById()
    })

    function loadArticleById() {
        $.ajax({
            url: `/api/article/${id}`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    $('#textCategory').text(result.data.article_category.name)
                    $('#textAuthor').text(`by ${result.data.author}`)
                    $('#textDate').text(reverseDate(result.data.created_at))
                    $('#articleTitle').text(result.data.name)
                    $('#articleImage').attr("src", result.data.images[0].url)
                    $('#contentArticle').html(result.data.description)
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }
</script>