                                                            <h4 class="m-0 discount-price">IDR ${formatRupiah(packagePrice)}</h4>`
                                priceList.push( listPackage[i].price.discount);
                                harga=listPackage[i].price.discount;
                            }else{
                                pricePackage = `<h4 class="m-0 normal-price">IDR ${formatRupiah(hargaPackage)}</h4>`
                                harga=listPackage[i].hargaPackage;
                            } */
