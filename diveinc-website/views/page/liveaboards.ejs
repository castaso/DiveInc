                                    pPrice = roomLOB[z].discount;
                                }
                                if (pricePackage == 0) {
                                    pricePackage = pPrice;
                                }else if (parseFloat(pricePackage) > parseFloat(pPrice) && parseFloat(pPrice) != 0) {
                                    pricePackage = pPrice;
                                }                                
                            }
                            console.log(formatRupiah(pricePackage));

                            // priceList.push(hargaPackage);
                            /* if(listPackage[i].price.discount != "0" && listPackage[i].price.discount != "" && listPackage[i].price.discount != null && listPackage[i].price.discount != 'NaN' && typeof listPackage[i].price.discount !== 'undefined'){
