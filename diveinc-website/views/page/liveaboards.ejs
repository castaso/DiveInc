    function loadLiveaboardById(id){
        $("#listPackage").html('');
        $.ajax({
            url: `/api/liveaboard/${id}?schedule=${bulanTahun}`,
            method: `GET`,
            success: function (result) {
                // console.log(result)
                if(result.success){
                    // var detailLocation = `${result.data.profile.sub_destination.name}, ${result.data.profile.destination.name} - ${result.data.profile.country.name}`

                    // $('#highlightLoader').addClass('hideImportant');
                    // $('#textLocation').text(`${result.data.profile.destination.name} - ${result.data.profile.sub_destination.name}`)
                    // $('#divecenterName, #divecenterName2').text(`${result.data.profile.name}`)
                    // $('#textAbout').text(`${result.data.profile.introduction}`)
                    // $('#about').append(`<span class="font-serif">${result.data.profile.about}</span>`)

