                    ideal = result.data.profile.ideal;
                    language_id = result.data.profile.language;
                    aminities = result.data.amenities;
                    

                    $('#imageBackground').css("background-image", `url('${result.data.photos[0].url}')`);
                    $('#textLocation').text(`${result.data.profile.destination.name} - ${result.data.profile.sub_destination.name}`)
                    $('#liveaboardName, #liveaboardName2').text(`${result.data.profile.name}`)
                    $('#textAbout').html(`${result.data.profile.introduction}`);
                    $('#about').append(`<span class="font-serif">${result.data.profile.about}</span>`)

                    highlight = result.data.highlight;
                    for(var i = 0; i < highlight.length; i++){
                        $('#listHighlight').append(`
                            <li>${highlight[i].highlight}</li>
                        `);
                    }

                    for(var i = 0; i < result.data.photos.length; i++){
                        $('#lightgallery').append(`
                            <div data-src="${result.data.photos[i].url}" class="gallery-item" style="background-image: url('${result.data.photos[i].url}');"><div>View Picture<img src="${result.data.photos[i].url}"/></div></div>
                        `)
                    }

                        $('#lightgallery').lightGallery({
                            selector: '.gallery-item',
                            download: false,
                            thumbnail: true
                        });
                    

                        listPackage = result.data.packages;
