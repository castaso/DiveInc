    function checkOutLiveaboard(package_id, packageName, packagePrice, package_date, schedule_id, day){
        var dateSplit = package_date.split("-")
     //   if(listPackageChooseSummary.length > 0){

            var dataCabin
            for(var i = 0; i < listPackage.length; i++){
                if(listPackage[i].id == package_id){
                    dataCabin = listPackage[i].room_liveaboard
                }
            }

            $("#overlay-checkout").removeClass('d-none');

            $.ajax({
                url: `/api/transaction-liveaboard`,
                method: `POST`,
                data : {
                    liveaboard_id : id,
                    package_data : {
                        package: [
                            {
                                id : package_id,
                                packageName : packageName,
                                packagePrice : packagePrice,
                                dataCabin : dataCabin,
                                guest: 0,
                                day: day,
                                package_date: dateSplit[2]+"-"+dateSplit[1]+"-"+dateSplit[0]
                            }
                        ]
                    }
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        location.href = `/checkout-liveaboards/${result.data.id}/room`
                    } else {
