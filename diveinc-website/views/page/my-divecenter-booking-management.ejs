<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<style>
    #dataRoomBooking tr td{
        vertical-align: top !important;
    }

    #section-print{
        /* visibility: hidden; */
        display: none;
        margin: 10px 20px 20px 40px;
    }

    #dataRoomBooking tr td p{
        font-size: 14px;
    }
    
    @media screen and (max-width:375px){
        #dataRoomBooking tr td, #dataRoomBooking tr td p{
            font-size: 10px;
        }
        
    }

    @media print {
        #contentBody{
            display: none;
        }
        #section-print {
            display: block;
            color: black !important;
            /* visibility: visible; */
        }

        #modalBookingDetail, #modalBookingDetail *{
            display: none;
        }

        #overlay-loader{
            display: none;
        }
        /* #section-print {
            position: absolute;
            left: 0;
            top: 0;
        } */
    }
</style>
<div class="header-spacer"></div>
<div class="modal bs-modal-lg" id="modalBookingDetail" tabindex="-1" role="dialog"aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
        <div class="modal-content rounded border-0">
            <div class="modal-body">
                <div id='bookingDetail'>
                    <p style='font-size: 2em' id='namaVendor'></p>
                    <p>
                        BOOKING ID :<span id='bookingID'></span>
                    </p>
                    <div id='transactionStatus' ></div>
                    <div class="detailDiv">
                        <h5 id='packageDetailTitle' class='mt-4'>PACKAGE INFO</h5>
                        <div id='packageDetail'class='d-none mb-5 border border-dark p-2 pb-4'></div>
                        <div class='text-right'>
                            <table style="margin-left: auto;">
                                <tr id='gtotal' style="background-color: #ddd; font-weight: bold;" >
                                    <td style='text-align: right;'>TOTAL PRICE*</td>
                                    <td style='padding:0 10px; width: 10px;'> : </td>
                                    <td id="g-total" style='width:150px;padding-right:10px'></td>
                                </tr>
                                <tr>
                                    <td colspan='3' class="text-right" style="padding-right:10px" >
                                        <i style="font-size:12px">*Total Price included tax </i>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class='guestDiv d-none'>
                        <h5 id='packageGuestDetailTitle' class='mt-4'>PACKAGE GUEST</h5>
                        <div id='packageGuestDetail'class='d-none mb-5 border border-dark p-2 pb-4'></div>
                        <div class='text-right'>
                        </div>
                    </div>
                </div>
                <section id="overlay-loader" class="d-none fixed-top vw-100 vh-100" style="background:rgba(0,0,0,0.4)">
                    <div class="text-center d-table h-100 w-100">
                        <div class="d-table-cell h-100 align-middle">
                            <div class="spinner-border text-light" style="width: 2rem; height: 2rem;" role="status">
                            </div>
                            <span class='text-light'>loading. . .</span>
                        </div>
                    </div>
                </section>
            </div>
            <div class="modal-footer justify-content-end">
                <div>
                    <button type="button" class="btn btn-primary hidden-print" onclick="window.print()" >Print</button>
                    <button type="button" class="btn btn-secondary hidden-print" onclick="toggleView()" >View <span id='detailViewBtnText' class='d-none'>Detail</span><span id='guestViewBtnText'>Guest</span></button>
                    <button type="button" class="btn btn-light btn-link hidden-print" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
<section class="section section-sm bg-lighter min-100-y" id='contentBody'>
    <div class="container">
        <div class="row justify-content-center">
