<style>
    @media only screen and (min-width: 760px) {
        .galleryBtn{
            position: absolute;
            background-color:rgba(0,0,0,.45);
            /* border-radius: 5px; */
            color:#999;
            cursor: pointer;
            display: block;
            font-size:20px;
            top: 70px;
            z-index: 99;
            border: none;
            font-weight:bold;
            text-align: center;
        }

        .galleryBtn:hover{
            background-color:rgba(255,255,255,.65);
            color:#333;
        }

        #leftBtn{
            position: absolute;
            left: 6px;
        }

        #leftBtn::before{
            content: "\2190";
            margin-left: 10px;
            padding: 0px 8px 5px 0px;
        }
        
        #rightBtn{
            position: absolute;
            right: 6px;
        }
        
        #rightBtn::after{
            content: "\2192";
            margin-right: 10px;
            padding: 0px 0px 5px 8px;
        }

        #listGalleryContainer{
            position: relative;
        }

        #listGalery{
            scroll-behavior: smooth;
        }
    }
    
    @media only screen and (max-width: 720px) {
        .galleryBtn{
            display: none;
        }
    }
</style>
