<%-include ../partial/footer-nav %>
<%-include ../partial/footer %>

<script>
    var id = "<%= id %>"
    const content = $('#listGalery').width();
    const wW = $(window).width();
    const content_scroll_width = content.scrollWidth
    // let content_scroll_left = content.scrollLeft

    $(document).ready(function(){
        loadDestinationById(id)
    })

    function loadDestinationById(id){
        $.ajax({
            url: `/api/destination/${id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    $('#introLoader, #aboutLoader, #highlightLoader, #bannerLoader, #tabLoader, #divingLoader').addClass('hideImportant');
                    console.log(result)
                    $('#name').text(result.data.name)
                    $('.nameDestination').text(result.data.name)
                    $('#nameHighlight').text(result.data.name)
                    $('#nameArticle').text(result.data.name)
                    $('#nameAbout').text(result.data.name)
                    $('#tagLine').text(result.data.tag_line)
                    $('#description').text(result.data.description)
                    $('#introduction').text(result.data.introduction)
                    // $('#background').css({"background-image": result.data.image_background[0].url}
                    $('#background').css("background-image", `url('${result.data.image_background[0].url}')`)
                    $('#about').append(result.data.about)

                    for(var i = 0; i < result.data.highlight.length; i++){
                        $('#listHighlight').append(`
                            <li>${result.data.highlight[i].value || result.data.highlight[i].text}</li>
                        `)
                    }

                    for(var i = 0; i < result.data.image_galery.length; i++){
                        $('#listGalery').append(`
                            <div data-src="${result.data.image_galery[i].url}"  class="gallery-item" style="background-image: url('${result.data.image_galery[i].url}');"><div>View Picture<img src="${result.data.image_galery[i].url}"/></div></div>
                        `)
                    }
                     $('#listGalery').lightGallery({
                        selector: '.gallery-item',
                        thumbnail: true
                    });

                    for(var i = 0; i < result.data.more_about.length; i++){
                        if(result.data.more_about[i].type == "link"){
                            $('#listMoreAbout').append(`
                                <div class="list-panel">
                                    <a href="${result.data.more_about[i].value}" target="_blank"><i class="mr-1 fas fa-external-link-alt fa-sm"></i>${result.data.more_about[i].key}</a>
                                </div>
                            `)
                        }else {
                            $('#listMoreAbout').append(`
                                <div class="list-panel">
                                    <div class="list-panel-title">${result.data.more_about[i].key}</div>
                                    <div class="list-panel-content">${result.data.more_about[i].value}</div>
                                </div>
                            `)
                        }
                    }

                    for(var i = 0; i < result.data.more_info.length; i++){
                        if(i == 0){
                            $('#myTab').append(`
                                <li class="nav-item">
                                    <a class="nav-link active" id="${result.data.more_info[i].id}-tab" data-toggle="tab" href="#${result.data.more_info[i].id}" role="tab" aria-controls="${result.data.more_info[i].id}" aria-selected="false">${result.data.more_info[i].title}</a>
                                </li>
                            `)
                            $('#myTabContent').append(`
                                <div class="tab-pane fade content-tab show active" id="${result.data.more_info[i].id}" role="tabpanel">
                                    ${result.data.more_info[i].text}
                                </div>
                            `)
                        }else{
                            $('#myTab').append(`
                                <li class="nav-item">
                                    <a class="nav-link" id="${result.data.more_info[i].id}-tab" data-toggle="tab" href="#${result.data.more_info[i].id}" role="tab" aria-controls="${result.data.more_info[i].id}" aria-selected="false">${result.data.more_info[i].title}</a>
                                </li>
                            `)
                            $('#myTabContent').append(`
                                <div class="tab-pane fade content-tab" id="${result.data.more_info[i].id}" role="tabpanel" aria-labelledby="${result.data.more_info[i].id}">
                                    ${result.data.more_info[i].text}
                                </div>
                            `)
                        }
                        
                    }

                    $('#myTab a').on('click', function (e) {
                        e.preventDefault()
                        $('.content-tab').removeClass('show')
                        $('.content-tab').removeClass('active')
                        $(`${$(this).attr('href')}`).addClass('show')
                        $(`${$(this).attr('href')}`).addClass('active')
                    })

                    $('#contentArticle').append(result.data.article);

                    for(var i = 0; i < result.data.sub_destinations.length; i++){
                        $('#subDestinationHC').append(`
                                <a href="/sub-destination/${result.data.sub_destinations[i].id}" class="explore-card--item">
                                    <div class="explore-card--content shadow-sm">
                                        <div class="explore-card--image" style="background-image: url('${result.data.sub_destinations[i].image_showing[0].url}');">
                                            <div class="explore-card--text-inside">
                                                <h4 class="mt-0 text-ellipsis">${result.data.sub_destinations[i].name}</h4>
                                                <p>${result.data.sub_destinations[i].description}</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            `);
                    }

                    for(var i = 0; i < result.data.sub_destinations.length; i++){
                        var subDestination = result.data.sub_destinations[i]
                        var highlight = subDestination.highlight
                        var highlightHtml = ""
                        for(var j = 0; j < highlight.length; j++){
                            highlightHtml = highlightHtml + `
                                <li>${highlight[j].value || highlight[j].text}</li>
                            `
                        }
                        var gallery = subDestination.image_galery
                        var galleryHtml = ""
                        for(var j = 0; j < gallery.length; j++){
                            galleryHtml = galleryHtml + `
                                <li class="glide__slide">
                                    <div class="slide-banner" style="background-image: url('${gallery[j].url}');"></div>
                                </li>
                            `
                        }

                        
                        // Gus, nanti pakenya yang dibawah ini ya, tapi ada error karena image_showing nya undefined
                        if(i = 0) {
                            $('#listSubDestinationNew').append(`
                                <a href="/sub-destination/${subDestination.id}" class="explore-card--item">
                                    <div class="explore-card--content shadow-sm">
                                        <div class="explore-card--image" style="background-image: url('${result.data[i].image_showing[0].url}');">
                                            <div class="explore-card--text-inside">
                                                <h4 class="mt-0 text-ellipsis">${subDestination.name}</h4>
                                                <p>${subDestination.description}</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            `)
                        }else {
                            $('#listSubDestinationNew').append(`
                                <a href="/sub-destination/${subDestination.id}" class="explore-card--item">
                                    <div class="explore-card--content shadow-sm">
                                        <div class="explore-card--image" style="background-image: url('${result.data[i].image_showing[0].url}');">
                                            <div class="explore-card--text-inside">
                                                <h4 class="mt-0 text-ellipsis">${subDestination.name}</h4>
                                                <p>${subDestination.description}</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            `)
                        }

                        // if(i == 0){
                        //     $('#listSubDestination').append(`
                        //         <li class="glide__slide">
                        //             <a href="/destination/${subDestination.id}" class="explore-card--item mb-0">
                        //                 <div class="explore-card--content shadow-sm">
                        //                     <div class="explore-card--image" style="background-image: url('${result.data[i].image_showing[0].url}');">
                        //                         <div class="explore-card--text-inside">
                        //                             <h4 class="mt-0">${subDestination.name}</h4>
                        //                             <p>${subDestination.description}</p>
                        //                         </div>
                        //                     </div>
                        //                 </div>
                        //             </a>
                        //         </li>
                        //     `)
                        // }else{
                        //     $('#listSubDestination').append(`
                        //         <li>
                        //             <a href="/destination/${subDestination.id}" class="explore-card--item mb-0">
                        //                 <div class="explore-card--content shadow-sm">
                        //                     <div class="explore-card--image" style="background-image: url('${result.data[i].image_showing[0].url}');">
                        //                         <div class="explore-card--text-inside">
                        //                             <h4 class="mt-0">${subDestination.name}</h4>
                        //                             <p>${subDestination.description}</p>
                        //                         </div>
                        //                     </div>
                        //                 </div>
                        //             </a>
                        //         </li>
                        //     `)
                        // }

                        // Yang ini mah di hide aja gus, buat disimpan dulu aja
                        if((i+1) % 2){
                            $('#listSubDestination').append(`
                                <div class="row sub-destination">
                                    <div class="col-lg-4 col-md-5 mb-4">
                                        <h6 class="text-muted">${subDestination.name}</h6>
                                        <h3 class="mb-2">${subDestination.tag_line}</h3>
                                        <p>${subDestination.introduction}</p>
                                        <ul class="list-small mb-3">
                                            ${highlightHtml}
                                        </ul>
                                        <a href="/sub-destination/${subDestination.id}" class="btn btn-outline-primary">Explore ${subDestination.name}</a>
                                    </div>
                                    <div class="col-lg-8 col-md-8 order-lg-1 order-md-1">
                                        <div class="glide-no-animation slide-banner-wrap">
                                            <div class="glide__track" data-glide-el="track">
                                                <ul class="glide__slides">
                                                    ${galleryHtml}
                                                </ul>
                                            </div>
                                            <div class="glide__arrows" data-glide-el="controls">
                                                <button class="glide__arrow glide__arrow--left" data-glide-dir="<"><img src="/images/left-arrow.svg"></button>
                                                <button class="glide__arrow glide__arrow--right" data-glide-dir=">"><img src="/images/right-arrow.svg"></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `)
                        }else{
                            $('#listSubDestination').append(`
                                <div class="row sub-destination">
                                    <div class="col-lg-4 col-md-5 order-lg-2 order-md-2 mb-4">
                                        <h6 class="text-muted">${subDestination.name}</h6>
                                        <h3 class="mb-2">${subDestination.tag_line}</h3>
                                        <p>${subDestination.introduction}</p>
                                        <ul class="list-small mb-3">
                                            ${highlightHtml}
                                        </ul>
                                        <a href="/sub-destination/${subDestination.id}" class="btn btn-outline-primary">Explore ${subDestination.name}</a>
                                    </div>
                                    <div class="col-lg-8 col-md-8 order-lg-1 order-md-1">
                                        <div class="glide-no-animation slide-banner-wrap">
                                            <div class="glide__track" data-glide-el="track">
                                                <ul class="glide__slides">
                                                    ${galleryHtml}
                                                </ul>
                                            </div>
                                            <div class="glide__arrows" data-glide-el="controls">
                                                <button class="glide__arrow glide__arrow--left" data-glide-dir="<"><img src="/images/left-arrow.svg"></button>
                                                <button class="glide__arrow glide__arrow--right" data-glide-dir=">"><img src="/images/right-arrow.svg"></button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `)
                        }

                        var sliders = document.querySelectorAll('.glide-no-animation');

                        for (var i = 0; i < sliders.length; i++) {
                            var glide = new Glide(sliders[i], {
                                type: 'carousel',
                                startAt: 0,
                                perView: 1,
                                gap: 0
                            });
                            
                            glide.mount();
                        }
                    }

                    var sliders = document.querySelectorAll('.glide-card');

                    for (var i = 0; i < sliders.length; i++) {
                        var glide = new Glide(sliders[i], {
                            type: 'carousel',
                            startAt: 0,
                            perView: 5,
                            gap: 0,
                            breakpoints: {
                                991: {
                                perView: 3
                                },
                                767: {
                                perView: 2
                                }
                            }
                        });
                        
                        glide.mount();
                    }

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function slideGalleryLeft(){
        let tmbh = $('.gallery-item:first').width();
        // let tmbh = $('#listGalery').get(0).scrollWidth - $('#listGalery').get(0).clientWidth;
        let glr = $('#listGalery');
        glr.scrollLeft(glr.scrollLeft() - tmbh)
    }

    function slideGalleryRight(){
        let tmbh = $('.gallery-item:last').width();
        // let tmbh = $('#listGalery').get(0).scrollWidth - $('#listGalery').get(0).clientWidth;
        let glr = $('#listGalery');
        glr.scrollLeft(glr.scrollLeft() + tmbh)
        // console.log($('#listGalery').get(0).scrollWidth,'-', $('#listGalery').get(0).clientWidth)
        // console.log()
    }
    
</script>