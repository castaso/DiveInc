<script>

    var id="<%= id %>"

    var packageData = []
    let tglShow = '';

    $(document).ready(function(){
        loadTransactionById()
    })

    function loadTransactionById(){
        $.ajax({
            url: `/api/transaction-liveaboard/${id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                   $('.bookingNumber').text(result.data.transaction_code)
                   $('.backgroundImage').css("background-image", `url('${result.data.liveaboard.photos[0].url}')`)
                   $('.resortName').text(result.data.liveaboard.profile.name)
                   $('.resortLocation').text(`${result.data.liveaboard.profile.sub_destination.name} - ${result.data.liveaboard.profile.destination.name}, ${result.data.liveaboard.profile.country.name}`)

                    packageData = result.data.package_data

                    if(packageData.package){
                        for(var i = 0; i < packageData.package.length; i++){
                            let tgl_start = packageData.package[i].package_date;
                            let tgl_start_add = new Date(tgl_start);
                            let dS = new Date();
                            let dayCount = packageData.package[i].day
                            let tgl_end = new Date(dS.setDate(tgl_start_add.getDate() + parseInt(dayCount) - 1));
                            let tgl_end_show = dateFormatSM(tgl_end.getFullYear()+'-'+(tgl_end.getMonth()+1)+'-'+tgl_end.getDate());
                            tglShow = dateFormatSM(tgl_start)+ '-' + tgl_end_show;
                            
                            $('.liveaboardDate').text(tglShow);
                            $('#listDataPackage').append(`
                                <li class="list-group-item">
                                    <div class="list-person">
                                        <div class="list-person--title">
                                            <div>${packageData.package[i].packageName}</div>
                                            <div>IDR&nbsp; <span id="summaryTotal${packageData.package[i].id}">${formatRupiah(parseFloat(packageData.package[i].packagePrice)*parseFloat(packageData.package[i].guest))}</span></div>
                                        </div>
                                        <div class="all-extra" id="extra${packageData.package[i].id}"></div>
                                    </div>
                                </li>
                            `)
                            
                        }
                    }

                    if(packageData.room){
                        for(var i = 0; i < packageData.room.length; i++){

                            var roomItem = packageData.room[i].roomItem

                            for(var j = 0; j < packageData.room[i].roomItem.length; j++){
                                $('#listDataRoom').append(`
                                    <li id="${packageData.room[i].id}" class="list-group-item">
                                        <div class="list-person">
                                            <div class="list-person--title">
                                                <div>${packageData.room[i].roomName} [Room ${j+1}]</div>
                                                <div>IDR&nbsp; <span id="summaryTotal${packageData.room[i].roomItem[j].id}">${formatRupiah(packageData.room[i].roomPrice)}</span></div>
                                            </div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="far fa-moon fa-sm fas-fix mr-1"></i>IDR&nbsp; ${formatRupiah(packageData.room[i].roomPrice)}</div>
                                                <div>IDR&nbsp; <span id="total${packageData.room[i].roomItem[j].id}">0</span></div>
                                            </div>
                                            <div class="all-extra" id="extra${packageData.room[i].roomItem[j].id}"></div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="far fa-user fa-sm fas-fix mr-1"></i>x${packageData.room[i].roomItem[j].guest}</div>
                                            </div>
                                        </div>
                                    </li>
                                `)
                            }

                            for(var x = 0; x < roomItem.length; x++){

                                var htmtGuestRoom = ""
                                var nameRoom = ""
                            }
                        }
                    }

                    loadItem()
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function loadItem(){

        console.log(packageData)
        $('.all-extra').empty()

        var totalPrice = 0

        if(packageData.package){
            for(var i = 0; i< packageData.package.length; i++){
                var totalSummary = 0
                // var summaryPrice = parseFloat(packageData.package[i].packagePrice) * parseFloat(packageData.package[i].guest)
                // $(`#total${packageData.package[i].id}`).text(formatRupiah(summaryPrice))
                // totalSummary += summaryPrice

                for(var k = 0; k < packageData.package[i].service.length; k++){
                    if(packageData.package[i].service[k].qty > 0){
                        $(`#extra${packageData.package[i].id}`).append(`
                            <div class="list-person--item text-muted">
                                <div><i class="fas fa-plus fa-sm fas-fix mr-1"></i>${packageData.package[i].service[k].name} (IDR&nbsp;${formatRupiah(packageData.package[i].service[k].price)} x${packageData.package[i].service[k].qty})</div>
                                <div class="list-price">IDR&nbsp; ${formatRupiah(parseFloat(packageData.package[i].service[k].price) * parseFloat(packageData.package[i].service[k].qty))}</div>
                            </div>
                        `)

                        totalSummary += (parseFloat(packageData.package[i].service[k].price) * parseFloat(packageData.package[i].service[k].qty))
                    }
                }

                $(`#summaryTotal${packageData.package[i].id}`).text(formatRupiah(totalSummary)) 
                totalPrice += totalSummary
            }
        }

        if(packageData.room){

        //var night = (new Date(packageData.room_date.to) - new Date(packageData.room_date.from)) / (1000 * 3600 * 24)

        for(var i = 0; i < packageData.room.length; i++){

        for(var j = 0; j < packageData.room[i].roomItem.length; j++){
            var totalSummary = 0
            
            var summaryPrice = 0
            // console.log(packageData.room[i].sharing_room)
            // if(packageData.room[i].sharing_room == "yes"){
            //     $(`#night${packageData.room[i].roomItem[j].id}`).text(packageData.room[i].roomItem[j].guest)
            //     summaryPrice = parseFloat(packageData.room[i].roomItem[j].guest) * parseFloat(packageData.room[i].roomPrice)
            // }else{
            //     $(`#night${packageData.room[i].roomItem[j].id}`).text("1")
            //     summaryPrice = 1 * parseFloat(packageData.room[i].roomPrice)
            // }

            summaryPrice =  parseFloat(packageData.room[i].roomItem[j].guest) * parseFloat(packageData.room[i].roomPrice)
            
            $(`#total${packageData.room[i].roomItem[j].id}`).text(formatRupiah(summaryPrice))
            totalSummary += summaryPrice

            // for(var x = 0; x < packageData.room[i].roomItem[j].service.length; x++){
            //     if(packageData.room[i].roomItem[j].service[x].qty > 0){
            //         $(`#extra${packageData.room[i].roomItem[j].id}`).append(`
            //             <div class="list-person--item text-muted">
            //                 <div class="mr-2"><i class="fas fa-plus fa-sm fas-fix mr-1"></i>${packageData.room[i].roomItem[j].service[x].name} (IDR&nbsp;${formatRupiah(packageData.room[i].roomItem[j].service[x].price)} x${packageData.room[i].roomItem[j].service[x].qty})</div>
            //                 <div class="list-price">IDR&nbsp;${formatRupiah(parseFloat(packageData.room[i].roomItem[j].service[x].price) * parseFloat(packageData.room[i].roomItem[j].service[x].qty))}</div>
            //             </div>
            //         `)

            //         totalSummary += (parseFloat(packageData.room[i].roomItem[j].service[x].price) * parseFloat(packageData.room[i].roomItem[j].service[x].qty))
                    
            //     }
            // }
            $(`#summaryTotal${packageData.room[i].roomItem[j].id}`).text(formatRupiah(totalSummary)) 
            totalPrice += totalSummary
        }
        }
        }

        $('#totalResorPrice').text(`IDR ${formatRupiah(totalPrice)}`)

        $('#totalSummary').text(`IDR ${formatRupiah(totalPrice)}`)
        var task = totalPrice / 10
        $('#taskTotal').text(`IDR ${formatRupiah(task)}`)
        $('#totalPrice').text(`IDR ${formatRupiah(totalPrice + task)}`)
        }

</script>