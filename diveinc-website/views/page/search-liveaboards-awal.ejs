                                id : package_id,
                                packageName : packageName,
                                packagePrice : packagePrice,
                                guest: 0,
                                package_date: dateSplit[2]+"-"+dateSplit[1]+"-"+dateSplit[0]
                            }
                        ]
                    }
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        location.href = `/checkout-liveaboards/${result.data.id}/room`
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
