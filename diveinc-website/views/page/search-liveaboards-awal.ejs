<script>
    $('#toggleFiltering').click(function(){
        $('#filteringPanel').addClass('active');
    })
    $('.finishFiltering').click(function(){
        $('#filteringPanel').removeClass('active');
    })
</script>

<script>

    const monthNames = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
        "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];

    let destinationList;
    let destination_id = '';
    let subdestination_id='';
    let today = new Date();
    
    $(document).ready(function(){
        loadLiveAboardPublish();
        importDestination()
            $('.slick').slick({
                infinite: false
            });
    });   

    function importDestination(){
        $.ajax({
            url: `/api/destination`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    destinationList = result.data;
                    for (let d_idx = 0; d_idx < destinationList.length; d_idx++) {
                        $("#destination-select").append(`<option value="${destinationList[d_idx].id}">${destinationList[d_idx].name}</option>` );            
                        // console.log(destinationList[d_idx].id);
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    
    }

    function loadLiveAboardPublish(){
        $.ajax({
            url: `/api/liveaboard/publish?destination=${destination_id}&sub_destination=${subdestination_id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {

                    $('#listLiveaboardsLoader').addClass('hideImportant')
                    
                    for(var i = 0; i < result.data.length; i++){

                        var htmlPhotos = ``
                        var dataPhotos = result.data[i].photos
                        for(var j = 0; j < dataPhotos.length; j++){
                            htmlPhotos += `
                                <div class="glide__slide--photos" style="background-image: url('${dataPhotos[j].url}');"></div>
                            `
                        }

                        var pricePackage = "0";
                        let priceDiscount = "0";
                        var dataPackage = result.data[i].packages;
                        let tgl_awal = '';
                        let tgl_akhir = '';
                        let from = '';
                        let discount = '';
                        let package_row='';
                        let package_row_mobile = '';
                        for(var j = 0; j < dataPackage.length; j++){
                            if(parseFloat(pricePackage) == 0){
                                if(dataPackage[j].price.discount != "" && dataPackage[j].price.discount != "0" && dataPackage[j].price.discount != 0){
                                    pricePackage = dataPackage[j].price.discount
                                }else{
                                    pricePackage = dataPackage[j].price.price
                                }
                            }else{
                                if(dataPackage[j].price.discount != "" && dataPackage[j].price.discount != "0" && dataPackage[j].price.discount != 0 && dataPackage[j].price.discount != 'NaN'){
                                    if(parseFloat(pricePackage) > parseFloat(dataPackage[j].price.discount)){
                                        priceDiscount = dataPackage[j].price.discount;
                                        pricePackage = dataPackage[j].price.price;
                                    }
                                }else {
                                    if(parseFloat(pricePackage) > parseFloat(dataPackage[j].price.price)){
                                        pricePackage = dataPackage[j].price.price;
                                    }
                                }
                            }

                            
                            // console.log((dataPackage[j].discount != 0 && dataPackage[j].discount != 'NaN' ? dataPackage[j].discount : dataPackage[j].price ));

                            let schedules = dataPackage[j].schedules;
                            for (let k = 0; k < (dataPackage[j].schedules.length > 10 ? 10 :dataPackage[j].schedules.length) ; k++) {
                                let t_ori = schedules[k].schedule_date.split('-');
                                let tgl = t_ori[2]+'-'+t_ori[1]+'-'+t_ori[0];
                                let hargaPackage = dataPackage[j].price.price;
                                if(dataPackage[j].price.discount != "" && dataPackage[j].price.discount != "0" && dataPackage[j].price.discount != 0 && dataPackage[j].price.discount != 'NaN'){
                                    hargaPackage = dataPackage[j].price.discount;
                                }

                                let schDate = new Date(reverseDate(dataPackage[j].schedules[k].schedule_date));
                                if(schDate.getTime() >= today.getTime() ){

                                    package_row += `<li class="departure-list">
                                            <a onClick="checkOutLiveaboard('${result.data[i].id}','${dataPackage[j].id}','${dataPackage[j].info.name}','${hargaPackage}','${dataPackage[j].schedules[k].schedule_date}', '${dataPackage[j].schedules[k].id}')" >
                                                <div class="departure-date">${t_ori[0]}<span>${monthNames[parseInt(t_ori[1]-1)]}</span></div>
                                                <div class="departure-trip">${dataPackage[j].info.name}</div>
                                                <div class="departure-duration font-weight-bolder text-muted">${dataPackage[j].info.duration.day} DAYS/${dataPackage[j].info.duration.night} NIGHT</div>
                                                <div class="departure-total-dives font-weight-bolder text-muted ml-3">${dataPackage[j].info.dive_total} DIVES</div>
                                                <div class="departure-price">IDR ${priceDiscount != "0" ? formatRupiah(priceDiscount) : formatRupiah(pricePackage)}</div>
                                            </a>
                                        </li>`;
    
                                    package_row_mobile += `<li class="departure-list">
                                        <a onClick="checkOutLiveaboard('${result.data[i].id}','${dataPackage[j].id}','${dataPackage[j].info.name}','${hargaPackage}','${dataPackage[j].schedules[k].schedule_date}', '${dataPackage[j].schedules[k].id}')" >
                                            <div class="departure-date text-center mr-3">${t_ori[0]}<span>${monthNames[parseInt(t_ori[1]-1)]}</div>
                                            <div class="departure-info">
                                                <div class="text-ellipsis">${dataPackage[j].info.name}</div>
                                                <div class="daydive d-flex align-items-center text-muted font-weight-bolder"><div class="mr-2">${dataPackage[j].info.duration.night} NIGHT/${dataPackage[j].info.duration.day} DAYS</div><div>${dataPackage[j].info.dive_total} DIVES</div></div>
                                            </div>
                                            <div class="departure-price text-left ml-3">IDR ${priceDiscount != "0" ? formatRupiah(priceDiscount) : formatRupiah(pricePackage)}</div>
                                        </a>
                                    </li>`;
                                }
                                
                                
                            }

                            

                            ///===============get harga ===========================

                        }

                        if (package_row== '') {
                            package_row = `<li class="departure-list">
                                <a href="">
                                        <div class="departure-date"></div>
                                        <div class="departure-trip">Full Book on this month</div>
                                        <div class="departure-duration font-weight-bolder text-muted"> </div>
                                        <div class="departure-total-dives font-weight-bolder text-muted ml-3"></div>
                                        <div class="departure-price"></div>
                                    </a>
                                </li>`;
                        }

                        if(package_row_mobile == ''){
                            package_row_mobile = `<li class="departure-list">
                                    <a href="">
                                        <div class="departure-date text-center mr-3"></div>
                                        <div class="departure-info">
                                            <div class="text-ellipsis">Not Available</div>
                                            <div class="daydive d-flex align-items-center text-muted font-weight-bolder"><div class="mr-2"></div></div>
                                        </div>
                                        <div class="departure-price text-left ml-3"></div>
                                    </a>
                                </li>`;
                        }
                        // console.log(${dataPackage[0].schedules.schedule_date})

                        $('#listLiveAboard').append(`
                            <div class="card rounded-0 shadow-sm border-0 mb-4">
                                <div class="row no-gutters">
                                    <div class="col-md-4">
                                        <div class="d-block">
                                            <span class="badge-photos badge badge-dark badge-pill rounded">${dataPhotos.length} Photos</span>
                                            <div class="slick">
                                                ${htmlPhotos}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body">
                                            <div class="row mb-2">
                                                <div class="col-lg-8">
                                                    <h5>${result.data[i].profile.name}</h5>
                                                    <div class="d-flex">
                                                        <small class="mr-3">Nitrox Avalaible</small>
                                                        <small>Internet</small>
                                                    </div>
                                                    <div class="d-block py-1 lob-about-card">
                                                        <p class="m-0">${result.data[i].profile.introduction}.</p>
                                                    </div>
                                                </div>
