<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<div class="header-spacer"></div>
<section class="section section-sm bg-lighter min-100-y">
    <div class="container">
        <div class="row">
            <!-- <div class="col-lg-12">
                <h2 class="m-0 mb-4">My Account</h2>
            </div> -->
            <%-include ../partial/sidebar-nav %>
            <div class="col-lg-9">
                <ul class="progress-step-wrapper list-unstyled pt-0 shift-left on-bg-lighter">
                    <li>
                        <a href="#" class="btn btn-white btn-sm">Homepage</a>
                    </li>
                    <li class="active">
                        <a href="#" class="btn btn-white btn-sm">My Wishlist</a>
                    </li>
                </ul>
                <div class="card shadow-sm border-0 rounded-0">
                    <div class="card-body pb-1">
                        <div class="d-flex align-items-center justify-content-between mb-4">
                            <div class="d-flex align-items-center">
                                <h5 class="m-0 mr-2">My Wishlist</h5>
                                <span class="badge badge-primary rounded">1</span>
                            </div>
                        </div>
                        <!-- Wishlist Resort -->
                        <div class="d-block mb-4">
                            <h5 class="panel-title panel-title-sm d-block mb-4">Resort</h5>
                            <div class="empty-content bg-white"><h6 class="mb-0 text-muted text-sm">No data avalaible...</h6></div>
                        </div>
                        <!-- Wishlist Liveaboards -->
                        <div class="d-block mb-4">
                            <h5 class="panel-title panel-title-sm d-block mb-4">Liveaboards</h5>
                            <!-- <div class="empty-content bg-white"><h6 class="mb-0 text-muted text-sm">No data avalaible...</h6></div> -->
                            <div class="explore-card">
                                <div class="explore-card--list explore-card--33">
                                    <div class="explore-card--item">
                                        <div class="explore-card--content shadow-sm">
                                            <div class="d-block">
                                                <span class="badge-photos badge badge-dark badge-pill rounded">3 Photos</span>
                                                <div class="slick">
                                                    <div class="glide__slide--photos">
                                                        <img data-lazy="/images/liveaboard-img-1.jpg">
                                                    </div>
                                                    <div class="glide__slide--photos">
                                                        <img data-lazy="/images/liveaboard-img-2.jpg">
                                                    </div>
                                                    <div class="glide__slide--photos">
                                                        <img data-lazy="/images/liveaboard-img-3.jpg">
                                                    </div>
                                                    <div class="glide__slide--photos">
                                                        <img data-lazy="/images/liveaboard-img-4.jpg">
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <div class="explore-card--details">
                                                <h4>Bali Aggressor II</h4>
                                            </div>
                                            <div class="explore-card--footer">
                                                <div class="footer--details w-100">
                                                    <div class="row mb-2">
                                                        <div class="col-md-12">
                                                            <div class="details-price">
                                                                <small>Packages from</small><br>
                                                                <h5 class="mb-0"><span class="font-size-sm">$</span> 872 <span class="font-size-sm font-weight-normal">/person</span></h5>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="d-block">
                                                        <small class="d-block"><i class="fas fa-map-marker-alt fas-fix mr-1 text-secondary"></i>West Island, Papua - Indonesia</small>
                                                        <small class="d-block"><i class="fas fa-swimmer fas-fix mr-1 text-secondary"></i>Including 20-22 dives</small>
                                                        <small class="d-block"><i class="fas fa-calendar fas-fix mr-1 text-secondary"></i>29 Feb - 7 Mar 2020</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="explore-card--action text-center">
                                                <a href="liveaboards" class="btn btn-primary mb-2 btn-block">View Details</a>
                                                <div class="btn btn-link btn-sm mb-1">Remove from wishlist</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Wishlist Dive Center -->
                        <div class="d-block mb-4">
                            <h5 class="panel-title panel-title-sm d-block mb-4">Dive Center</h5>
                            <div class="empty-content bg-white"><h6 class="mb-0 text-muted text-sm">No data avalaible...</h6></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FOOTER -->
<%-include ../partial/footer %>