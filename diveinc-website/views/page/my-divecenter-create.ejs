        ($('#inputDestination').val().length == "" ? listIncomplete.push({inputId:"inputDestination",message:"Destination cannot be blank"}) : '' );
        ($('#inputSubDestination').val().length == "" ? listIncomplete.push({inputId:"inputSubDestination",message:"Sub Destination cannot be blank"}) : '' );
