    function deleteUnavailableDates(id){
        let temp = [];
        dataUnavailableDates : dataUnavailableDates.filter(function( obj ) {
            if(obj.id !== id){
                temp.push({...obj});
            }
        })

        dataUnavailableDates = [];
        dataUnavailableDates = temp;
        console.log('ddus',dataUnavailableDates);

        $(`#divUD-${id}`).remove();
        // loadUnavailableDates()
    }

    function countDays(udId){
        let t1 = $(`#unavailableDatesStart-${udId}`).val();
        let t2 = $(`#unavailableDatesEnd-${udId}`).val();

        // dateFormatForDB
        if (t1 != '' && t2 != '') {
            let tgl1 = new Date(t1)                
            let tgl2 = new Date(t2)
            let diff = tgl2.getTime() - tgl1.getTime()
            if (diff >= 0) {
                var days = Math.ceil(diff / (1000 * 3600 * 24)); 
                let text = (parseInt(days+1) == 1 ? ' day off' : ' days off')
                console.log(days + ' days off');
                $(`#daysInfo-${udId}`).text((parseInt(days) + 1)+text );                
            }else{
                Swal.fire(
                    'Oops!',
                    `'From' date is bigger than 'To' date.`
                )
            }
        }
    }
    


    
