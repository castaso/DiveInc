<div class="modal" id="modalSetHighlight" tabindex="-1" role="dialog"aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-header">
                <span class="font-weight-bold">Set Highlight</span>
            </div>
            <div class="modal-body">
                <small hidden>Max 140 Characters per input</small>
                <div id="listHighlightModal"></div>
            </div>
            <div class="modal-footer">
                <button onClick="addHighlightItem()" type="button" class="btn btn-outline-primary"><i class="fas fa-plus mr-2"></i>Add new</button>
                <button type="button" onClick="populateHighlight()" class="btn btn-outline-primary float-right">Done</button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="modalSetUnavailableDates" tabindex="-1" role="dialog"aria-hidden="true" data-backdrop="static" data-keyboard="false">
