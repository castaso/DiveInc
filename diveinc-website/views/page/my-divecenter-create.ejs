<script>

    var id = "<%= id %>"

    var dataCountry = {}
    var dataDestination = {}
    var dataSubDestination = {}

    var canPublish = false

    initData()

    var dataHighlight = []
    var dataImage = [
        // {
        //     id: '21423534523982',
        //     baseUrl: 'https://cache.desktopnexus.com/',
        //     url : 'https://cache.desktopnexus.com/thumbseg/2318/2318166-bigthumbnail.jpg',
        //     path : 'thumbseg/2318/2318166-bigthumbnail.jpg'
        // }
    ]
    var dataIdeal = []
    var dataLanguage = []
    var dataUnavailableDates = [];

    var statusPublishDivecenter = false;
    var totalAktif= 0;
    var totalNonAktif = [];


    $(document).ready(function(){

        $('#inputCountry').change(function(){
            getDestination()
        })

        $('#inputDestination').change(function(){
            getSubDestination()
        })

        $(`#saveHighlight`).click(function(){
          if($('#inputHighlight').val().length > 0){
            addHighlight();
          }else{
            // alert("Form not valid")
            Swal.fire(
                'Oops!',
                'Write the highlight resort then press "add item" button.'
            )
          }
        })

        $(`#customFile`).on(`change`, function(){

          makeFileRequestUpload('/api/upload/image', [], this.files).then((result) => {
              console.log(result)
          }, (error) => {
              console.error(error)
          })
        });

        $(document).on("focus", ".unavailableDatePicker", function(){
            $(this).datepicker({
                // format: "yyyy-mm-dd",
                format: "dd MM yyyy",
                todayHighlight: true,
                autoclose: true
            });
        });
    })

    function initData() {
        if(id){
            $(".formTitle").text('Edit');
            $('#cardSave').hide()
            $('#layoutDivecenterPackage').show()
            $('#divecenterButton').show()
            $('#divecenterButtonBottom').show()
            loadResortById()
        }else{
            $('#cardSave').show()
            $('#layoutDivecenterPackage').hide()
            $('#divecenterButton').hide()
            $('#divecenterButtonBottom').hide()
            //console.log("naha asup dieu")
            getIdeal()
            getLanguage()
            getCountry()
        }
    }

    function loadResortById() {
        $('#listDivecenterEmpty').show();
        $.ajax({
            url: `/api/divecenter/${id}`,
            method: `GET`,
            success: function (result) {
