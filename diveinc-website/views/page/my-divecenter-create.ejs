                            title: "Reminder",
                            html: html,
                            icon: "warning",
                            confirmButtonText: 'Yes',
                            showCancelButton : true,
                        }).then(function(isConfirm) {
                            if (isConfirm.value) {
                                $("#overlay-loader").removeClass('d-none');
                                publishData();
                            }
                        }) 
                    }else{
                        publishData();
                    }
                    
                }else{
                    // alert("You cant publish this resort , please complete the data")
                    Swal.fire(
                        'Please create dive package.',
                        'In order to publish your divecenter, the divecenter must have dive package.'
                    )
                }
            }
            
        }
    }

    function publishData(){
        $.ajax({
            url: `/api/divecenter/${id}`,
            method: `PUT`,
            data: {
                publish : true,
                profile : {
                    name : $('#inputName').val(),
                    country : {
                        id : $('#inputCountry').val(),
                        name : $('#inputCountry option:selected').text()
                    },
                    destination : {
                        id : $('#inputDestination').val(),
                        name : $('#inputDestination option:selected').text()
                    },
                    sub_destination : {
                        id : $('#inputSubDestination').val(),
                        name : $('#inputSubDestination option:selected').text()
                    },
                    introduction : $('#inputIntroduction').val(),
                    ideal : dataIdeal,
                    language : dataLanguage
                },
                highlight : dataHighlight,
                photos : dataImage,
                unavailable_dates : dataUnavailableDates,
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    // alert("Success")
                    // location.href = `/my-resort-create/${result.data.id}`
                    Swal.fire({
                        title: "Divecenter package status updated!",
                        text: "The package status has changed.",
                        confirmButtonText: 'Great'
                    }).then(function() {
                        window.location.reload()
                    });
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        });
    }

