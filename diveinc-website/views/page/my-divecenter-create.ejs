    function showIncompleteFieldMessage(listIncomplete){
        let earliestInput = "";
        $.each(listIncomplete,function(i,v){
            earliestInput = (i==0 ? v.inputId : earliestInput);
            if(v.inputId !='inputCountry' && v.inputId != 'inputDestination' && v.inputId != 'inputSubDestination' ){
                if(!$(`#${v.inputId}`).parent().hasClass("input-group")){
                    $(`#${v.inputId}`).parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
                }else{
                    $(`#${v.inputId}`).parent().parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
                }
            }else{
                $(`#${v.inputId}`).closest('div').parent().append(`<i class='text-danger text-field-warning' style="font-size:12px; margin-right:10px">*${v.message}</i>`);
            }
        });

        let el = document.getElementById(`${earliestInput}`);
        (earliestInput != '' ? el.scrollIntoView() : '');
    }

    function deletePackageConfirm(packageId, packageName, statusPublish) {
        let text = '';
        if (statusPublishDivecenter && totalAktif == 1 && statusPublish) {
            text = "Since this is the only active package,<br/> this will <b style='color:red'>automatically unpublish your divecenter</b>.";
        }else{
            text = "This will remove this package from list.";
        }

        Swal.fire({
            title: `Delete Package "${packageName}"?`,
            html: text,
            showCancelButton: true,
            confirmButtonColor: '#bd2130',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Delete'
        }).then((respond) => {
            if (respond.value) {
                $("#overlay-loader").removeClass('d-none');
                if (statusPublishDivecenter && totalAktif == 1 && statusPublish ) {
                    unpublishDivecenter(id, packageId+'??'+packageName, 2);
                } else {
                    deletePackage(packageId, packageName,1);
                }
            }
        });
    }

    function deletePackage(packageId, packageName, type){
        let title = ''
        if (type == 1) {
            title=`Package ${packageName} Removed`;
        }else if(type==2){
            title = `Divecenter Unpublished & Package ${packageName} Removed`
        }
        $.ajax({
            url: `/api/package/${packageId}`,
            method: `DELETE`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    Swal.fire({
                        title: title,
                        text: "Success."
                    }).then(function() {
                        location.reload()
                    });
                } else {
                    alert(result.message)
                    console.log(result)
                }
                $("#overlay-loader").addClass('d-none');
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    
    }


    //====================unpublish divecenter===========================
    function unpublishDivecenter(divecenterId, packageId, statusPublish){
        $.ajax({
            url: `/api/divecenter/${divecenterId}/publish`,
            method: `PUT`,
            data : {
                publish : false
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    if (statusPublish == 1) {
                        changePackageStatus(packageId, 4);
                    } else if (statusPublish == 2){
                        let dt = packageId.split('??');
                        deletePackage(dt[0], dt[1],2);   
                    }
                } else {
                    $("#overlay-loader").addClass('d-none');
                    Swal.fire(
                        'Unpublish Divecenter & Package Failed',
                        result.message
                    )
                    //alert(result.message)
                    //console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

