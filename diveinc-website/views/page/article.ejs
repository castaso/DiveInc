<script>
    $(document).ready(function(){
        console.log("hai")
        loadArticle()
    })

    function loadArticle() {
        $.ajax({
            url: `/api/article`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    $('#listArticleLoader').addClass('hideImportant')
                    for(var i = 0; i < result.data.length; i++){
                        $('#listArticle').append(`
                            <a href="/article-read/${result.data[i].id}" class="explore-card--item">
                                <div class="explore-card--content">
                                    <div class="explore-card--image" style="background-image: url('${result.data[i].images[0].url}');">
                                        <div class="explore-card--details">
                                            <div class="text-white d-block mb-3">${result.data[i].article_category.name}, ${result.data[i].created_at}</div>
                                            <h4 class="mb-0">${result.data[i].name}</h4>
                                        </div>
                                        <div class="explore-card--footer">
                                            <div class="btn btn-link text-secondary pl-0 pr-0 text-sm">Read Article</div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        `)
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }
</script>