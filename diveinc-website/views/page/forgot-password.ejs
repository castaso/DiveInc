<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<style>
    .passwordInputIcon{
        position: absolute;
        top: 50px;
        right: 30px;
        cursor: pointer;
        color: #666;
        font-size: 16px;
    }

    #passwordNotification{
        font-size: 12px;
        font-style: italic;
        color: red;
    }
</style>
<div class="header-spacer"></div>
<section class="section section-sm bg-lighter min-100-y">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="d-block w-100 text-center mb-4">
                    <h4 class="m-0">Reset your password here.</h4>
                </div>
                <div class="card shadow-sm border-0 rounded-0">
                    <div class="card-body" id="form-ganti-password">
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FOOTER -->
<%-include ../partial/footer %>

<script>

    const token = "<%= token %>";
    $(document).ready(function(){
        cekTokenResult(token);
    });
    function cekTokenResult(token){
        $.ajax({
            url: `/api/forgot-password-form`,
            method: `GET`,
            data : {
                token : token,
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    $('#form-ganti-password').append(result.data);
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    $('#form-ganti-password').append("Link not valid");
                    console.log(xhr.responseJSON)
                }
            }
        });
    }

    function submitForm(){
        if(validateForm()){
            $.ajax({
                url: `/api/ganti-password/`,
                method: `PUT`,
                data : {
                    password : $('#newpasswordInput').val(),
                    re_password : $('#retypenewpasswordInput').val(),
                    token : token
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        Swal.fire({
                            title: "Password has changed successully",
                            text: "Your user password has updated."
                        }).then(function() {
                            window.location.href = `/`
                        });
                        // location.href = `/checkout-liveaboards/${result.data.id}/reserve`
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
        }
    }

    function validateForm(){
        let password = $('#newpasswordInput').val();
        let re_password = $('#retypenewpasswordInput').val();

        if(password.length >= 8 && password == re_password ){
            return true
        }else if(password.length < 8){
            Swal.fire("Password must more than 8 characters");
            return false
        }else if(password != re_password){
            Swal.fire("Password not match");
            return false
        }
    }

    function typeText(idName){
        $(`#${idName}`).attr('type','text');
        $(`#${idName}Icon`).html(`<i class="fas fa-eye"></i>`);
    }
    function typePassword(idName){
        $(`#${idName}`).attr('type','password');
        $(`#${idName}Icon`).html(`<i class="fas fa-eye-slash"></i>`);
    }
</script>
