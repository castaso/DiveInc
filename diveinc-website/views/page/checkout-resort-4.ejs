                                        </div>
                                    </li> -->
                                </ul>
                                <div class="list-total">
                                    <div class="list-total-item">
                                        <div>Total</div>
                                        <div id="totalSummary"></div>
                                    </div>
                                    <div class="d-none list-total-item">
                                        <div >VAT <span id="vat">10</span>%</div>
                                        <div id="taskTotal"></div>
                                    </div>
                                    <div class="list-total-item">
                                        <div>Total Price*</div>
                                        <div id="totalPrice"></div>
                                    </div>
                                    <div class="text-right"><i style="font-size:0.8em">*Total Price included tax </i></div> 
