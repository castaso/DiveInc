                                                <div>Twin Bungalow [Room 2]</div>
                                            </div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="far fa-user fa-sm fas-fix mr-1"></i>x1</div>
                                            </div>
                                        </div>
                                    </li>
                                    <li class="list-group-item">
                                        <div class="list-person">
