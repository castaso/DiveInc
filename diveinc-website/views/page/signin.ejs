<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<style>
    #passwordInputIcon{
        position: absolute;
        top: 50px;
        right: 30px;
        cursor: pointer;
        color: #666;
        font-size: 16px;
    }
</style>
<div class="header-spacer"></div>
<section class="section section-sm bg-lighter min-100-y">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="d-block w-100 text-center mb-4">
                    <h4 class="m-0">Welcome back!</h4>
                </div>
                <!-- <div class="card shadow-sm border-0 rounded-0 mb-3">
                    <div class="card-body">
                        <button type="button" class="btn btn-neutral btn-block btn-lg btn-flex justify-content-center mb-2"><img src="images/google.svg" width="20" class="mr-2">Signin with Google</button>
                        <button type="button" class="btn btn-facebook btn-block btn-lg btn-flex justify-content-center"><img src="images/facebook.svg" width="20" class="mr-2">Signin with Facebook</button>
                    </div>
                </div>
                <div class="separator-with-text on-bg-lighter"><span>or</span></div> -->
                <div class="card shadow-sm border-0 rounded-0">
                    <div class="card-header">
                        Sign in with email
                    </div>
                    <div class="card-body">
                        <!-- <form> -->
                            <div class="form-row">
                                <div class="col-md-12 mb-4">
                                    <label for="email_address">Email Address</label>
                                    <input id="inputEmail" type="email" class="form-control form-control-lg rounded-0" name="email_address" placeholder="your.email@mail.com"  required>
                                </div>
                                <div class="col-md-12 mb-4" style="position: relative;">
                                    <label for="password">Password</label>
                                    <input id="inputPassword" type="password" class="form-control form-control-lg rounded-0" name="passwrod" placeholder="Enter your password" required>
                                    <span id="passwordInputIcon" onmousedown="typeText()" onmouseup="typePassword()"><i class="fas fa-eye-slash"></i></span>
                                    <a href="reset-password" class="text-sm d-inline-block mt-2">Forgot your password?</a>
                                </div>
                            </div>
                            <button id="buttonLogin" class="btn btn-outline-primary btn-lg-2 btn-block" type="submit">Login</button>

                            <!-- Kondisi ketika loading mau masuk -->
                            <button id="buttonLoginLoading" style="display:none;" class="btn btn-primary btn-lg-2 btn-block" type="submit" disabled>
                                <div class="spinner-border text-white" role="status">
                                    <span class="sr-only">Loading...</span>
                                </div>
                            </button>
                        <!-- </form> -->
                    </div>
                </div>
                <div class="d-block w-100 text-center text-muted my-3">
                    Don't have an account? <a href="signup">Sign up</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FOOTER -->
<%-include ../partial/footer %>

<script>

    $(document).ready(function(){
        
        $('#buttonLogin').click(function(){
            checkLogin()
        });

        var map = {13: false};
        $('#inputEmail, #inputPassword').keypress(function (e) {
	    	if (e.which == 13) {
	        	if($('#inputEmail').val().length > 0 && $('#inputPassword').val().length > 0){
					login();
	        	}else if($('#inputEmail').val().length == 0){
                    $('#inputEmail').focus()
                }else if($('#inputPassword').val().length == 0){
                    $('#inputPassword').focus()
                }
	        }
	    });

    })

    function checkLogin(){
        if(!($('#inputEmail').val().length > 0 && $('#inputPassword').val().length > 0)){
            Swal.fire({
                title: "Oops,",
                text: "Username and password must be filled."
            })
            return false
        }else{
            $('#buttonLogin').hide();
            $('#buttonLoginLoading').show();
            $('#inputPassword, #inputEmail').attr('disabled','disabled');
            login()
            // return true
        }
    }

    function login(){
        $.ajax({
            url: `/api/login/email`,
            method: `POST`,
            data : {
                email : $('#inputEmail').val(),
                password : $('#inputPassword').val(),
            },
            success: function (result) {
                if (result.success) {
                    setCookie(`accessTokenDiveincWebsite`, result.data.accessToken, 1)
                    setCookie(`refreshTokenDiveincWebsite`, result.data.refreshToken, 7)
                    location.href = '/'
                } else {
                    // alert(result.message)
                    // console.log(result)
                    $('#buttonLogin').show();
                    $('#buttonLoginLoading').hide();
                    $('#inputPassword, #inputEmail').removeAttr('disabled','disabled');

                    Swal.fire({
                        title: 'Oops!',
                        text: 'Please re-check the account that you used to sign in. Thank you.',
                        footer: '<small class="text-muted">Email address not registered or your password does not match.</small>'
                    })
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }

                Swal.fire({
                    title: "Oops,",
                    text: "Username and password not match."
                })

                $('#buttonLogin').show();
                $('#buttonLoginLoading').hide();
                $('#inputPassword, #inputEmail').removeAttr('disabled','disabled');
            }
        })
    }

    function setCookie(cname, cvalue, exdays) {
      var d = new Date();
      d.setTime(d.getTime() + (exdays*24*60*60*1000));
      var expires = "expires="+ d.toUTCString();
      document.cookie = cname + "=" + cvalue + ";" + expires + ";path=/";
    }

    function getCookie(cname) {
      var name = cname + "=";
      var decodedCookie = decodeURIComponent(document.cookie);
      var ca = decodedCookie.split(';');
      for(var i = 0; i <ca.length; i++) {
        var c = ca[i];
        while (c.charAt(0) == ' ') {
          c = c.substring(1);
        }
        if (c.indexOf(name) == 0) {
          return c.substring(name.length, c.length);
        }
      }
      return "";
    }

    function typeText(){
        $('#inputPassword').attr('type','text');
        $('#passwordInputIcon').html(`<i class="fas fa-eye"></i>`);
    }
    function typePassword(){
        $('#inputPassword').attr('type','password');
        $('#passwordInputIcon').html(`<i class="fas fa-eye-slash"></i>`);
    }

</script>