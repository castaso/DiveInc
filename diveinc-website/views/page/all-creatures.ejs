<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<div class="header-spacer"></div>
<div class="contribution-banner have-curtain" style="background-image: url('/images/photos-diveinc-4.jpg');">
    <div class="contribution-banner--inner">
        <div class="container">
            <div class="destination-banner--text">
                <div class="welcome-title--text mb-3">
                    <h5 class="color-accent">Curated for You</h5>
                    <h1>Find Out Amazing Creatures</h1>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="section section-sm">
    <div class="container">
        
        <div id="exploreLoader" class="d-flex flex-column justify-content-center align-items-center px-3 py-5 bg-light text-center" style="height:400px;">
            <div class="spinner-border mb-3" role="status">
                <span class="sr-only">Loading...</span>
            </div>
            <div class="text-muted">Please wait...</div>
        </div>
        <div class="explore-card">
            <div class="explore-card--list explore-card--with-text explore-card--25" id="layoutCreature">

            </div>
        </div>

    </div>
</div>

<!-- FOOTER -->
<%-include ../partial/footer-nav %>
<%-include ../partial/footer %>

<script>
    $(document).ready(function(){
        loadCreature()
    })

    function loadCreature(){
        $.ajax({
            url: `/api/creature`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    $('#exploreLoader').addClass('hideImportant')
                    for(var i = 0; i < result.data.length; i++){
                        if(i == 0){
                            $('#layoutCreature').append(`
                                <a href="#" onClick="goTo('${result.data[i].article_id}')" class="explore-card--item">
                                    <div class="explore-card--content shadow-sm">
                                        <div class="explore-card--image" style="background-image: url('${result.data[i].image_background[0].url}');">
                                            <div class="explore-card--text-inside">
                                                <h4 class="mt-0 text-ellipsis">${result.data[i].name}</h4>
                                                <p>${result.data[i].introduction}</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            `)
                        }else{
                            $('#layoutCreature').append(`
                                <a href="#" onClick="goTo('${result.data[i].article_id}')" class="explore-card--item">
                                    <div class="explore-card--content shadow-sm">
                                        <div class="explore-card--image" style="background-image: url('${result.data[i].image_background[0].url}');">
                                            <div class="explore-card--text-inside">
                                                <h4 class="mt-0 text-ellipsis">${result.data[i].name}</h4>
                                                <p>${result.data[i].introduction}</p>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            `)
                        }
                    }

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function goTo(id){
        if(id != null && id != "" && id != "null"){
            location.href = `/article-read/${id}`
        }
    }
</script>