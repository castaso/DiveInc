<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<div class="header-spacer"></div>
<section class="section section-sm bg-lighter min-100-y">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="d-block w-100 text-center mb-4">
                    <h4 class="m-0">Reset your password here.</h4>
                </div>
                <div class="card shadow-sm border-0 rounded-0">
                    <div class="card-body">
                        <form>
                            <div class="form-row">
                                <div class="col-md-12 mb-4">
                                    <label for="email_address">Email Address</label>
                                    <input id="inputEmail" type="email" class="form-control form-control-lg rounded-0" name="email_address" placeholder="your.email@mail.com"  required>
                                </div>
                            </div>
                            <button class="btn btn-outline-primary btn-lg-2 btn-block" type="button" onclick="requestForgetPassword()">Reset Password</button>
                        </form>
                    </div>
                </div>
                <div class="separator-with-text on-bg-lighter"><span>or</span></div>
                <div class="card shadow-sm border-0 rounded-0 mb-3">
                    <div class="card-body">
                        <button type="button" class="btn btn-neutral btn-block btn-lg btn-flex justify-content-center mb-2"><img src="images/google.svg" width="20" class="mr-2">Signup with Google</button>
                        <button type="button" class="btn btn-facebook btn-block btn-lg btn-flex justify-content-center"><img src="images/facebook.svg" width="20" class="mr-2">Signup with Facebook</button>
                    </div>
                </div>
                <div class="d-block w-100 text-center text-muted my-3">
                    Return to <a href="signin">sign in</a>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- FOOTER -->
<%-include ../partial/footer %>

<script type="text/javascript" src="https://cdn.datatables.net/v/bs4-4.1.1/dt-1.10.20/b-1.6.1/sl-1.3.1/datatables.min.js"></script>
<script>

    function requestForgetPassword(){
        if ($('#inputEmail').val() != '') {
            $.ajax({
                url: `/api/forget-password/email`,
                method: `POST`,
                data : {
                    email : $('#inputEmail').val(),
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        Swal.fire({
                            title: "Email has been sent",
                            text: "Please check your email."
                        }).then(function() {
                            window.location.reload()
                        });
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            });
            
        }else{
            Swal.fire({
                title:"Please fill in your email"
            });
        }

    }
</script>
