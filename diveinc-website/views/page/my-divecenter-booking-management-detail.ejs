<script>

    var id="<%= id %>"

    var packageData
    var rooms;
    let guestList = '';
    const monthNamesShort = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
        "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
    

    $(document).ready(function(){
        loadTransactionById()
    });

    function dateFormatF(tanggal){
        if(tanggal != ''){
            let tgl = tanggal.split('-').reverse();
            return tgl[0]+' '+monthNamesShort[tgl[1]-1]+' '+tgl[2];
        }else{
            return tanggal;
        }
    }

    function loadTransactionById(){
        $.ajax({
            url: `/api/transaction-divecenter/${id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    console.log(result.data);
                    packageData = result.data.package_data
                    console.log(packageData);

                    $("#booking-id").html(result.data.id);
                    
                    guestData = '';
                    for (let i = 0; i < packageData.package.length; i++) {

                        for(var j = 0; j < packageData.package[i].packageItem.length; j++){
                            $('#listDataRoom').append(`
                                    <li id="${packageData.package[i].packageItem[j].id}" class="list-group-item">
                                        <div class="list-person">
                                            <div class="list-person--title">
                                                <div>${packageData.package[i].packageName} [Package ${i+1}]</div>
                                                <div>IDR <span id="summaryTotal${packageData.package[i].packageItem[j].id}">${formatRupiah(parseFloat(packageData.package[i].packagePrice))}</span></div>
                                            </div>
                                            <div class="list-person--item text-muted">
                                                <div><i class="far fa-user fa-sm fas-fix mr-1"></i>x${packageData.package[i].packageItem[j].guest}</div>
                                            </div>
                                            <div class="all-extra" id="service${packageData.package[i].packageItem[j].id}"></div>
                                        </div>
                                    </li>
                                `)
                        
                        
                        $("#layoutPackage").append(`<h6 class="m-0 mb-3">${packageData.package[i].packageName}</h6>
                            <div class="departure-information">
                                <div class="departure-information--item">
                                    <h4>Date Trip</h4>
                                    <ul>
                                        <li><i class="far fa-calendar mr-2 fas-fix text-muted"></i>${dateFormatF(packageData.package[i].packageItem[j].package_date)}</li>
                                    </ul>
                                </div>
                            </div>`);

                            guestList = packageData.package[i].packageItem[j].detail_guest;
                            console.log(guestList)
                            for (let g_idx = 0; g_idx < guestList.length; g_idx++) {
                                guestData += `<div class="d-block mt-1">
                                    <div class="text-muted text-sm">Guest ${g_idx+1}</div>
                                    <div>${guestList[i].title}${guestList[i].first_name} ${guestList[i].last_name} - ${guestList[i].nationality}</div>
                                </div>`;
                            }
                            
                            $('#modalGuestDetailBody').append(`<div class="d-block p-3 border mb-3">
                                <div class="font-weight-bolder d-block">${packageData.package[i].packageName}</div>
                                ${guestData}
                            </div>`);
                        }
                        
                    }

                    loadItem()

                    // alert(result.data.transaction_divecenter_status_id);
                    if (result.data.transaction_divecenter_status_id == "b648ff73-468f-45cb-bbbc-fd3659e4b8ac") {
                        $('#btn-action-list').append(`<button onClick="confirm();" class="btn btn-success flex-grow-1 mr-1"><i class="fas fa-check"></i></button>
                                        <button onClick="decline();" class="btn btn-danger flex-grow-1"><i class="fas fa-times"></i></button>`);
                        
                    }

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

