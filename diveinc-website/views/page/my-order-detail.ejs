<!-- HEADER -->
<%-include ../partial/header %>
<%-include ../partial/header-nav-2 %>
<!-- Modal Guest Detail -->
<div class="modal" id="modalGuestDetail" tabindex="-1" role="dialog"aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-body" id="modalBodyGuestDetail">
                <div class="d-block mb-3">
                    <h5 class="flex-shrink-0">Guest Detail</h5>
                </div>
                
            </div>
            <div class="modal-footer justify-content-end">
                <div>
                    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Modal Cancel Booking -->
<div class="modal" id="modalCancelBooking" tabindex="-1" role="dialog"aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content rounded-0 border-0">
            <div class="modal-body">
                <div class="d-block mb-3">
                    <h4 class="flex-shrink-0 mb-2">Cancel your order?</h4>
                    <p class="mb-1">Please tell us the reason why you canceled this order.</p>
                    <div class="d-block p-2 border bg-lighter">
                        <p class="text-xs text-muted m-0">This info is very important for us to improve in the future. Thank you.</p>
                    </div>
                    <form class="d-block mt-2">
                        <div class="select-card-wrapper">
                            <div class="select-card select-card-inherit select-card-naked select-card-inline">
                                <label class="select-card-inner select-card-inner-h">
                                    <input type="checkbox" class='cancel-reason' name="cancel-reason"  value='Waiting too long for the confirmation'/>
                                    <div class="select-card-content">
                                        <h6 class="mb-0 font-weight-normal">Waiting too long for the confirmation</h6>
                                    </div>
                                    <div class="select-card-checkbox"></div>
                                </label>
                            </div>
                        </div>
                        <div class="select-card-wrapper">
                            <div class="select-card select-card-inherit select-card-naked select-card-inline">
                                <label class="select-card-inner select-card-inner-h">
                                    <input type="checkbox" class='cancel-reason' name="cancel-reason" value='Change schedule'/>
                                    <div class="select-card-content">
                                        <h6 class="mb-0 font-weight-normal">Change schedule</h6>
                                    </div>
                                    <div class="select-card-checkbox"></div>
                                </label>
                            </div>
                        </div>
                        <div class="select-card-wrapper">
                            <div class="select-card select-card-inherit select-card-naked select-card-inline">
                                <label class="select-card-inner select-card-inner-h">
                                    <input type="checkbox" class='cancel-reason' name="cancel-reason" value='Change guest'/>
                                    <div class="select-card-content">
                                        <h6 class="mb-0 font-weight-normal">Change guest</h6>
                                    </div>
                                    <div class="select-card-checkbox"></div>
                                </label>
                            </div>
                        </div>
                        <textarea class="form-control d-block mt-2" id='other-cancel-reason' placeholder="Please tell us another reason you canceled this order..."></textarea>
                        <hr/>
                        <p class="mb-3 bank-info">Inform us your Bank Account.<br/>
                            <small class="text-xs text-muted m-0">*Please read terms and condition about our refund policy.</small>
                        </p>
                        
                        <div class="form-row mb-0 bank-info">
                            <label for="bank_name" class="col-sm-3 col-form-label">Bank</label>
                            <div class="col-sm-9">
                                <input id="inputBank" type="text" class="form-control rounded-0 text-capitalize" name="bank" placeholder="Bank Name" required>
                            </div>
                        </div>
                        <div class="form-row mb-0 bank-info">
                            <label for="account_number" class="col-sm-3 col-form-label">Account No.</label>
                            <div class="col-sm-9">
                                <input id="inputAccountNumber" type="text" class="form-control rounded-0 text-capitalize" name="account_number" placeholder="Account Number" required>
                            </div>
                        </div>
                        <div class="form-row mb-4 bank-info">
                            <label for="account_name" class="col-sm-3 col-form-label">Account Name</label>
                            <div class="col-sm-9">
                                <input id="inputAccountName" type="text" class="form-control rounded-0 text-capitalize" name="account_name" placeholder="Account Name" required>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer justify-content-end">
                <div>
                    <button type="button" class="btn btn-link" data-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-neutral" onclick="cancelOrder()" data-dismiss="modal">Submit & Cancel Order</button>
                </div>
            </div>
        </div>
    </div>
</div>
