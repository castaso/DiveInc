                                                            <input id="inputExtraRoom-${rooms[j].service[k].id}-${roomItem[x].id}" type="text" class="form-control input-number text-center" value="${(typeof pService[rooms[j].service[k].id] !== 'undefined' ? pService[rooms[j].service[k].id] : 0)}">
