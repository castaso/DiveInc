            success: function (result) {
                if (result.success) {
                    console.log(result)
                    $('#checkoutCover, #checkout2Loader').addClass('hideImportant');

                    packageData = result.data.package_data
                    rooms = result.data.liveaboard.rooms
                    packages = result.data.liveaboard.packages
                    let packageListGuest = result.data.package_data.package;
                    // console.log('pc1',packageListGuest[0].service);
