                    $('.resortLocation').text(`${result.data.liveaboard.profile.sub_destination.name} - ${result.data.liveaboard.profile.destination.name}, ${result.data.liveaboard.profile.country.name}`)
                    
                    for (let p_idx = 0; p_idx < result.data.liveaboard.packages.length; p_idx++) {
                        packageList[result.data.liveaboard.packages[p_idx].id] = result.data.liveaboard.packages[p_idx].info.duration 
                        packageListData[result.data.liveaboard.packages[p_idx].id] = result.data.liveaboard.packages[p_idx];
                    }

                    for (let p_idx = 0; p_idx < packageData.package.length; p_idx++) {
