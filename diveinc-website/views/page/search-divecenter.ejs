<script>
    $('#toggleFiltering').click(function(){
        $('#filteringPanel').addClass('active');
    })
    $('.finishFiltering').click(function(){
        $('#filteringPanel').removeClass('active');
    })
</script>
<script>
    let destinationList;
    let destination_id = '';
    let subdestination_id='';
    $(document).ready(function(){
       loadPackagePublish()
       importDestination()
    })

    function importDestination(){
        $.ajax({
            url: `/api/destination`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    destinationList = result.data;
                    for (let d_idx = 0; d_idx < destinationList.length; d_idx++) {
                        $("#destination-select").append(`<option value="${destinationList[d_idx].id}">${destinationList[d_idx].name}</option>` );            
                        // console.log(destinationList[d_idx].id);
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    
    }

    function loadPackagePublish(){
        $.ajax({
            url: `/api/divecenter/publish?destination=${destination_id}&sub_destination=${subdestination_id}`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    
                    $('#listDivecenterLoader').addClass('hideImportant')
                    
                    for(var i = 0; i < result.data.length; i++){

                        var htmlPhotos = ``
                        var dataPhotos = result.data[i].photos
                        for(var j = 0; j < dataPhotos.length; j++){
                            htmlPhotos += `
                                <div class="glide__slide--photos" style="background-image: url('${dataPhotos[j].url}');">
                                   
                                </div>
                            `
                        }

                        var pricePackage = "0"
                        let dvcShow =  false;
                        var dive_pack = 0;
                        var dataPackage = result.data[i].packages
                        for(var j = 0; j < dataPackage.length; j++){
                            if (dataPackage[j].active && dataPackage[j].publish) {
                                dvcShow = true;
                                if(parseFloat(pricePackage) == 0){
                                    if(dataPackage[j].price.discount != "" && dataPackage[j].price.discount != "0" && dataPackage[j].price.discount != 0 && dataPackage[j].price.discount != "NaN" ){
                                        pricePackage = dataPackage[j].price.discount
                                    }else{
                                        pricePackage = dataPackage[j].price.price
                                    }
                                            dive_pack = dataPackage[j].info.dive_total
                                }else{
                                    if(dataPackage[j].price.discount != "" && dataPackage[j].price.discount != "0" && dataPackage[j].price.discount != 0 && dataPackage[j].price.discount != "NaN" ){
                                        if(parseFloat(pricePackage) > parseFloat(dataPackage[j].price.discount)){
                                            pricePackage = dataPackage[j].price.discount
                                            dive_pack = dataPackage[j].info.dive_total
                                        }
                                    }else {
                                        if(parseFloat(pricePackage) > parseFloat(dataPackage[j].price.price)){
                                            pricePackage = dataPackage[j].price.price
                                            dive_pack = dataPackage[j].info.dive_total
                                        }
                                    }
                                }        
                            }
                        }

                        if (dvcShow) {
                            $('#listPackage').append(`
                                <div class="explore-card--item">
                                    <div class="explore-card--content shadow-sm">
                                        <div class="d-block">
                                            <span class="badge-photos badge badge-dark badge-pill rounded">3 Photos</span>
                                            <div class="slick2">
                                                ${htmlPhotos}
                                            </div>
                                        </div>
                                        
                                        <div class="explore-card--details">
                                            <h4>${result.data[i].profile.name}</h4>
                                        </div>
                                        <div class="explore-card--footer">
                                            <div class="footer--details w-100">
                                                <div class="row mb-2">
                                                    <div class="col-md-12">
                                                        <div class="details-price">
                                                            <small>Packages from </small><br>
                                                            <h5 class="mb-0"><span class="font-size-sm">IDR</span> ${formatRupiah(pricePackage)} <span class="font-size-sm font-weight-normal">/person</span></h5>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="d-block">
                                                    <small class="text-ellipsis"><i class="fas fa-map-marker-alt mr-1"></i>${result.data[i].profile.sub_destination.name}, ${result.data[i].profile.destination.name} - ${result.data[i].profile.country.name}</small>
                                                    <small class="d-block"><i class="fas fa-swimmer fas-fix mr-1 text-secondary"></i>Including ${dive_pack} dives</small>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="explore-card--action">
                                            <a href="/divecenter/${result.data[i].id}" class="btn btn-primary mb-2 btn-block">View Details</a>
                                        </div>
                                    </div>
                                </div>
                            `)
                        
                            
                        }
                    }

                    $('.slick2').slick({
                        infinite: false
                    });
                    // $('.slick').on('lazyLoaded', function (e, slick, image, imageSource) { 
                    //     image.parent().css('background-image', 'url("' + imageSource + '")'); 
                    //     image.hide(); 
                    // });

                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    $("#destination-select").change(function(){
        destination_id = $(this).val();
        loadSubDestination();
    });

    $("#filterDestination").click(function(){
        destination_id = $("#destination-select").val();
        subdestination_id = $("#sub-destination-select").val();
        $('#listDivecenterLoader').removeClass('hideImportant')
        $('#listPackage').html('');
        loadPackagePublish()

    });
    function loadSubDestination(){
        if (destination_id != '') {
            $.ajax({
                url: `/api/sub-destination/${destination_id}/destination`,
                method: `GET`,
                success: function (result) {
                    if (result.success) {
                        console.log(result)
                        $("#sub-destination-select").html('');
                        let subdestinationList = result.data;
                        $("#sub-destination-select").append(`<option value="">All</option>` );
                        for (let d_idx = 0; d_idx < subdestinationList.length; d_idx++) {
                            $("#sub-destination-select").append(`<option value="${subdestinationList[d_idx].id}">${subdestinationList[d_idx].name}</option>` );
                        }
                    } else {
                        
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {

                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })            
        }else{
            $("#sub-destination-select").html('');
            $("#sub-destination-select").append(`<option value="">All</option>` );
        }
    }

</script>