    function saveProfile(){
        let tlp = $('#inputPhone').val();
        if (!phoneFilter(tlp)) {
            return Swal.fire(
                'Invalid Phone Format', 'Please use your country codes first'
            )
        }
        $(".my-info").prop('readonly', true)

        if (isEdit) {
            $.ajax({
                url: `/api/my-profile/save-info`,
                method: `POST`,
                data: {
                    first_name : $('#inputFirstName').val(),
                    last_name : $('#inputLastName').val(),
                    phone : $('#inputPhone').val()
                },
                success: function (result) {
                    if (result.success) {
                        alert(result.message)
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
        }else{
            Swal.fire(
                'Info',
                'Please Click Edit First.'
            )
        }
    }

    function saveBankInfo(){
        $.ajax({
            url: `/api/my-profile/save-wallet`,
            method: `POST`,
            data: {
                bank_name : $('#inputBank').val(),
                account_name : $('#inputAccountName').val(),
                account_number : $('#inputAccountNumber').val()
            },
            success: function (result) {
                if (result.success) {
                    alert(result.message)
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function withdrawl(){
        if(checkBalance()){
            console.log("mantap")
            $.ajax({
                url: `/api/withdrawl`,
                method: `POST`,
                data: {
                    type : 'user-withdrawl',
                    total : $('#inputTotal').val()
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        alert(result.message)
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
        }
    }
    
    function requestWithdrawl(creatorTypeId){
        let valBalance = $(`#inputBalance-${creatorTypeId}`).val();
        let namaBank = $(`#inputBank-${creatorTypeId}`).val();
        let accountNumber = $(`#inputAccountNumber-${creatorTypeId}`).val();
        let accountName = $(`#inputAccountName-${creatorTypeId}`).val();
        let totalWithdrawl = $(`#totalWithdrawl-${creatorTypeId}`).val();
        console.log(valBalance, namaBank,accountNumber,accountName,totalWithdrawl);
        if(checkBalance2(valBalance, totalWithdrawl)){
            console.log("mantap")
            Swal.fire({
                title: "Confirmation",
                html: `<span style='font-size:1.2em'>You will withdraw <b>${formatRupiah(totalWithdrawl)}</b> from your balance.</span><br/><small>This withdrawal will charge you IDR ${formatRupiah(5500)} fee.</small>`,
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'OK'
            }).then((respond) => {
                if (respond.value) {
                    if(parseFloat(valBalance) >= parseFloat(totalWithdrawl)){
                        $("#overlay-checkout").removeClass('d-none');
                        $.ajax({
                            url: `/api/withdrawl`,
                            method: `POST`,
                            data: {
                                type : 'user-withdrawl',
                                creator_type_id : creatorTypeId,
                                user_data : {
                                    balance : valBalance,
                                    bank_name : namaBank,
                                    bank_account_number : accountNumber,
                                    bank_account_name : accountName
                                },
                                total : totalWithdrawl
                            },
                            success: function (result) {
                                console.log(result)
                                if (result.success) {
                                    Swal.fire({
                                        title: "Request Submitted!",
                                        text: "Request for your withdrawl has been submitted, please wait 1x24 hours (on weekdays) ",
                                        confirmButtonText: 'Close'
                                    }).then(function() {
                                        window.location.reload();
                                    });
                                    // alert(result.message)
                                } else {
                                    alert(result.message)
                                    console.log(result)
                                }
                                $("#overlay-checkout").addClass('d-none');
                            },
                            error(xhr, status, error) {
                                if(xhr.responseJSON){
                                    console.log(xhr.responseJSON)
                                }
                                Swal.fire(
                                    'Failed',
                                    'Withdrawal failed.'
                                )
                                $("#overlay-checkout").addClass('d-none');
                            }
                        })
                    }else{
                        Swal.fire("Insufficient Balance", "Your balance is insufficient")
                    }
                }
            });
            
        }else{
            Swal.fire("Insufficient Balance", "Your balance is insufficient")
        }
    }

