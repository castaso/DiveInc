<script>

    var dataBalance;
    let walletList = {};
    var isEdit = false;

    $(document).ready(function() {
        loadProfile()
    });

    function loadProfile() {
        $.ajax({
            url: `/api/my-profile`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    $('#inputEmail').val(result.data.profile.contact.email)
                    $('#inputFirstName').val(result.data.profile.name.first_name)
                    $('#inputLastName').val(result.data.profile.name.last_name)
                    $('#inputPhone').val(result.data.profile.contact.phone)

                    $('#inputBalance').val(result.data.profile.wallet.balance)
                    $('#inputBank').val(result.data.profile.wallet.bank_name)
                    $('#inputAccountNumber').val(result.data.profile.wallet.account_number)
                    $('#inputAccountName').val(result.data.profile.wallet.account_name)

                    dataBalance = result.data.profile.wallet
                    let dataPermission = result.data.profile.permission;
                    for (let w_idx = 0; w_idx < dataPermission.length; w_idx++) {
                        let dataUser = dataPermission[w_idx].data.user;
                        
                        if( dataPermission[w_idx].creator_status_id == '59cfbb65-e7cf-4d25-aae1-b439efa62188'  ){
                            $("#listWallet").append(`<div class="card shadow-sm border-0 rounded-0 mb-3">
                                <div class="card-body" >
                                    <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-4">
                                        <div class="d-flex align-items-center">
                                            <h5 class="m-0 mr-2">Wallet ${typeof dataPermission[w_idx].type !== "undefined" ? dataPermission[w_idx].type : "" }</h5>
                                        </div>
                                    </div>
                                    <div class="card rounded-0 mb-3">
                                        <div class="card-body p-3">
                                            <div class="d-flex card-column-1">
                                                <div class="w-25 border-right mr-3">
                                                    <h6 class="d-block mb-4">Profile</h6>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="form-row mb-3">
                                                        <label for="name" class="col-sm-3 col-form-label">Name</label>
                                                        <div class="col-sm-9">
                                                            <input id="name-${dataPermission[w_idx].creator_type_id}" type="text" class="form-control rounded-0 text-capitalize" name="name" readonly value="${typeof dataUser !== "undefined" && typeof dataUser.name != "undefined" ? dataUser.name : ""}" required>
                                                        </div>
                                                    </div>
                                                    <div class="form-row mb-3">
                                                        <label for="phone_number" class="col-sm-3 col-form-label">Phone</label>
                                                        <div class="col-sm-9">
                                                            <input id="name-${dataPermission[w_idx].creator_type_id}" type="text" class="form-control rounded-0 text-capitalize" name="phone_number" readonly value="${typeof dataUser !== "undefined" && typeof dataUser.phone_number != "undefined" ? dataUser.phone_number : ""}" required>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card rounded-0 mb-3">
                                        <div class="card-body p-3">
                                            <div class="d-flex card-column-1">
                                                <div class="w-25 border-right mr-3">
                                                    <h6 class="d-block mb-4">Wallet</h6>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="form-row mb-3">
                                                        <label for="balance" class="col-sm-3 col-form-label">Balance</label>
                                                        <div class="col-sm-9">
                                                            <input id="inputBalance-${dataPermission[w_idx].creator_type_id}" type="number" class="form-control rounded-0 mb-1" name="balance" readonly value="${typeof dataUser !== "undefined" && typeof dataUser.balance !== "undefined" ? dataUser.balance : 0 }" required>
                                                        </div>
                                                    </div>
                                                    <div class="form-row mb-3">
                                                        <label for="bank" class="col-sm-3 col-form-label">Bank</label>
                                                        <div class="col-sm-9">
                                                            <input id="inputBank-${dataPermission[w_idx].creator_type_id}" type="text" class="form-control rounded-0 text-capitalize" name="bank" readonly value="${typeof dataUser !== "undefined" && typeof dataUser.bank_account_name != "undefined" ? dataUser.bank_name : '' }" required>
                                                        </div>
                                                    </div>
                                                    <div class="form-row mb-3">
                                                        <label for="account_number" class="col-sm-3 col-form-label">Account Number</label>
                                                        <div class="col-sm-9">
                                                            <input id="inputAccountNumber-${dataPermission[w_idx].creator_type_id}" type="text" class="form-control rounded-0 text-capitalize" name="account_number" readonly value="${typeof dataUser !== "undefined" && typeof dataUser.bank_account_number != "undefined" ? dataUser.bank_account_number : ''}" required>
                                                        </div>
                                                    </div>
                                                    <div class="form-row mb-3">
                                                        <label for="account_name" class="col-sm-3 col-form-label">Account Name</label>
                                                        <div class="col-sm-9">
                                                            <input id="inputAccountName-${dataPermission[w_idx].creator_type_id}" type="text" class="form-control rounded-0 text-capitalize" name="account_name" readonly value="${typeof dataUser !== "undefined" && typeof dataUser.bank_account_name != "undefined" ? dataUser.bank_account_name : ""}" required>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="card rounded-0">
                                        <div class="card-body p-3">
                                            <div class="d-flex card-column-1">
                                                <div class="w-25 border-right mr-3">
                                                    <h6 class="d-block mb-4">Withdrawl</h6>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="form-row mb-3">
                                                        <label for="resort_name" class="col-sm-3 col-form-label">Total Withdrawl</label>
                                                        <div class="col-sm-9">
                                                            <input id="totalWithdrawl-${dataPermission[w_idx].creator_type_id}" type="number" class="form-control rounded-0 text-capitalize" name="withdrawl" placeholder="Total" required>
                                                        </div>
                                                    </div>
                                                    <div class="form-row">
                                                        <div class="col-md-12">
                                                            <a href="#" onClick="requestWithdrawl('${dataPermission[w_idx].creator_type_id}')" class="btn btn-outline-primary" aria-disabled="true">Request Withdrawl</a>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                        </div>
                                    </div>
                                </div>
                            </div>`);
                        }
                    }

                } else {
                    alert(result.message)
