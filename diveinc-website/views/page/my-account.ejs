    function checkPasswordChar(){
        let pass = $('#password').val();
        let cekLetter = pass.replace(/[0-9]/g, '');
        if(pass.length < 8){
            $("#passwordNotification").html("*Minimum password is 8 characters long");
            return false
        }else if(cekLetter.length == 1){
            $("#passwordNotification").html("*Password must contain both uppercase and lowercase letters");
            return false
        }else if(/^\d+$/.test(pass)){
            $("#passwordNotification").text("*Password must contain letters");
            return false
        }else if(/\d/.test(pass) == false){
            $("#passwordNotification").text("*Password must contain a number");
            return false
        }else if (pass.toLowerCase() === pass) {
            $("#passwordNotification").html("*Password must contain a uppercase letter");
            return false
        }else if(pass.toUpperCase() === pass){
            $("#passwordNotification").text("*Password must contain an lowercase letter");
            return false
        }else{
            return true;
        }
        
    }

</script>
