                                                <input id="password" type="password" class="form-control rounded-0 text-capitalize" name="new_password" placeholder="New password" required>
                                                <span class='passwordViewIcon' id="passwordIcon" onmousedown="typeText('password')" onmouseup="typePassword('password')"><i class="fas fa-eye-slash"></i></span>
                                                <small id='passwordNotification' class='passwordNotification'></small>
                                            </div>
                                        </div>
                                        <div class="form-row">
                                            <label for="confirm_new_password" class="col-sm-3 col-form-label">Confirm New Password</label>
                                            <div class="col-sm-9" style="position: relative;">
                                                <input id="rePassword" type="password" class="form-control rounded-0" name="confirm_new_password" placeholder="Confirm new password">
                                                <span class='passwordViewIcon' id="rePasswordIcon" onmousedown="typeText('rePassword')" onmouseup="typePassword('rePassword')"><i class="fas fa-eye-slash"></i></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-end">
                <div>
                    <button type="button" class="btn btn-primary mr-2" onclick="changePassword()" >Save Changes</a>
                    <button type="button" class="btn btn-neutral" data-dismiss="modal">Close</a>
                </div>
            </div>
        </div>
    </div>
</div>


