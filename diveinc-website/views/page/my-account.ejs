                            <div class="card-body p-3">
                                <div class="d-flex">
                                    <div class="w-25 border-right mr-3">
                                        <h6 class="d-block mb-4">Change Password</h6>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="form-row mb-3">
                                            <label for="old_password" class="col-sm-3 col-form-label">Old Password</label>
                                            <div class="col-sm-9" style="position: relative;">
                                                <input id="oldPassword" type="password" class="form-control rounded-0 mb-1" name="old_password" placeholder="Old Password" required>
