    function changePassword(){
        // oldPassword
        // password
        // confirmpassword

        // fungsi cek password 
        if (checkPasswordChar()) {
            // alert('sukses');
            let ts = {
                old_password : $('#oldPassword').val(),
                password : $('#password').val(),
                re_password : $('#rePassword').val(),
            }
            // console.log(ts)
            $.ajax({
                url: `/api/change-password`,
                method: `PUT`,
                data : ts,
                success: function (result) {
                    if (result.success) {
                        // return true
                        return Swal.fire({
                            title: "Success",
                            text: "Your password is changed.",
                        }).then(function(){
                            window.location.reload();
                        })
                    } else {
                        return Swal.fire({
                            title: "Failed",
                            text: result.message,
                        })
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                        console.log(status)
                        console.log(error)
                    }

                    return Swal.fire({
                        title: "Failed",
                        text: xhr.responseJSON.message,
                    })
                }
            })
        }

    
    }

