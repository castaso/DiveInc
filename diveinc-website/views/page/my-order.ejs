                                    <button style="margin-left: 10px;" onclick="filterType('resort')" id="btn-resort" class="btn-filter">RESORT <span style="font-size: 0.9em;" class='jml'></span></button>
                                    <button style="margin-left: 10px;" onclick="filterType('divecenter')" id="btn-divecenter" class="btn-filter">DIVECENTER <span style="font-size: 0.9em;" class='jml'></span></button>
