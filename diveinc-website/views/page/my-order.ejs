<script>
    
    let statusTransaction = [];
    let colorTransaction = []
    let cancelLink = '';
    let orderData ="";
    var orderList = [];
    var orderFiltered = [];
    var idxShow = 0;


    statusTransaction['c7999dce-19b7-4bfd-84cc-d2f0845a3d86'] = 'Created'
    statusTransaction['d2f95bbe-159b-4447-9e07-33925e04c5e9'] = 'Created'
    statusTransaction['59cfbb65-efff-4d25-aae1-b439efa62188'] = 'Created'
    // statusTransaction['d2f95bbe-159b-4447-9e07-33925e04c5e9'] = 'Scheduled'
    // statusTransaction['59cfbb65-efff-4d25-aae1-b439efa62188'] = 'Extra data'

    statusTransaction['b648ff73-468f-45cb-bbbc-fd3659e4b8ac'] = 'Ordered'
    statusTransaction['b648ff73-468f-45cb-babc-fd3459e4b8ac'] = 'Reserved'
    statusTransaction['bbb8ff73-468f-45cb-babc-fd3444e4b8ac'] = 'Approved'
    statusTransaction['bcc8ff73-468f-45cb-babc-fd34cce4b8ac'] = 'Rejected'
    statusTransaction['bcc8ff37-468f-45cb-bccc-fd34cce4b8ac'] = 'Transfered'
    statusTransaction['baa8ff37-468f-45cb-bccc-fd34aae4b8ac'] = 'Done'
    statusTransaction['baa8ff37-468f-455b-b5c5-fc34aae4b8ac'] = 'Cancelled'

    //created
    colorTransaction['c7999dce-19b7-4bfd-84cc-d2f0845a3d86'] = '#2793f2'
    colorTransaction['d2f95bbe-159b-4447-9e07-33925e04c5e9'] = '#2793f2'
    colorTransaction['59cfbb65-efff-4d25-aae1-b439efa62188'] = '#2793f2'

    //biru muda kaya di logo
    colorTransaction['b648ff73-468f-45cb-bbbc-fd3659e4b8ac'] = '#8dbae0'
    colorTransaction['b648ff73-468f-45cb-babc-fd3459e4b8ac'] = '#8dbae0'
    
    //approved .. ttetep warna orange
    colorTransaction['bbb8ff73-468f-45cb-babc-fd3444e4b8ac'] = '#f0ad4e'

    //rejected kuning lemon
    colorTransaction['bcc8ff73-468f-45cb-babc-fd34cce4b8ac'] = '#FFF44F'
    colorTransaction['bcc8ff37-468f-45cb-bccc-fd34cce4b8ac'] = 'Transfered'
    
    //done
    colorTransaction['baa8ff37-468f-45cb-bccc-fd34aae4b8ac'] = '#befabe'
    colorTransaction['baa8ff37-468f-455b-b5c5-fc34aae4b8ac'] = '#DDDDDD'


    $(document).ready(function(){
        loadOrder();
    });
    
    function loadOrder(){
        $.ajax({
            url: `/api/my-order/`,
            method: `GET`,
            success: function (result) {
                if (result.success) {
                    let totalAll = 0;
                    for (let i = 0; i < result.data.length; i++) {
                        totalAll += result.data[i].data.length;
                        for (let j = 0; j < result.data[i].data.length; j++) {
                            let pData = null;
                            let statusId = null;
                            let link = '';
                            let buttonCancel = '';
                            if (result.data[i].type=="resort") {
                                pData = result.data[i].data[j].resort;
                                statusId = result.data[i].data[j].transaction_resort_status_id;
                                link = 'checkout-resort';
                                cancelLink = `/transaction-resort/${result.data[i].data[j].id}/cancel`
                            }else if (result.data[i].type=="divecenter") {
                                pData = result.data[i].data[j].divecenter;
                                statusId = result.data[i].data[j].transaction_divecenter_status_id
                                link = 'checkout-divecenter';
                                cancelLink = `/transaction-divecenter/${result.data[i].data[j].id}/cancel`
                            }else if (result.data[i].type=="liveaboard") {
                                pData = result.data[i].data[j].liveaboard;
                                statusId = result.data[i].data[j].transaction_liveaboard_status_id
                                link = 'checkout-liveaboards';
                                cancelLink = `/transaction-liveaboard/${result.data[i].data[j].id}/cancel`
                            }

                            let actionButton = `<a href="/my-order/${result.data[i].type}/my-order-detail/${result.data[i].data[j].id}" class="list-group-item flex-grow-1 text-center"><i class="fas fa-eye fa-sm mr-2"></i>View Detail</a>`;

                            if (statusId == "c7999dce-19b7-4bfd-84cc-d2f0845a3d86") {
                                actionButton = `<a href="/${link}/${result.data[i].data[j].id}/${(result.data[i].type == 'liveaboard' ? 'room' : 'schedule')}" class="list-group-item flex-grow-1 text-center"><i class="fas fa-arrow-right fa-sm mr-2"></i>Chekout</a>`;
                            }else if(statusId == "d2f95bbe-159b-4447-9e07-33925e04c5e9"){
                                actionButton = `<a href="/${link}/${result.data[i].data[j].id}/extra" class="list-group-item flex-grow-1 text-center"><i class="fas fa-arrow-right fa-sm mr-2"></i>Chekout</a>`;
                            }else if(statusId == "59cfbb65-efff-4d25-aae1-b439efa62188"){
                                actionButton = `<a href="/${link}/${result.data[i].data[j].id}/guest" class="list-group-item flex-grow-1 text-center"><i class="fas fa-arrow-right fa-sm mr-2"></i>Chekout</a>`;
                            }
                            /*else if(statusId == "b648ff73-468f-45cb-bbbc-fd3659e4b8ac"){
                                actionButton = ``;
                            }*/
                            if(
                                statusId != 'bcc8ff73-468f-45cb-babc-fd34cce4b8ac' &&
                                statusId != 'baa8ff37-468f-45cb-bccc-fd34aae4b8ac' &&
                                statusId != 'baa8ff37-468f-455b-bccc-fd34cce4b8ac' &&
                                statusId != 'baa8ff37-468f-455b-b5c5-fc34aae4b8ac' 
                            ){
                                buttonCancel = `<div class="dropdown">
                                        <a class="list-group-item border-right-0" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                            <i class="fas fa-cog fa-sm"></i><i class="fas fa-caret-down fa-sm text-muted"></i>
                                        </a>
                                        <div class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                        <a class="dropdown-item" href="#modalCancelBooking" data-toggle='modal' onClick="cancelOrder('${cancelLink}','${statusId}')">Cancel My Order</a>
                                        </div>
                                    </div>`;
                            }else{
                                buttonCancel = ``;
                            }

                            let brk = result.data[i].data[j].updated_at.split("T");
                            let jm = brk[1].substr(0,8);
                            let tgl = brk[0]+' '+jm;
                            let dt = {};
                            dt.type = result.data[i].type;
                            dt.date = new Date(tgl);
                            dt.data = `<div class="card rounded-0 mb-3 bg-white" >
                                        <div class="row no-gutters">
                                            <div class="col-md-4">
                                                <div class="card-images h-100 p-2" style="background-image:url('${pData.photos[0].url}');">
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="card-body">
                                            <h5 class="m-0 mb-1">${pData.profile.name}</h5>
                                            <ul class="list-inline list-inline-sm mb-4">
                                                <li class="list-inline-item">${pData.profile.destination.name}, ${pData.profile.country.name}</li>
                                                <li class="list-inline-item">${dateFormatMonth(result.data[i].data[j].createdAt)}</li>
                                            </ul>
                                            <h6 class="d-inline-block p-2 bg-light font-lg font-weight-normal mb-3 border">Booking number: <span class="font-weight-bold">${result.data[i].data[j].transaction_code}</span></h6>
                                            <!--span >${tgl}</span-->
                                            
                                            <div class="list-group-custom list-group list-group-horizontal list-group-sm w-100">
                                                <div class="dropdown">
                                                    <!--<a class="list-group-item border-right-0" href="#" role="button" id="dropdownMenuLink" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                                        <i class="fas fa-cog fa-sm"></i><i class="fas fa-caret-down fa-sm text-muted"></i>
                                                    </a>-->
                                                    ${buttonCancel}
                                                </div>
                                                <!--<div class="list-group-item bg-warning"><i class="fas fa-hourglass-start fa-sm mr-2"></i>In Confirmation</div>-->
                                                <div class="list-group-item" style="background-color:${colorTransaction[statusId]}">${statusTransaction[statusId]}</div>
                                                ${actionButton}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div></div>`;
                            orderList.push(dt);                        
                            
                            
                        }
                        
                        
                        // const sortedList = orderList.sort((a, b) => b.date - a.date);
                        // const sortedList = orderList.sort((a, b) => b.date - a.date);
                        // console.log(sortedList);
                        $('#totalOrder').text(totalAll);
                    }
                    filterType('');
                    
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function cancelOrder(cancelLinkUpdated,statusId){
        if (
            statusId == 'c7999dce-19b7-4bfd-84cc-d2f0845a3d86' || //'Created'
            statusId == 'd2f95bbe-159b-4447-9e07-33925e04c5e9' || //'Scheduled'
            statusId == '59cfbb65-efff-4d25-aae1-b439efa62188' //'Extra data'
        ) {
            $(".cancel-info").hide();
            $(".bank-info").hide();    
        }else if(
            statusId == 'b648ff73-468f-45cb-bbbc-fd3659e4b8ac' || //'Ordered'
            statusId == 'b648ff73-468f-45cb-babc-fd3459e4b8ac' || //'Reserved'
            statusId == 'bbb8ff73-468f-45cb-babc-fd3444e4b8ac' //'Approved'
        ){
            $(".cancel-info").show();
            $(".bank-info").hide();
        }else if(statusId == 'bcc8ff37-468f-45cb-bccc-fd34cce4b8ac') //'Transfered'
        {
            $(".cancel-info").show();
            $(".bank-info").show();
        }
        cancelLink = cancelLinkUpdated;
    }

    function confirmCancel(){
        let cancelReason = [];
        $(".cancel-reason").each(function(){
            if ($(this).is(':checked')) {
                cancelReason.push($(this).val());
            }
        });

        if ($("#other-cancel-reason").val() != '') {
            cancelReason.push($("#other-cancel-reason").val());
        }

        let inputBank = $('#inputBank').val()
        let inputAccountNumber = $('#inputAccountNumber').val()
        let inputAccountName = $('#inputAccountName').val()
        
        Swal.fire({
            title: "Cancel this order?",
            text: "By clicking yes, you agree all terms and condition on canceling an order.",
            showCancelButton: true,
            confirmButtonColor: '#bd2130',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes'
        }).then((respond) => {
            if (respond.value) {
                $.ajax({
                    url: `/api${cancelLink}`,
                    method: `PUT`,
                    data:{
                        cancelation_data:{
                            cancel_reason:cancelReason,
                            bank_name: inputBank,
                            bank_account_number: inputAccountNumber,
                            bank_account_name: inputAccountName
                        }
                    },
                    success: function (result) {
                        console.log(result)
                        if (result.success) {
                            window.location.reload();
                        } else {
                            alert(result.message)
                            console.log(result)
                        }
                    },
                    error(xhr, status, error) {
                        if(xhr.responseJSON){
                            console.log(xhr.responseJSON)
                        }
                    }
                });
            }
        });
    }

    function filterType(type){

        orderShow = []
        idxShow = 0
        $('.paging-section .btn-prev').prop('disabled',false);
        $('.paging-section .btn-next').prop('disabled',false);
        $(`.jml`).text('');

        if (type != '') {
            $(".btn-filter").removeClass("btn-filter-active");
            $(`#btn-${type}`).addClass("btn-filter-active");
            for (let idx = 0; idx < orderList.length; idx++) {
                if (orderList[idx].type == type) {
                    orderShow.push(orderList[idx]);
                }
            }
            // $(`#btn-all .jml`).text(' - '+orderShow.length);

        }else{
            $(".btn-filter").removeClass("btn-filter-active");
            $("#btn-all").addClass("btn-filter-active");
            orderShow = orderList;
            // $(`#btn-${type} .jml`).text(' - '+orderShow.length);
        }
        $('#orderList').html('');

        orderShow.sort((a, b) => new Date(b.date) - new Date(a.date) );
        
        orderShowAppend();
    }

    function orderShowAppend(){

        if (idxShow == 0) {
            $('.paging-section .btn-prev').prop('disabled',true);
        }
        let limitShow = parseInt(idxShow)+10;
        limitShow = limitShow > orderShow.length ? orderShow.length : limitShow;
        $('.paging-section .length-record').text(orderShow.length)
        $('.paging-section .idx-start').text(parseInt(idxShow)+1 )
        $('.paging-section .idx-end').text(limitShow)
        $('#orderList').html('');
        for (let idx = idxShow; idx < limitShow; idx++) {
            $('#orderList').append(orderShow[idx].data);
        }
    }

    function prevShowAppend(){
        if (idxShow > 0) {
            idxShow -= 10;
        }

        $('.paging-section .btn-next').prop('disabled',false);
        if (idxShow == 0) {
            $('.paging-section .btn-prev').prop('disabled',true);
        }
        orderShowAppend()
    }

    function nextShowAppend(){
        idxShow = parseInt(idxShow) + 10;
        console.log(idxShow)

        $('.paging-section .btn-prev').prop('disabled',false);
        if (parseInt(idxShow) + 10 >= orderShow.length ) {
            $('.paging-section .btn-next').prop('disabled',true);
        }
        orderShowAppend()
    }

</script>