<script>
    var id = "<%= id %>"

    var package_data
    let packageListData = []

    var totalPriceData
    var totalPrice = 0

    var listRoom = []
    var listRoomsChoose = []

    let roomDetail = []
    let listRoomOption = {};
    let listRoomAmenities = {};
    let packageList = {}
    let packageListGuest = []
    let tglShow = '';

    $(document).ready(function(){
        //alert("hai")
        getRoomOption()
        getAminity()
        loadTransactionById()
    })

    function loadTransactionById(){
        $.ajax({
             url: `/api/transaction-liveaboard/${id}`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    
                    package_data = result.data.package_data
                    packageListGuest = result.data.package_data.package;
                    let liveaboard = result.data.liveaboard;
                    let packageOri = liveaboard.packages;
                    $('.liveaboardName').text(result.data.liveaboard.profile.name)
                    $('.resortLocation').text(`${result.data.liveaboard.profile.sub_destination.name} - ${result.data.liveaboard.profile.destination.name}, ${result.data.liveaboard.profile.country.name}`)

                    if (result.data.transaction_liveaboard_status_id == 'b648ff73-468f-45cb-bbbc-fd3659e4b8ac') {
                        window.location.replace(`/checkout-liveaboards/${result.data.id}/reserve`);
                    }

                    for (let p_idx = 0; p_idx < packageOri.length; p_idx++) {
                        if (packageOri[p_idx].itenary !== "undefined") {
                            let itenary = packageOri[p_idx].itenary;
                            for (let i_idx = 0; i_idx < itenary.length; i_idx++) {
                                $("#list-iten").append(`<div class="itenary-listing--item">
                                            <div class="itenary-wrapper">
                                                <div class="itenary-title font-weight-bold">Day ${i_idx+1}<i class="fas fa-angle-down ml-2 active"></i></div>
                                                <div class="itenary-content active">
                                                    <ul class="list-base">
                                                        ${itenary[i_idx].text}
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>`);
                            }
                        }
                    }

                    for (let p_idx = 0; p_idx < packageListGuest.length; p_idx++) {
                        let tgl_start = packageListGuest[p_idx].package_date;
                        let tgl_start_add = new Date(tgl_start);
                        let dS = new Date();
                        let dayCount = packageListGuest[p_idx].day
                        let tgl_end = new Date(dS.setDate(tgl_start_add.getDate() + parseInt(dayCount) - 1));
                        let tgl_end_show = dateFormatSM(tgl_end.getFullYear()+'-'+(tgl_end.getMonth()+1)+'-'+tgl_end.getDate());
                        tglShow = dateFormatSM(tgl_start)+ '-' + tgl_end_show;
                        $('.liveaboardDate').append(`${dayCount} days `);
                        // $('.liveaboardDate').append(dateFormatSM(tgl_start)+ '-');
                        $('.liveaboardDate').append(tglShow);
                        // $('.liveaboardDate').append(packageList[packageListGuest[p_idx].id].night+' night');
                                                
                    }
                    
                    // 10 nights: 1 Dec 2020 - 10 Dec 2020
                    // loadRoomById()
                    //location.href = `/checkout-resort/${result.data.id}/extra`

                    // console.log("KJASHDKJASHDKASHDKJASHDKJAHSDKJHSDKJA")
                    // console.log(package_data)
                    let packageRoom = package_data.room;
                    listRoom = package_data.package[0].dataCabin
                    let guestRoom = []; 
                    if (typeof packageRoom !== 'undefined') {
                        for (let j = 0; j < packageRoom.length; j++) {
                            listRoomsChoose.push({...packageRoom[j]});
                            guestRoom[`${packageRoom[j].id}`] = packageRoom[j].roomItem[0].guest;                            
                        }
                        
                    }

                    // console.log('LRIC',listRoomsChoose);
                    for(var i = 0; i < package_data.package[0].dataCabin.length; i++){
                        console.log('GR',guestRoom);
                        var guestHtml = ``
                        let selected = false;
                        for(var x = 0; x < package_data.package[0].dataCabin[i].data.rules.max_person; x++){
                            let guestNumber = 1;
                            if (typeof guestRoom[package_data.package[0].dataCabin[i].id] !== 'undefined') {
                                guestNumber = guestRoom[package_data.package[0].dataCabin[i].id];
                                selected = true;
                            }
                            guestHtml += `<option ${(guestNumber == x+1 ? 'selected' : '')} value="${x+1}">${x+1} Person</option>`
                        }
                        // alert(selected);

                        let pricePackage = ``;
                        // <h5 class="m-0 normal-price discounted" class="">$770</h5>
                        //                                         <h3 class="m-0">$699</h3>
                        
                        if(package_data.package[0].dataCabin[i].discount != "0" && package_data.package[0].dataCabin[i].discount != "" && package_data.package[0].dataCabin[i].discount != null && package_data.package[0].dataCabin[i].discount != 'NaN' && typeof package_data.package[0].dataCabin[i].discount !== 'undefined'){
                            pricePackage = `<h5 class="m-0 normal-price discounted" class="">IDR ${formatRupiah(package_data.package[0].dataCabin[i].price)}</h5>
                                                        <h4 class="m-0 price-package discount-price">IDR ${formatRupiah(package_data.package[0].dataCabin[i].discount)}</h4>`
                        }else{
                            pricePackage = `<h4 class="m-0 normal-price price-package">IDR ${formatRupiah(package_data.package[0].dataCabin[i].price)}</h4>`
                        }
                        $('#cabinList').append(`
                            <div class="d-block mb-3">
                                <div class="card rounded-0 shadow-sm border-0">
                                    <div class="row no-gutters">
                                        <div class="col-md-4">
                                            <div class="d-block">
                                                <span class="badge-photos badge badge-dark badge-pill rounded">3 Photos</span>
                                                <div class="slick">
                                                    <div class="glide__slide--photos" style="background-image: url('/images/room-1.jpeg');">
                                                        <img data-lazy="/images/room-1.jpeg">
                                                    </div>
                                                    <div class="glide__slide--photos">
                                                        <img data-lazy="/images/room-2.jpeg">
                                                    </div>
                                                    <div class="glide__slide--photos">
                                                        <img data-lazy="/images/room-3.jpeg">
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-8">
                                            <div class="card-body">
                                                <div class="row">
                                                    <div class="col-5 col-md-6">
                                                        <h5 class="cabin-name">${package_data.package[0].dataCabin[i].data.info.name}</h5>
                                                        <div class="d-block py-1">
                                                            <div class="d-block mb-2 text-sm">
                                                                <i class="fas fa-user fa-sm mr-2"></i>${package_data.package[0].dataCabin[i].data.rules.max_person} people max
                                                            </div>
                                                            <div class="d-block mb-2 text-sm">
                                                                <i class="fas fa-bed fa-sm mr-2"></i> ${package_data.package[0].dataCabin[i].data.info.room_option[0].data.name}
                                                            </div>
                                                            <div class="d-block mb-2 text-sm">
                                                                <i class="fas fa-arrows-alt fa-sm mr-2"></i>${package_data.package[0].dataCabin[i].data.info.room_size.width} x ${package_data.package[0].dataCabin[i].data.info.room_size.length}
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-7 col-md-6 text-left">
                                                        <div class="d-block mb-2">
                                                            <div class="d-flex flex-column">
                                                                ${pricePackage}
                                                            </div>
                                                            <div class="text-sm text-muted">Per persons</div>
                                                        </div>
                                                        <div class="d-flex flex-column align-items-start w-100 mb-4">
                                                            <select onChange="changePerson('${package_data.package[0].dataCabin[i].id}')" id="inputGuest${package_data.package[0].dataCabin[i].id}" class="form-control rounded-0 mb-2" style="width: 180px;">
                                                                ${guestHtml}
                                                            </select>
                                                            <div class="text-xs text-muted text-left">Please choose how many guest.</div>
                                                        </div>
                                                        
                                                        
                                                    </div>
                                                    <div class="col-md-12">
                                                        <div class="d-flex align-items-center mb-3">
                                                            <button type="button" class="btn btn-light btn-sm" onClick="getRoomDetail(${i})" data-toggle="modal" data-target="#modalCabinDetails"><i class="far fa-eye mr-2"></i>View Cabin Details</button>
                                                        </div>
                                                        <div class="select-card-wrapper select-card-wrapper-sm">
                                                            <div class="select-card select-card-100 mb-1">
                                                                <label class="select-card-inner select-card-inner-h shadow-sm">
                                                                    <input id="inputCabin-${package_data.package[0].dataCabin[i].id}" ${(selected ? 'checked' : '')} onClick="selectCabin('${package_data.package[0].dataCabin[i].id}')" type="checkbox" name="selectCabin"/>
                                                                    <div class="select-card-content">
                                                                        <h6 class="mb-0">Select cabin</h6>
                                                                    </div>
                                                                    <div class="select-card-checkbox"></div>
                                                                    <div class="select-card-checked"></div>
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `)
                        
                        let oRoom = package_data.package[0].dataCabin[i].data;
                        let rOption = `<div class="col-md-6">
                                    <div class="list-panel border-bottom mb-2">
                                        <div class="list-panel-title">Room Size</div>
                                        <div class="list-panel-content">${oRoom.info.room_size.width}x${oRoom.info.room_size.length}</div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="list-panel border-bottom mb-2">
                                        <div class="list-panel-title">Max Person</div>
                                        <div class="list-panel-content">${oRoom.rules.max_person}</div>
                                    </div>
