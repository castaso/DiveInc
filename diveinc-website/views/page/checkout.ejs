                            <div class="col-md-4 mb-2">
                                <i class="far fa-check-square mr-2"></i>Air Conditioning
                            </div>
                            <div class="col-md-4 mb-2">
                                <i class="far fa-check-square mr-2"></i>Hair dryer
                            </div>
                            <div class="col-md-4 mb-2">
                                <i class="far fa-check-square mr-2"></i>TV
                            </div>
                            <div class="col-md-4 mb-2">
                                <i class="far fa-check-square mr-2"></i>Private bathroom
                            </div>
                            <div class="col-md-4 mb-2">
                                <i class="far fa-check-square mr-2"></i>In-room safe
                            </div>
                            <div class="col-md-4 mb-2">
                                <i class="far fa-check-square mr-2"></i>Fresh water-shower
                            </div>
                            <div class="col-md-4 mb-2">
                                <i class="far fa-check-square mr-2"></i>Wi-Fi (Free)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-end">
                <div>
                    <button type="button" class="btn btn-neutral" data-dismiss="modal">Close</a>
                </div>
            </div>
        </div>
    </div>
</div>

