    function changePerson(cabinId){
        // alert(cabinId)
        for(var j = 0; j < listRoomsChoose.length; j++){
            if(listRoomsChoose[j].id == cabinId){
                listRoomsChoose[j].roomItem[0].guest =  $(`#inputGuest${cabinId}`).val()
            }
        }
        console.log(listRoomsChoose)
    }

    function selectCabin(cabinId){
        // alert(cabinId);
        if($(`#inputCabin-${cabinId}`).prop("checked") == true){
            console.log("masuk sini"+cabinId)
            for(var j = 0; j < listRoom.length; j++){
                console.log(listRoom[j])
                if(listRoom[j].id == cabinId){


                    var roomPrice =  listRoom[j].price
                    if(listRoom[j].discount != 0 && listRoom[j].discount != "0" && listRoom[j].discount != "" && listRoom[j].discount != null){
                        roomPrice =  listRoom[j].discount
                    }
                    var newObj = {
                        id : cabinId,
                        roomItem: [
                            {
                                id: "cabin-"+ new Date().getTime(),
                                guest: $(`#inputGuest${cabinId}`).val(),
                                service: [] // ini ganti
                            }
                        ],
                        roomId : listRoom[j].room_id,
                        roomName : listRoom[j].data.info.name,
                        roomPrice : roomPrice,
                        sharing_room : listRoom[j].data.rules.sharing_room,
                        data : listRoom[j].data
                    }
                    console.log('NO',newObj);

                    listRoomsChoose.push({...newObj})
                }
            }
        }else{
            listRoomsChoose = listRoomsChoose.filter(function( obj ) {
                return obj.id !== cabinId
            })
        }

        console.log('lrc',listRoomsChoose)
    }

    function checkout(){
        if(listRoomsChoose.length == 0){
            return Swal.fire(
                'Oops!',
                'Make sure you select the cabin.'
            )
        }else{
            var dateData = package_data.package[0].package_date
            $("#overlay-checkout").removeClass('d-none');
            package_data.room = listRoomsChoose
            var totalGuest = 0
            for(var i = 0; i < listRoomsChoose.length; i++){
                for(var j = 0; j < listRoomsChoose[i].roomItem.length; j++){
                    totalGuest += parseInt(listRoomsChoose[i].roomItem[j].guest)
                }
            }
            package_data.package[0].guest = totalGuest.toString()
            // return
            $.ajax({
                url: `/api/transaction-liveaboard/${id}/schedule`,
                method: `PUT`,
                data : {
                    begin_time : new Date(dateData),
                    package_data : package_data
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        location.href = `/checkout-liveaboards/${result.data.id}/extra`
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }

                    if (xhr.responseJSON.message == 'Token is required') {
                        $("#overlay-checkout").addClass('d-none');
                        loginRequired();
                    }
                }
            })
        }
    }

    function getRoomDetail(i){
        $('#modalCabinDetailsBody').html(roomDetail[i]).promise().done(function(){
            $("#modalCabinDetailsBody").find(".amenities-item").each(function(){
                let amenities_id = $(this).find('span').attr('class');
                $(this).find('span').html(amenitiesList[amenities_id]);
            });

        });
    }
