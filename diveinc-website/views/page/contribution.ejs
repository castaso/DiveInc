<div class="header-spacer"></div>

<div class="modal" id="modalDonate" tabindex="-1" role="dialog"aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content rounded border-0">
            <div class="modal-body">
                <h5 class="panel-title panel-title-sm d-block mb-4">Insert Data</h5>
                <!-- start modal content -->
                <div class="form-row mb-3">
                    <label class="col-sm-4 col-form-label">Name<span class="required text-danger">*</span></label>
                    <div class="col-sm-8">
                        <div class="d-block">
                            <input id="inputName" type="text" class="form-control" placeholder="Your Name">
                        </div>
                    </div>
                </div>
                
                <div class="form-row mb-3">
                    <label class="col-sm-4 col-form-label">Email<span class="required text-danger">*</span></label>
                    <div class="col-sm-8">
                        <div class="d-block">
                            <input id="inputEmail" type="text" class="form-control" placeholder="Your Email">
                        </div>
                    </div>
                </div>

                <div class="form-row mb-3">
                    <label class="col-sm-4 col-form-label">Amount<span class="required text-danger">*</span></label>
                    <div class="col-sm-8">
                        <div class="d-block ">
                            <input id="inputAmount" type="number" class="form-control" placeholder="Amount">
                        </div>
                    </div>
                </div>

                <div class="form-row mb-3">
                    <label class="col-sm-4 col-form-label">Hide My Name<span class="required text-danger">*</span></label>
                    <div class="col-sm-8 text-left">
                        <div class="py-1 text-left">
                            <label for="isHideName">
                                <input id="isHideName" name='isHideName' type="checkbox" > Yes
                            </label>
                        </div>
                    </div>
                </div>
                <!-- end modal content -->
            </div>
            <div class="modal-footer justify-content-end">
                <div>
                    <button type="button" class="btn btn-secondary hidden-print saveBtn" onclick="saveContribution()" >Submit Contribution</button>
                    <button type="button" class="d-none btn btn-secondary mr-2 saveLoading">
                        <div class="spinner-border spinner-border-sm text-white" role="status">
                            <span class="sr-only">Loading...</span>
                        </div>
                    </button>
                    <button type="button" class="btn btn-light btn-link hidden-print" data-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

