<script>

    var id = "<%= id %>"

    var urlDocument = ""

    function formatRupiah(angka){
        // console.log("ANGKAAAAAA")
        // console.log(angka)
        // console.log("-=========")
        var number_string = angka.toString(),
        sisa     		= number_string.length % 3,
        rupiah     		= number_string.substr(0, sisa),
        ribuan     		= number_string.substr(sisa).match(/\d{3}/gi);

        // tambahkan titik jika yang di input sudah menjadi angka ribuan
        if (ribuan) {
            separator = sisa ? '.' : '';
            rupiah += separator + ribuan.join('.');
        }

        console.log(1000);
        return rupiah
    }

    $(document).ready(function() {
        getMyResort()
    });

    function getMyResort(){
        // $('#listMyResortEmpty').show();
        $.ajax({
            url: `/api/contribution/${id}`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    $('.contributionName').text(`${result.data.profile.name}`)
                    $('#imageBackground').css("background-image", `url('${result.data.photos[0].url}')`)
                    $('#about').text(`${result.data.profile.about}`)
                    $('#funds').text(`RP ${formatRupiah(result.data.profile.funds)}`)

                    $('.userName').text(`${result.data.user.profile.name.first_name} ${result.data.user.profile.name.last_name}`)
                    $('.userBackground').css("background-image", `url('${result.data.user.profile.url}')`)
                    $('.userCreated').text(`Joined at ${result.data.user.created_at}`)

                    urlDocument = result.data.documents.url

                    for(var i = 0; i < result.data.news.length; i++){
                        $('#newsPanel').append(`
                            <div class="history-panel-item">
                                <div class="history-panel-header mb-4">
                                    <div class="meta-user my-2">
                                        <div class="meta-user-detail">
                                            <div class="text-muted text-sm">${result.data.news[i].date}</div>
                                        </div>
                                    </div> 
                                </div>
                                <div class="history-panel-content">
                                    <p>${result.data.news[i].news}</p>
                                </div>
                                <div class="history-panel-footer"></div>
                            </div>
                        `)
                    }
                } else {
                    alert(result.message)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function saveContribution(){
        $('.saveBtn').addClass('d-none');
        $('.saveLoading').removeClass('d-none');
        let listIncomplete = formValidate();
        if(listIncomplete.length > 0){
            // return alert("form is not valid")

            $('.saveBtn').removeClass('d-none');
            $('.saveLoading').addClass('d-none');
            return Swal.fire(
                'Oops!',
                `Please complete all data.
                <ul style='padding-left:20px'>
                </ul>
                `
            )
        }else{
            $.ajax({
                url: `/api/transaction-contribution`,
                method: `POST`,
                data: {
                    name : $('#inputName').val(),
                    email : $('#inputEmail').val(),
                    amount : $('#inputAmount').val(),
                    isHideName : $('#isHideName').is(':checked')
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        Swal.fire({
                            title: "Data sent!",
                            text: "We sent guide how to send the contribution.",
                            confirmButtonText: 'Great'
                        }).then(function() {
                            window.location.reload();    
                        });
                        
                        $('.saveBtn').removeClass('d-none');
                        $('.saveLoading').addClass('d-none');
                    } else {
                        alert(result.message)
                        console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
        }

    }

    function formValidate(){
        $(document).find(".text-field-warning").remove();
        listIncomplete = [];
        isEmailError = false;
        emailVal = $('#inputEmail').val();
        ($('#inputName').val().length < 3 ? listIncomplete.push({inputId:"inputName", message: "Name is too short" }) : '' );
        ($('#inputEmail').val().length < 3 ? listIncomplete.push({inputId:"inputEmail",message:"Email too short"}) : '' );
        ($('#inputAmount').val().length == "" ? listIncomplete.push({inputId:"inputAmount",message:"Please input contribution amount"}) : '' );
        // console.log(emailVal.match(/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/));
        if (!emailVal.match(/^\w+([\.-]?\w+)*@\w+([\.-]?\w+)*(\.\w{2,3})+$/)){
            isEmailError = true
        }
        (isEmailError ? listIncomplete.push({inputId:"inputEmail",message:"Email address format is invalid"}) : '' );

        showIncompleteFieldMessage(listIncomplete);
        return listIncomplete;
    }

    function showIncompleteFieldMessage(listIncomplete){
        let earliestInput = "";
        $.each(listIncomplete,function(i,v){
            earliestInput = (i==0 ? v.inputId : earliestInput);
            $(`#${v.inputId}`).parent().append(`<i class='text-danger text-field-warning' style="font-size:12px">*${v.message}</i>`);
        });

        let el = document.getElementById(`${earliestInput}`);
        (earliestInput != '' ? el.scrollIntoView() : '');
    }

    function loadDocument(){
        if( urlDocument == ""){
            Swal.fire(
                'Contribution document',
                'No document uploaded'
            )
        }else{
            location.href = urlDocument
        }
    }



</script>

