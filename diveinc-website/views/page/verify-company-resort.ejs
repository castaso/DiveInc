    function formValidate(){
        $(document).find(".text-field-warning").remove();
        let listIncomplete = [];
        console.log($('#inputBankName').val());

        ($('#inputName').val().length < 3 ? listIncomplete.push({inputId:"inputName", message: "Name is too short" }) : '' );
        ($('#inputPhone').val().length < 6 ? listIncomplete.push({inputId:"inputPhone", message: "Phone is too short" }) : '' );
        ($('#inputBankName').val() == null || $('#inputBankName').val().length == 0 ? listIncomplete.push({inputId:"inputBankName", message: "Bank Name can't be blank" }) : '' );
        ($('#inputBankAccountNumber').val().length == 0 ? listIncomplete.push({inputId:"inputBankAccountNumber", message: "Bank Account Number can't be blank" }) : '' );
        ($('#inputBankAccountName').val().length == 0 ? listIncomplete.push({inputId:"inputBankAccountName", message: "Bank Account Name can't be blank" }) : '' );
        ($('#inputBusinessName').val().length < 3 ? listIncomplete.push({inputId:"inputBusinessName", message: "Business Name is too short" }) : '' );
        ($('#inputBusinessAddress').val().length < 3 ? listIncomplete.push({inputId:"inputBusinessAddress", message: "Business Address is too short" }) : '' );
        ($('#inputCountry').val() == "" ? listIncomplete.push({inputId:"inputCountry", message: "Country can't be blank&nbsp&nbsp" }) : '' );
        ($('#inputCity').val() == "" ? listIncomplete.push({inputId:"inputCity", message: "City can't be blank" }) : '' );
        
        ($('#customFile1').val() == "" ? listIncomplete.push({inputId:"customFile1", message: "Please provide this file" }) : '' );
        ($('#customFile2').val() == "" ? listIncomplete.push({inputId:"customFile2", message: "Please provide this file" }) : '' );
        ($('#customFile3').val() == "" ? listIncomplete.push({inputId:"customFile3", message: "Please provide this file" }) : '' );
        ($('#customFile4').val() == "" ? listIncomplete.push({inputId:"customFile4", message: "Please provide this file" }) : '' );
        ($('#customFile5').val() == "" ? listIncomplete.push({inputId:"customFile5", message: "Please provide this file" }) : '' );
        ($('#customFile6').val() == "" ? listIncomplete.push({inputId:"customFile6", message: "Please provide this file" }) : '' );
        // (dataImage.length == 0 ? listIncomplete.push({inputId:"listPhotos", message: "Please provide 1 or more photos" }) : '' );

        showIncompleteFieldMessage(listIncomplete);
        return listIncomplete;
        
    }

    function showIncompleteFieldMessage(listIncomplete){
        let earliestInput = "";
        $.each(listIncomplete,function(i,v){
            earliestInput = (i==0 ? v.inputId : earliestInput);
            if(!$(`#${v.inputId}`).parent().hasClass("input-group")){
                $(`#${v.inputId}`).parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
            }else{
                $(`#${v.inputId}`).parent().parent().append(`<i class='text-danger text-field-warning' style="font-size:12px;">*${v.message}</i>`);
            }
        });

        let el = document.getElementById(`${earliestInput}`);
        (earliestInput != '' ? el.scrollIntoView() : '');
    }

