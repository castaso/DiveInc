    function vendorRegister() {
    listIncomplete = formValidate();
    if (listIncomplete.length > 0) {
        Swal.fire({
            title:"Incomplete",
            text:"Please make sure you fill all required field"
        });
    }else{
        $.ajax({
            url: `/api/transaction-creator`,
            method: `POST`,
            data : {
                type : "resort",
                file : [
                    {
                        key : "file 1",
                        value : {
                            url : fileUrl1,
                            baseUrl : fileBaseUrl1,
                            path : filePath1
                        }
                    },
                    {
                        key : "file 2",
                        value : {
                            url : fileUrl2,
                            baseUrl : fileBaseUrl2,
                            path : filePath2
                        }
                    },
                    {
                        key : "file 3",
                        value : {
                            url : fileUrl3,
                            baseUrl : fileBaseUrl3,
                            path : filePath3
                        }
                    },
                    {
                        key : "file 4",
                        value : {
                            url : fileUrl4,
                            baseUrl : fileBaseUrl4,
                            path : filePath4
                        }
                    },
                    {
                        key : "file 5",
                        value : {
                            url : fileUrl5,
                            baseUrl : fileBaseUrl5,
                            path : filePath5
                        }
                    },
                    {
                        key : "file 6",
                        value : {
                            url : fileUrl6,
                            baseUrl : fileBaseUrl6,
                            path : filePath6
                        }
                    }
                ],
                data : {
                    user : {
                        name : $('#inputName').val(),
                        phone_number : $('#inputPhone').val(),
                        phone_number_2 : $('#inputPhone2').val(),
                        bank_name : $('#inputBankName').val(),
                        bank_account_number : $('#inputBankAccountNumber').val(),
                        bank_account_name : $('#inputBankAccountName').val(),
                        balance: 0
                    },
                    business : {
                        type : $('#inputBusinessType').val(),
                        name : $('#inputBusinessName').val(),
                        social_media : $('#inputBusinessSosmed').val(),
                        address : $('#inputBusinessAddress').val(),
                        country : {
                            id: $('#inputCountry').val(),
                            name : $('#inputCountry option:selected').text()
                        },
                        city : {
                            id: $('#inputCity').val(),
                            name : $('#inputCity option:selected').text()
                        },
                    }
                }
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    Swal.fire({
                        title: "Your data has been sent",
                        text: "Thank you for registering your resort, we will immediately inform you of the status of your resort."
                    }).then(function() {
                        location.href = "/my-resort";
                    });
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }
}

