<script>

    var fileUrl = ""
    var filePath = ""
    var fileBaseUrl = ""

    $(document).ready(function() {
        loadPermission()

        $(`#customFile`).on(`change`, function(){
          
          $('#sendFile').hide()
          $('#chooseFile').text("Please Wait ...")
          makeFileRequestUpload('/api/upload/file', [], this.files).then((result) => {
              console.log(result)
          }, (error) => {
              console.error(error)
          })
        })

        $('#sendFile').click(function(){
            vendorRegister()
        })
    })

    function loadPermission() {
        $.ajax({
            url: `/api/my-permission`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    var permission = result.data.profile.permission
                    for(var i = 0; i < permission.length; i++){
                        if(permission[i].type == "contribution" && permission[i].status_name == "Accessed"){
                            $('#layoutMyContribution').show()
                            getMyContribution()
                        }
                        if(permission[i].type == "contribution" && permission[i].status_name == "No Access"){
                            $('#layoutRegisterContribution').show()
                        }
                        if(permission[i].type == "contribution" && permission[i].status_name == "Request"){
                            $('#layoutWaitContribution').show()
                        }
                        if(permission[i].type == "contribution" && permission[i].status_name == "Rejected"){
                            $('#layoutRejectContribution').show()
                        }
                    }
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function vendorRegister() {
        $.ajax({
            url: `/api/transaction-creator`,
            method: `POST`,
            data : {
                type : "contribution",
                file : {
                    url : fileUrl,
                    baseUrl : fileBaseUrl,
                    path : filePath
                }
            },
            success: function (result) {
                console.log(result)
                if (result.success) {
                    // alert("Success")
                    // location.reload() 
                    Swal.fire({
                        title: "Your data has been sent",
                        text: "Thank you for registering your contribution, we will immediately inform you of the status of your contribution."
                    }).then(function() {
                        window.location.reload()
                    });
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function getMyContribution(){
        console.log('HALOOO')
        $('#listMyContributionEmpty').show();
        $.ajax({
            url: `/api/my-contribution`,
            method: `GET`,
            success: function (result) {
                console.log(result)
                if (result.success) {
                    $('#totalContribution').text(result.data.length)
                    for(var i = 0; i < result.data.length; i++){
                        $('#listMyContributionEmpty').hide();
                        $('#listMyContribution').append(`
                            <div class="card rounded-0 mb-3 bg-white">
                                <div class="row no-gutters">
                                    <div class="col-md-4">
                                        <div class="card-body">
                                            <span class="badge-photos badge-photos-2 badge badge-dark badge-pill rounded">${result.data[i].photos.length} Photos</span>
                                            <div class="slick rounded">
                                                <div class="glide__slide--photos" style="background-image:url('${result.data[i].photos[0].url}');"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body card-body-flex-y pl-0">
                                            <div class="card-content">
                                                <h5 class="m-0 mb-1">${result.data[i].profile.name}</h5>
                                                <ul class="list-inline list-inline-sm mb-2">
                                                    <li class="list-inline-item">${result.data[i].profile.destination.name}, ${result.data[i].profile.country.name}</li>
                                                    <li class="list-inline-item">Created ${result.data[i].created_at}</li>
                                                </ul>
                                                <div class="meta-user text-black">
                                                    <div class="meta-user-img" style="background-image: url('${result.data[i].photos[0].url}');"></div>
                                                    <div class="meta-user-detail">
                                                        <h6 class="text-sm mb-0">Nama Vendor</h6>
                                                        <div class="text-success text-xs">Verified</div>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="hide-mobile list-group-custom list-group list-group-horizontal list-group-sm w-100">
                                                <a href="/my-contribution-create/${result.data[i].id}" class="list-group-item px-3" data-toggle="tooltip" data-placement="top" title="Edit your divecenter"><i class="fas fa-edit fa-sm mr-2"></i>Edit</a>
                                                <a onClick="activeContribution('${result.data[i].id}', ${result.data[i].publish});" type="button" class="list-group-item ${result.data[i].publish ? "text-success" : "text-danger"}" data-toggle="tooltip" data-placement="top" title="Select to publish or unpublish"><i class="fas ${result.data[i].publish ? "fa-toggle-on" : "fa-toggle-off"} fa-sm mr-2"></i>${result.data[i].publish ? "Published" : "Unpublished"}</a>
                                                <a href="my-contribution-booking-management?id=${result.data[i].id}" class="list-group-item flex-grow-1 text-center" data-toggle="tooltip" data-placement="top" title="View my booking list"><i class="fas fa-book fa-sm mr-2"></i>Booking</a>
                                            </div>

                                            <div class="view-mobile-only">
                                                <a href="/my-contribution-create/${result.data[i].id}" class="btn btn-outline-primary btn-block px-3" data-toggle="tooltip" data-placement="top" title="Edit your divecenter"><i class="fas fa-edit fa-sm mr-2"></i>Edit</a>
                                                <a onClick="activeContribution('${result.data[i].id}', ${result.data[i].publish});" type="button" class="btn btn-outline-primary btn-block ${result.data[i].publish ? "text-success" : "text-danger"}" data-toggle="tooltip" data-placement="top" title="Select to publish or unpublish"><i class="fas ${result.data[i].publish ? "fa-toggle-on" : "fa-toggle-off"} fa-sm mr-2"></i>${result.data[i].publish ? "Published" : "Unpublished"}</a>
                                                <a href="my-contribution-booking-management?id=${result.data[i].id}" class="btn btn-outline-primary btn-block flex-grow-1 text-center" data-toggle="tooltip" data-placement="top" title="View my booking list"><i class="fas fa-book fa-sm mr-2"></i>Booking</a>
                                            </div>
                                            
                                           
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `)
                    }
                    
                } else {
                    alert(result.message)
                    console.log(result)
                }
            },
            error(xhr, status, error) {
                if(xhr.responseJSON){
                    console.log(xhr.responseJSON)
                }
            }
        })
    }

    function activeContribution(contributionId, statusPublish){
        if(statusPublish){
            Swal.fire({
                title: "Are you sure?",
                text: "You will unpublish your contribution",
                icon: "warning",
                showCancelButton : true,
            }).then(function(isConfirm) {
                console.log(isConfirm)
                if (isConfirm.value) {
                    unpublishContribution(contributionId)
                } else {
                    swal("Cancelled", "Your data safe :)", "error");
                }
            })
        }else{
            Swal.fire({
                title: "Are you sure?",
                text: "You will publish your contribution",
                icon: "warning",
                showCancelButton : true,
            }).then(function(isConfirm) {
                console.log(isConfirm)
                if (isConfirm.value) {
                    publishContribution(contributionId)
                } else {
                    swal("Cancelled", "Your data safe :)", "error");
                }
            })
        }
    }

    function unpublishContribution(contributionId){
        $.ajax({
        url: `/api/contribution/${contributionId}/publish`,
        method: `PUT`,
        data : {
            publish : false
        },
        success: function (result) {
            console.log(result)
            if (result.success) {
                Swal.fire({
                    title: "Your contribution has been unpublished",
                    text: "Thank you."
                }).then(function() {
                    window.location.reload()
                });
            } else {
                Swal.fire(
                    'Publish Failed',
                    result.message
                )
                //alert(result.message)
                //console.log(result)
            }
        },
        error(xhr, status, error) {
            if(xhr.responseJSON){
                console.log(xhr.responseJSON)
            }
        }
        })
    }

    function publishContribution(contributionId){
        //alert(divecenterId)
        var canPublish = true

        if(canPublish){
            $.ajax({
                url: `/api/contribution/${contributionId}/publish`,
                method: `PUT`,
                data : {
                    publish : true
                },
                success: function (result) {
                    console.log(result)
                    if (result.success) {
                        Swal.fire({
                            title: "Your contribution has been active",
                            text: "Thank you for acivating your contribution."
                        }).then(function() {
                            window.location.reload()
                        });
                    } else {
                        Swal.fire(
                            'Publish Failed',
                            result.message
                        )
                        //alert(result.message)
                        //console.log(result)
                    }
                },
                error(xhr, status, error) {
                    if(xhr.responseJSON){
                        console.log(xhr.responseJSON)
                    }
                }
            })
        }else{
            Swal.fire(
                'Publish Failed',
                `You can't published contribution with empty package`
            )
        }
    }

    

        
    
</script>