<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Diveinc - Log</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta content="A fully featured admin theme which can be used to build CRM, CMS, etc." name="description" />
    <meta content="Coderthemes" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- App favicon -->
    <link rel="shortcut icon" href="/assets/images/favicon.ico" />

    <!-- App css -->
    <%- include('../partials/mainstyle') %>
  </head>

  <body>
    <!-- Navigation Bar-->
    <header id="topnav">
      <!-- Topbar Start -->
      <%- include('../partials/mainheader') %>
      <!-- end Topbar -->

      <!-- Menu Start -->
      <%- include('../partials/mainmenu') %>
      <!-- end menu -->
    </header>
    <!-- End Navigation Bar-->

    <!-- ============================================================== -->
    <!-- Start Page Content here -->
    <!-- ============================================================== -->

    <div class="wrapper">
      <div class="container-fluid">
        <!-- start page title -->
        <div class="row">
          <div class="col-12">
            <div class="page-title-box">
              <div class="page-title-right">
                <ol class="breadcrumb m-0">
                  <li class="breadcrumb-item"><a href="javascript: void(0);">UBold</a></li>
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Extras</a></li>
                  <li class="breadcrumb-item active">Timeline</li>
                </ol>
              </div>
              <h4 class="page-title">Timeline</h4>
            </div>
          </div>
        </div>
        <!-- end page title -->

        <div class="row">
          <div class="col-lg-6" style="overflow: scroll;height: 40vw;">
            <div class="row">
              <div class="col-12">
                <ul class="list-unstyled timeline-sm" id="logContainer"></ul>
              </div>
            </div>
            <!-- end timeline -->
            <div class="row">
              <div class="col-12">
                <button id="btnMore" type="button" class="btn btn-primary btn-block mb-3 waves-effect waves-light ladda-button" data-style="zoom-out">
                  More...
                </button>
              </div>
            </div>
          </div>
          <div class="col-lg-6">
            <div class="card-box" dir="ltr">
              <h4 class="header-title mb-3">Line Chart</h4>
              <div class="text-center">
                <p class="text-muted font-15 font-family-secondary mb-0">
                  <span class="mx-2"><i class="mdi mdi-checkbox-blank-circle text-blue"></i> a</span>
                  <span class="mx-2"><i class="mdi mdi-checkbox-blank-circle text-pink"></i> b</span>
                </p>
              </div>
              <div id="morris-line-example" style="height: 350px;" class="morris-chart"></div>
            </div>
            <!-- card-box -->
          </div>
          <!-- end col -->
        </div>
        <!-- end row -->
      </div>
      <!-- end container -->
    </div>
    <!-- end wrapper -->

    <!-- ============================================================== -->
    <!-- End Page content -->
    <!-- ============================================================== -->

    <!-- Footer Start -->
    <footer class="footer">
      <%- include('../partials/mainfooter') %>
    </footer>
    <!-- end Footer -->

    <!-- MAIN JS-->
    <%- include('../partials/mainjs.ejs') %>

    <!-- App js-->
    <script src="/assets/js/app.min.js"></script>
    <script>
      $(document).ready(function() {
        var data = [
            { y: "2014", a: 50, b: 90 },
            { y: "2015", a: 65, b: 75 },
            { y: "2016", a: 50, b: 50 },
            { y: "2017", a: 75, b: 60 },
            { y: "2018", a: 80, b: 65 },
            { y: "2019", a: 90, b: 70 },
            { y: "2020", a: 300, b: 75 },
            { y: "2021", a: 115, b: 75 },
            { y: "2022", a: 120, b: 85 },
            { y: "2023", a: 145, b: 85 },
            { y: "2024", a: 160, b: 95 }
          ],
          config = {
            data: data,
            xkey: "y",
            ykeys: ["a", "b"],
            labels: ["Total Income", "Total Outcome"],
            fillOpacity: 0.6,
            hideHover: "auto",
            behaveLikeLine: true,
            resize: true,
            pointFillColors: ["#ffffff"],
            pointStrokeColors: ["black"],
            lineColors: ["#4a81d4", "#f672a7"]
          };

        config.element = "morris-line-example";
        Morris.Line(config);

        let page = 1;
        loadLog(page);

        $("#btnMore").click(() => {
          page++;
          if (page <= $("#logContainer").data("totalPage")) loadLog(page);
        });
      });
      function loadLog(page) {
        Ladda.create($("#btnMore")[0]).start();
        $.ajax({
          url: `/api/log?page=${page}`,
          method: `GET`,
          success: function(result) {
            Ladda.create($("#btnMore")[0]).stop();
            if (result.meta.success) {
              console.log(this);
              totalCount = result.meta.info.total;
              let tes = ``;
              result.data.forEach(element => {
                var d = new Date(element.createdAt);
                const year = `${d.getFullYear()} -  ${d.getMonth() + 1} - ${d.getDate()}`;
                const time = `${d.getHours() + 1} :  ${d.getMinutes()} : ${d.getSeconds()}`;
                tes += `
                <li class="timeline-sm-item">
                  <div class="timeline-sm-date">
                    <p class="mb-0">${year}</p>
                    <p>${time}</p>
                  </div>
                  <h5 class="mt-0 mb-1">${element.name}</h5>
                  <p>Created by :  ${element.created_by.type} </p>
                  <p class="text-muted mt-2">
                    ${element.description}
                  </p>
                </li>
              `;
              });
              $("#logContainer").data("totalPage", Math.ceil(result.meta.info.total / 10));
              $("#logContainer").append(tes);
            } else {
              console.log(result);
            }
          },
          error(xhr, status, error) {
            Ladda.create($("#btnMore")[0]).stop();
            console.log(xhr.responseJSON);
          }
        });
      }
    </script>
  </body>
</html>
