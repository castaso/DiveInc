    <!-- modal start -->
    <!-- end modal -->

    <!-- Vendor js -->
    <script src="/assets/js/vendor.min.js"></script>

    <!-- third party js -->
    <%- include('../../partials/mainjs.ejs') %>

    <!-- App js-->
    <script src="/assets/js/app.min.js"></script>
    <script>
      var id = "<%= id %>"

      function formatRupiah(number) {
        return number.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".")
      }

      function dateFormatSM(tanggal){
        let tgl = tanggal.toString().substring(0,10).split('-');
        const monthNamesShort = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
            "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        
        return tgl[2]+' '+monthNamesShort[tgl[1]-1]+' '+tgl[0];
      }

      $(document).ready(function() {
        loadData()
      });

      function loadData(){
        $.ajax({
          url: `/api/transaction-resort/${id}`,
          method: `GET`,
          success: function(result) {
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            if (result.success) {
              console.log(result)
              var totalPrice = 0;

              $('#inputBookingID').html(result.data.transaction_code)

              var htmlPurchaseDetail = ``
              if(result.data.package_data.hasOwnProperty('room')) {
                  for(let room of result.data.package_data.room) {
                      htmlPurchaseDetail += room.roomName + `<br>`
                      totalPrice += Number(room.roomPrice)
      
                      for(let item of room.roomItem) {
      
                          if(item.hasOwnProperty('service')) {
                              htmlPurchaseDetail += `Service:<ul style="list-style: none; padding-left: 20px;">`
                              for(let service of item.service) {
                                  htmlPurchaseDetail += `<li>-` + service.name + ` x` + service.qty + `</li>`
                                  totalPrice += Number(service.price)
                              }
                              htmlPurchaseDetail += `</ul>`
                          }
                      }
                  }
              }

              if(result.data.package_data.hasOwnProperty('package')) {
                  for(let package of result.data.package_data.package) {
                      htmlPurchaseDetail += package.packageName + `<br>`
                      totalPrice += Number(package.packagePrice)
      
                      if(package.hasOwnProperty('service')) {
                          htmlPurchaseDetail += `Service:<ul style="list-style: none; padding-left: 20px;">`
                          for(let service of package.service) {
                              htmlPurchaseDetail += `<li>-` + service.name + ` x` + service.qty + `</li>`
                              totalPrice += Number(service.price)
                          }
                          htmlPurchaseDetail += `</ul>`
                      }
                  }
              }
              $('#inputPurchaseDetail').html(htmlPurchaseDetail)

              if(result.data.package_data.hasOwnProperty('room_date')) {
                $('#inputDate').html(`From: ` + dateFormatSM(result.data.package_data.room_date.from) + `<br>To: ` + dateFormatSM(result.data.package_data.room_date.to) )
              }
              else {
                $('#inputDate').html(`-`)
              }

              $('#inputPriceDetail').html(`total : IDR ${formatRupiah(totalPrice)}<br>
                diveinc fee : IDR ${formatRupiah(totalPrice * 0.2)}<br>
                your income : IDR ${formatRupiah(totalPrice - (totalPrice * 0.2))}
              `)

              if(result.data.transaction_resort_status_id == "b648ff73-468f-45cb-bbbc-fd3659e4b8ac"){
                $('#inputStatus').html(`Ordered`)
              }else{
                $('#inputStatus').html(`-`)
              }
              
            } else {
              alert("Failed to get data");
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            alert("Failed to get data");
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }
    </script>
  </body>
</html>
