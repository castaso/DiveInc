<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Ideal</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      content="A fully featured admin theme which can be used to build CRM, CMS, etc."
      name="description"
    />
    <meta content="Coderthemes" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- App favicon -->
    <!-- <link rel="shortcut icon" href="/assets/images/favicon.ico" /> -->
    <!-- CSS -->
    <%- include('../../partials/mainstyle') %>
  </head>

  <body>
    <!-- Navigation Bar-->
    <header id="topnav">
      <!-- Topbar Start -->
      <%- include('../../partials/mainheader') %>
      <!-- end Topbar -->

      <!-- Menu Start -->
      <%- include('../../partials/mainmenu') %>
      <!-- end menu -->
    </header>
    <!-- End Navigation Bar-->

    <!-- ============================================================== -->
    <!-- Start Page Content here -->
    <!-- ============================================================== -->
    <div class="wrapper">
      <div class="container-fluid">
        <!-- start page title -->
        <div class="row">
          <div class="col-12">
            <div class="page-title-box">
              <div class="page-title-right">
                <ol class="breadcrumb m-0">
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Diveinc.co</a></li>
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Ideal</a></li>
                  <li class="breadcrumb-item active">Datatables</li>
                </ol>
              </div>
              <h4 class="page-title">Data Ideal</h4>
            </div>
          </div>
        </div>
        <!-- end page title -->

        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <button type="button" id="buttonAdd" class="btn btn-success waves-effect waves-light">
                  Add
                </button></br></br>
                <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap" style="width: 100%;">
                  <thead>
                    <tr>
                      <th>Name</th>
                      <th>Action</th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
              <!-- end card body-->
            </div>
            <!-- end card -->
          </div>
          <!-- end col-->
        </div>
        <!-- end row-->
      </div>
      <!-- end container -->
    </div>
    <!-- end wrapper -->
    <!-- ============================================================== -->
    <!-- End Page content -->
    <!-- ============================================================== -->

    <!-- Footer Start -->
    <footer class="footer">
      <%- include('../../partials/mainfooter') %>
    </footer>
    <!-- end Footer -->

    <!-- modal start -->
    <!-- end modal -->

    <!-- Vendor js -->
    <script src="/assets/js/vendor.min.js"></script>

    <!-- third party js -->
    <%- include('../../partials/mainjs.ejs') %>

    <!-- App js-->
    <script src="/assets/js/app.min.js"></script>
    <script>
      $(document).ready(function() {
        // load data table
        $("#datatable").DataTable({
          processing: true,
          serverSide: true,
          searching: true,
          columnDefs: [
            {
              targets: "_all",
              orderable: true
            }
          ],
          ajax: "/api/ideal/datatable"
        });
      });

      $('#buttonAdd').click(function(){
        location.href = "ideal/add"
      });

      function editData(id){
        location.href = "/ideal/edit/"+id
      }

      function showData(id){
        
      }

      function deleteData(id){
        var r = confirm("Are you sure to delete this data ?");
        if (r == true) {
          $.ajax({
            url: `/api/ideal/${id}`,
            method: `DELETE`,
            success: function(result) {
              // $(`#loading`).hide();
              // $(`#loginButton`)
              //   .removeClass(`btn-disabled disabled`)
              //   .addClass(`btn-primary`);
              if (result.success) {
                alert("Success")
                location.reload();
              } else {
                alert("Failed to delete data");
                console.log(result);
                //Ladda.create($(`#loginButton`)[0]).stop();
              }
            },
            error(xhr, status, error) {
              alert("Failed to delete data");
              // $(`#loading`).hide();
              // $(`#loginButton`)
              //   .removeClass(`btn-disabled disabled`)
              //   .addClass(`btn-primary`);
              console.log(xhr.responseJSON);
            }
          });
        }
      }
    </script>
  </body>
</html>
