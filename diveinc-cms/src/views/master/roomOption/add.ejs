<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Room Option</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      content="A fully featured admin theme which can be used to build CRM, CMS, etc."
      name="description"
    />
    <meta content="Coderthemes" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- App favicon -->
    <!-- <link rel="shortcut icon" href="/assets/images/favicon.ico" /> -->
    <!-- CSS -->
    <%- include('../../partials/mainstyle') %>
  </head>

  <body>
    <!-- Navigation Bar-->
    <header id="topnav">
      <!-- Topbar Start -->
      <%- include('../../partials/mainheader') %>
      <!-- end Topbar -->

      <!-- Menu Start -->
      <%- include('../../partials/mainmenu') %>
      <!-- end menu -->
    </header>
    <!-- End Navigation Bar-->

    <!-- ============================================================== -->
    <!-- Start Page Content here -->
    <!-- ============================================================== -->
    <div class="wrapper">
      <div class="container-fluid">
        <!-- start page title -->
        <div class="row">
          <div class="col-12">
            <div class="page-title-box">
              <div class="page-title-right">
                <ol class="breadcrumb m-0">
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Diveinc.co</a></li>
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Room Option</a></li>
                  <li class="breadcrumb-item active">Add</li>
                </ol>
              </div>
              <h4 class="page-title">Add Room Option</h4>
            </div>
          </div>
        </div>
        <!-- end page title -->

        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <!-- MAIN CONTENT -->
                <p class="text-muted font-13">
                    FYI : * is required
                </p>
                <div class="form-group">
                    <label class="col-form-label">*Name</label>
                    <input id="inputName" type="text" class="form-control">
                </div>
                <div class="form-group">
                  <label class="col-form-label">*Data</label>
                  <div id="listData"></div>
                  <div class="form-row">
                    <div class="form-group col-md-10">
                        <input type="text" class="form-control" id="inputData">
                    </div>
                    <div class="form-group col-md-2">
                      <button id="addData" class="btn btn-primary waves-effect waves-light">
                        Add
                      </button>
                    </div>
                  </div>
                </div>
                <div class="form-group text-right m-b-0">
                    <button id="buttonSubmit" class="btn btn-primary waves-effect waves-light">
                        Submit
                    </button>
                    <button id="buttonCancel" class="btn btn-secondary waves-effect m-l-5">
                        Cancel
                    </button>
                </div>
              </div>
              <!-- end card body-->
            </div>
            <!-- end card -->
          </div>
          <!-- end col-->
        </div>
        <!-- end row-->
      </div>
      <!-- end container -->
    </div>
    <!-- end wrapper -->
    <!-- ============================================================== -->
    <!-- End Page content -->
    <!-- ============================================================== -->

    <!-- Footer Start -->
    <footer class="footer">
      <%- include('../../partials/mainfooter') %>
    </footer>
    <!-- end Footer -->

    <!-- modal start -->
    <!-- end modal -->

    <!-- Vendor js -->
    <script src="/assets/js/vendor.min.js"></script>

    <!-- third party js -->
    <%- include('../../partials/mainjs.ejs') %>

    <!-- App js-->
    <script src="/assets/js/app.min.js"></script>
    <script>
      var dataData = [];

      $(document).ready(function() {
        
        $('#buttonSubmit').click(function(){
            add();
        });

        $('#buttonCancel').click(function(){
            window.history.back();
        });

        $(`#addData`).click(function(){
          if($(`#inputData`).val().length > 0){
            var objectData = {}
            objectData.id = "data-"+new Date().getTime().toString()
            objectData.name = $(`#inputData`).val()
            dataData.push(objectData)
            loadData()
          }else{
            alert("Form not valid")
          }
        })
      });

      function add(){
        if(isValid()){
            console.log("valid")
            callApiAdd()
        }else{
            alert("Form is not valid")
        }
      }

      function isValid(){
          if(
              $('#inputName').val().length <= 0
              || dataData.length <= 0
          ) return false
          return true
      }

      function callApiAdd(){
        // $(`#loading`).show();
        // $(`#loginButton`)
        //   .removeClass(`btn-primary`)
        //   .addClass(`btn-disabled disabled`);
        var data = {
          name : $('#inputName').val(),
          data : dataData,
        }

        console.log(data)
        $.ajax({
          url: `/api/room-option`,
          method: `POST`,
          data: data,
          success: function(result) {
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            if (result.success) {
              alert("Success")
              location.href = "/room-option";
            } else {
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }

      function loadData(){
        $(`.data-data`).remove()
        for(var i = 0; i < dataData.length; i++){
          $(`#listData`).append(`
            <p id="${dataData[i].id}" class="data-data">${i+1}. ${dataData[i].name} - <a href="javascript:void(0)" onClick="deleteData('${dataData[i].id}');">delete</a></p>
          `).fadeIn('slow')
        }
      }

      function deleteData(id){
        dataData = dataData.filter(function( obj ) {
            return obj.id !== id
        })
        loadData()
      }

    </script>
  </body>
</html>
