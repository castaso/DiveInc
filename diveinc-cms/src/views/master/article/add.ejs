<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Article</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      content="A fully featured admin theme which can be used to build CRM, CMS, etc."
      name="description"
    />
    <meta content="Coderthemes" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- App favicon -->
    <!-- <link rel="shortcut icon" href="/assets/images/favicon.ico" /> -->
    <!-- CSS -->
    <%- include('../../partials/mainstyle') %>
  </head>

  <body>
    <!-- Navigation Bar-->
    <header id="topnav">
      <!-- Topbar Start -->
      <%- include('../../partials/mainheader') %>
      <!-- end Topbar -->

      <!-- Menu Start -->
      <%- include('../../partials/mainmenu') %>
      <!-- end menu -->
    </header>
    <!-- End Navigation Bar-->

    <!-- ============================================================== -->
    <!-- Start Page Content here -->
    <!-- ============================================================== -->
    <div class="wrapper">
      <div class="container-fluid">
        <!-- start page title -->
        <div class="row">
          <div class="col-12">
            <div class="page-title-box">
              <div class="page-title-right">
                <ol class="breadcrumb m-0">
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Diveinc.co</a></li>
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Article</a></li>
                  <li class="breadcrumb-item active">Add</li>
                </ol>
              </div>
              <h4 class="page-title">Add Article</h4>
            </div>
          </div>
        </div>
        <!-- end page title -->

        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <!-- MAIN CONTENT -->
                <p class="text-muted font-13">
                    FYI : * is required
                </p>
                <div class="form-group">
                  <label class="col-form-label">*Category ID</label>
                  <select id="inputCategory" class="custom-select ">
                    <option value="">Open this select menu</option>
                  </select>
                </div>
                <div class="form-group">
                    <label class="col-form-label">*Name</label>
                    <input id="inputName" type="text" class="form-control">
                </div>
                <div class="form-group">
                  <label class="col-form-label">*Author</label>
                  <input id="inputAuthor" type="text" class="form-control">
                </div>
                <div class="form-group">
                  <label class="col-form-label">*Description</label>
                  <textarea id="inputDescription"></textarea>
                </div>

                <div class="form-group row">
                  <label class="col-sm-2 col-form-label">*Image</label>
                  <div class="col-sm-10">
                      <div id="dataGaleryImage" class="row">
                          <div id="addGaleryImage" style="background-image: url('/assets/images/add_image.png');background-size:contain;height:100px;width:100px;margin-left:10px;margin-top:10px;">
                          </div>
                      </div>
                      <input id="inputGaleryImage" type="file" style="display:none;">
                      <progress id="progressGalery" value="0" max="100" style="width:300px;"></progress><br><span id="statusGalery"></span>
                  </div>
                </div>

                <div class="form-group text-right m-b-0">
                    <button id="buttonSubmit" class="btn btn-primary waves-effect waves-light">
                        Submit
                    </button>
                    <button id="buttonCancel" class="btn btn-secondary waves-effect m-l-5">
                        Cancel
                    </button>
                </div>
              </div>
              <!-- end card body-->
            </div>
            <!-- end card -->
          </div>
          <!-- end col-->
        </div>
        <!-- end row-->
      </div>
      <!-- end container -->
    </div>
    <!-- end wrapper -->
    <!-- ============================================================== -->
    <!-- End Page content -->
    <!-- ============================================================== -->

    <!-- Footer Start -->
    <footer class="footer">
      <%- include('../../partials/mainfooter') %>
    </footer>
    <!-- end Footer -->

    <!-- modal start -->
    <!-- end modal -->

    <!-- Vendor js -->
    <script src="/assets/js/vendor.min.js"></script>

    <!-- third party js -->
    <%- include('../../partials/mainjs.ejs') %>

    <!-- App js-->
    <script src="/assets/js/app.min.js"></script>
    <script>
      var dataGaleryImage = [];

      $(document).ready(function() {
        
        $('#buttonSubmit').click(function(){
            add();
        });

        $('#buttonCancel').click(function(){
            window.history.back();
        });

        $(`#addGaleryImage`).click(function(){
          $(`#inputGaleryImage`).click()
        })

        $(`#inputGaleryImage`).on(`change`, function(){
          makeFileRequestGalery('/api/upload/image', [], this.files).then((result) => {
              console.log(result)
          }, (error) => {
              console.error(error)
          })
        })

        $("#inputDescription").summernote({height:250, callbacks : {
          onImageUpload: function(files, editor, welEditable) {
            makeFileRequestSummerNote('/api/upload/image', editor, files, 'inputDescription').then((result) => {
              console.log(result)
            }, (error) => {
              console.error(error)
            })
          }
        }})

        callApiCategory()
      });

      function add(){
        if(isValid()){
            console.log("valid")
            callApiAdd()
        }else{
            alert("Form is not valid")
        }
      }

      function isValid(){
          if(
              $('#inputCategory').val().length <= 0
              || $('#inputName').val().length <= 0
              || $('#inputAuthor').val().length <= 0
              || $('#inputDescription').val().length <= 0
              || dataGaleryImage.length <= 0
          ) return false
          return true
      }

      function callApiCategory(){
        $.ajax({
          url: `/api/article-category`,
          method: `GET`,
          success: function(result) {
            if(result.success){
              for(var i = 0; i < result.data.length; i++){
                $("#inputCategory").append(`
                  <option value="${result.data[i].id}">${result.data[i].name}</option>
                `);
              }
            }
          },
          error(xhr, status, error) {
            console.log(xhr.responseJSON);
          }
        });
      }

      function callApiAdd(){
        // $(`#loading`).show();
        // $(`#loginButton`)
        //   .removeClass(`btn-primary`)
        //   .addClass(`btn-disabled disabled`);
        var data = {
          article_category_id : $('#inputCategory').val(),
          name : $('#inputName').val(),
          author : $('#inputAuthor').val(),
          description : $('#inputDescription').val(),
          images : dataGaleryImage
        }

        console.log(data)
        $.ajax({
          url: `/api/article`,
          method: `POST`,
          data: data,
          success: function(result) {
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            if (result.success) {
              alert("Success")
              location.href = "/article";
            } else {
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }

      function makeFileRequestGalery(url, params, files){
        return new Promise((resolve, reject) => {

          var formData = new FormData()
          var xhr = new XMLHttpRequest()

          if(files[0].size > 10200000){
            alert("Size must be less than 10MB")
          }else{
            formData.append("upload", files[0], files[0].name)

            xhr.onreadystatechange = function() {
                if(xhr.readyState == 4){
                    if(xhr.status == 200){
                      var response = JSON.parse(xhr.response)
                      var newImage = {};
                      newImage.id = "img-"+new Date().getTime().toString()
                      newImage.url = response.data.location
                      newImage.path = response.data.key
                      newImage.baseUrl = response.data.baseUrl
                      dataGaleryImage.push(newImage)
                      loadDataGaleryImage()
                    }else {
                      console.log(xhr.response)
                      alert("Upload file gagal")
                    }
                }
            }

            xhr.upload.addEventListener("progress", progressHandlerGalery, false);
            xhr.addEventListener("load", completeHandlerGalery, false);
            xhr.addEventListener("error", errorHandlerGalery, false);
            xhr.addEventListener("abort", abortHandlerGalery, false);

            xhr.open("POST", url, true)

            xhr.send(formData)
          }
        })
      }

      function progressHandlerGalery(event) {
        var percent = (event.loaded / event.total) * 100
        $("#progressGalery").val(Math.round(percent))
        if(percent == 100){
            $("#statusGalery").text("Upload Success")
        }else{
            $("#statusGalery").text(Math.round(percent) + "% uploaded... please wait")
        }
      }

      function completeHandlerGalery(event) {
        $("#progressGalery").val(0) //wil clear progress bar after successful upload
      }

      function errorHandlerGalery(event) {
        $("#statusGalery").text("Upload Failed")
      }

      function abortHandlerGalery(event) {
        $("#statusGalery").text("Upload Aborted")
      }

      function loadDataGaleryImage(){
        $(`.data-add-galery`).remove()
        for(var i = 0; i < dataGaleryImage.length; i++){
          $(`#dataGaleryImage`).prepend(`
            <div class="data-add-galery" id="${dataGaleryImage[i].id}" style="background-image: url('${dataGaleryImage[i].url}');background-size:contain;height:100px;width:100px;margin-left:10px;margin-top:10px;">
              <button onClick="deleteGaleryImage('${dataGaleryImage[i].id}');" style="float:right;">x</button>
            </div>
          `).fadeIn('slow')
        }
      }

      function deleteGaleryImage(id){
        dataGaleryImage = dataGaleryImage.filter(function( obj ) {
            return obj.id !== id
        })
        $(`#${id}`).remove()
      }

      function makeFileRequestSummerNote(url, editor, files, id){
        return new Promise((resolve, reject) => {

            var formData = new FormData()
            var xhr = new XMLHttpRequest()

            if(files[0].size > 3200000){
              alert("Size must be less than 3MB")
            }else{
              formData.append("upload", files[0], files[0].name)

              xhr.onreadystatechange = function() {
                  if(xhr.readyState == 4){
                      if(xhr.status == 200){
                        var response = JSON.parse(xhr.response)
                        $(`#${id}`).summernote("insertImage", response.data.location)
                      }else {
                        console.log(xhr.response)
                        alert("Upload file gagal")
                      }
                  }
              }

              xhr.open("POST", url, true)

              xhr.send(formData)
            }
        })
      }
    </script>
  </body>
</html>
