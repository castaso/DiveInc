<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Dive Center Transaction</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      content="A fully featured admin theme which can be used to build CRM, CMS, etc."
      name="description"
    />
    <meta content="Coderthemes" name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <!-- App favicon -->
    <!-- <link rel="shortcut icon" href="/assets/images/favicon.ico" /> -->
    <!-- CSS -->
    <%- include('../../partials/mainstyle') %>
  </head>

  <body>
    <!-- Navigation Bar-->
    <header id="topnav">
      <!-- Topbar Start -->
      <%- include('../../partials/mainheader') %>
      <!-- end Topbar -->

      <!-- Menu Start -->
      <%- include('../../partials/mainmenu') %>
      <!-- end menu -->
    </header>
    <!-- End Navigation Bar-->

    <!-- ============================================================== -->
    <!-- Start Page Content here -->
    <!-- ============================================================== -->
    <div class="wrapper">
      <div class="container-fluid">
        <!-- start page title -->
        <div class="row">
          <div class="col-12">
            <div class="page-title-box">
              <div class="page-title-right">
                <ol class="breadcrumb m-0">
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Diveinc.co</a></li>
                  <li class="breadcrumb-item"><a href="javascript: void(0);">Dive Center Transaction</a></li>
                  <li class="breadcrumb-item active">Datatables</li>
                </ol>
              </div>
              <h4 class="page-title">Data Dive Center Transaction</h4>
            </div>
          </div>
        </div>
        <!-- end page title -->

        <div class="row">
          <div class="col-12">
            <div class="card">
              <div class="card-body">
                <!-- <button type="button" id="buttonAdd" class="btn btn-success waves-effect waves-light">
                  Add
                </button></br></br> -->
                <div>
                  <h5>FILTER</h5>
                  <table>
                    <tr>
                      <td class='text-right'>Vendor</td>
                      <td class='p-2'>:</td>
                      <td colspan='3'>
                        <select id="vendorList" onChange="" class="form-control rounded-0">
                          <option value="">All</option>
                        </select>
                      </td>
                      <td></td>
                      <td class='text-right'>Destination</td>
                      <td class='p-2'>:</td>
                      <td colspan='3'>
                        <select id="destinationList" onChange="" class="form-control rounded-0">
                          <option value="">All</option>
                        </select>
                      </td>
                      <td></td>
                      <td class='text-right'>From</td>
                      <td class='p-2'>:</td>
                      <td>
                        <input id='tanggalStart' name='tanggal_start'  class='datePicker form-control rounded-0'>
                      </td>
                    </tr>
                    <tr>
                      <td class='text-right'>Status</td>
                      <td class='p-2'>:</td>
                      <td colspan='3'>
                        <select id="statusList" onChange="" class="form-control rounded-0">
                          <option value="">All</option>
                        </select>
                      </td>

                      <td></td>

                      <td class='text-right'>Sub Destination</td>
                      <td class='p-2'>:</td>
                      <td colspan='3'>
                        <select id="subDestinationList" onChange="" class="form-control rounded-0">
                          <option value="">All</option>
                        </select>
                      </td>

                      <td></td>
                      <td class='text-right'>To</td>
                      <td class='p-2'>:</td>
                      <td><input  id='tanggalEnd' name='tanggal_end' class='datePicker form-control rounded-0'></td>
                    </tr>
                    <tr>
                      <td></td>
                      <td></td>
                      <td><button class="secondary" onclick="reloadTable()">Filter</button></td>
                      <td></td>

                    </tr>
                  </table>
                </div>
                <hr/>
                
                <table id="datatable" class="table table-striped table-bordered dt-responsive nowrap" style="width: 100%;">
                  <thead>
                    <tr>
                      <th>Booking ID</th>
                      <th>Purchase Detail</th>
                      <th>Price Detail</th>
                      <th>Status</th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody></tbody>
                </table>
              </div>
              <!-- end card body-->
            </div>
            <!-- end card -->
          </div>
          <!-- end col-->
        </div>
        <!-- end row-->
      </div>
      <!-- end container -->
    </div>
    <!-- end wrapper -->
    <!-- ============================================================== -->
    <!-- End Page content -->
    <!-- ============================================================== -->

    <!-- Footer Start -->
    <footer class="footer">
      <%- include('../../partials/mainfooter') %>
    </footer>
    <!-- end Footer -->

    <!-- modal start -->
    <!-- end modal -->

    <!-- Vendor js -->
    <script src="/assets/js/vendor.min.js"></script>

    <!-- third party js -->
    <%- include('../../partials/mainjs.ejs') %>

    <!-- App js-->
    <script src="/assets/js/app.min.js"></script>
    <script>
      var mainTable;
      let vendorId = '';
      let destinationId = '';
      let subDestinationId = '';
      let statusId = '';
      let from = '';
      let to = '';
      $(document).ready(function() {
        // load data table
        mainTable = $("#datatable").DataTable({
          processing: true,
          serverSide: true,
          searching: true,
          columnDefs: [
            {
              targets: "_all",
              orderable: true
            }
          ],
          ajax: "/api/transaction-divecenter/datatable"
        });

        loadDestination();
        loadSubDestination();
        loadStatus();
        loadVendor();
      });

      function approveBallance(id, totalBallance){
        let ballance = prompt("Please enter ballanca willbe approved:", totalBallance);
        if (ballance == null || ballance == "") {
          alert('Ballance can not be empty')
        } else {
          if(parseFloat(ballance) > totalBallance){
            alert('Maximum ballance is '+totalBallance)
          }else if(parseFloat(ballance) < totalBallance){
            let reason = prompt("Please enter reason why approve balance partially:", 'Because ');
            if (reason == null || reason == "") {
              alert('Reason can not be empty')
            }else{
              updateVendorBallance(id, ballance, reason)
            }
          }else{
            updateVendorBallance(id, ballance, '')
          }
        }
      }

      function updateVendorBallance(id, ballance, reason){
        $.ajax({
          url: `/api/transaction-divecenter/${id}`,
          method: `PUT`,
          data: {
            ballance: ballance,
            reason: reason,
            type: 'Divecenter'
          },
          success: function(result) {
            if (result.success) {
              console.log(result)
              alert("Success");
              location.reload()
            } else {
              alert("Failed to get data");
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            alert("Failed to get data");
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }

      function showData(id){
        location.href = "/transaction-divecenter/show/"+id
      }

      function loadDestination(){
        $.ajax({
          url: `/api/destination/for-cms`,
          method: `GET`,
          success: function(result) {
            if (result.success) {
              console.log(result)
              let respond = result.data;
              for (let i = 0; i < respond.length; i++) {
                $("#destinationList").append(`<option value='${respond[i].id}'>${respond[i].name}</option>`)
              }
            } else {
              alert("Failed to get data");
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            alert("Failed to get data");
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }

      function loadSubDestination(){
        $.ajax({
          url: `/api/sub-destination/for-cms`,
          method: `GET`,
          success: function(result) {
            if (result.success) {
              console.log(result)
              let respond = result.data;
              for (let i = 0; i < respond.length; i++) {
                $("#subDestinationList").append(`<option value='${respond[i].id}'>${respond[i].name}</option>`)
              }
            } else {
              alert("Failed to get data");
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            alert("Failed to get data");
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }

      function loadStatus(){
        $.ajax({
          url: `/api/transaction-divecenter/status`,
          method: `GET`,
          success: function(result) {
            if (result.success) {
              console.log(result)
              let respond = result.data;
              for (let i = 0; i < respond.length; i++) {
                $("#statusList").append(`<option value='${respond[i].id}'>${respond[i].name}</option>`)
              }
            } else {
              alert("Failed to get data");
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            alert("Failed to get data");
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }

      function loadVendor(){
        $.ajax({
          url: `/api/user/vendor`,
          method: `GET`,
          success: function(result) {
            if (result.success) {
              console.log(result)
              let respond = result.data;
              for (let i = 0; i < respond.length; i++) {
                let permission = respond[i].profile.permission;
                for (let j = 0; j < permission.length; j++) {
                  if (permission[j].type == "divecenter" && typeof permission[j].data.business !== 'undefined' ) {
                    $("#vendorList").append(`<option value='${respond[i].id}'>${permission[j].data.business.type}  ${permission[j].data.business.name}</option>`)
                  }
                }
              }
            } else {
              alert("Failed to get data");
              console.log(result);
              //Ladda.create($(`#loginButton`)[0]).stop();
            }
          },
          error(xhr, status, error) {
            alert("Failed to get data");
            // $(`#loading`).hide();
            // $(`#loginButton`)
            //   .removeClass(`btn-disabled disabled`)
            //   .addClass(`btn-primary`);
            console.log(xhr.responseJSON);
          }
        });
      }
      

      function reloadTable(){
        vendorId = $(`#vendorList`).val();
        destinationId = $(`#destinationList`).val();
        subDestinationId = $(`#subDestinationList`).val();
        statusId = $(`#statusList`).val();
        from = $(`#tanggalStart`).val();
        to = $(`#tanggalEnd`).val();
        
        var getList = [];
        if (vendorId != '') {
          getList.push(`vendor_id=${vendorId}`);
        }

        if (destinationId != '') {
          getList.push(`destination_id=${destinationId}`);
        }

        if (subDestinationId != '') {
          getList.push(`subDestination_id=${subDestinationId}`);
        }

        if (statusId != '') {
          getList.push(`status_id=${statusId}`);
        }

        if (from != '') {
          getList.push(`from=${from}&to=${to}`);
        }

        let param = '';
        if (getList.length > 0) {
          param = '?'
          param += getList.join('&');
        }

        console.log(getList);
        mainTable.ajax.url(`/api/transaction-divecenter/datatable${param}`).load();
      }

    </script>
  </body>
</html>
